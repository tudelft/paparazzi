digraph calibration {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.4", nodesep="0.35", ranksep="0.45", fontname="DejaVu Sans Bold"];
  node [shape=box, style="rounded,filled", fillcolor="#fefce8", color="#ca8a04", fontname="DejaVu Sans Bold", fontsize=18, fontcolor="#111111", penwidth=2.4, margin="0.30,0.20", width=6.0];
  edge [color="#111111", penwidth=2.5, arrowsize=0.9];
  target [label="01  MAKE THE TARGET\nFlat board, sharp thermal corners", fillcolor="#fef9c3", color="#ca8a04"];
  lens [label="02  MEASURE THE LENS\nVaried views + independent check set", fillcolor="#f8fafc", color="#475569"];
  mount [label="03  ALIGN TO THE AIRCRAFT\nLevel reference + confirmed corner order", fillcolor="#f8fafc", color="#475569"];
  check [label="04  CHECK KNOWN DISTANCES\nStationary first, then moving-flight timing", fillcolor="#ffedd5", color="#ea580c"];
  archive [label="KEEP THE EVIDENCE\nPhotos, overlays, YAML and measured errors", fillcolor="#fef08a", color="#111111", penwidth=2.8];
  target -> lens -> mount -> check -> archive;
}