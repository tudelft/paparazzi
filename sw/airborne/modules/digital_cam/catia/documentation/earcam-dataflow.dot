// EARcam position/sound data flow. Render: dot -Tsvg earcam-dataflow.dot -o earcam-dataflow.svg
digraph earcam_dataflow {
  graph [rankdir=LR, bgcolor="#ffffff", fontname="DejaVu Sans Bold", fontsize=26,
         fontcolor="#111111", pad=0.5, nodesep=0.55, ranksep=0.8, splines=spline, newrank=true,
         label="How a sound sample gets its position\nflight-controller position + microphone level are fused in CATIA\n ", labelloc=t];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans Bold", fontsize=18,
         fontcolor="#111111", color="#111111", penwidth=2.5, margin="0.30,0.18"];
  edge  [fontname="DejaVu Sans Bold", fontsize=16, fontcolor="#111111", color="#111111",
         penwidth=3.0, arrowsize=1.2];

  subgraph cluster_fc {
    label="FLIGHT CONTROLLER  (digital_cam_uart)"; fontsize=20; color="#2563eb";
    fillcolor="#eff6ff"; style="rounded,filled"; margin=22; fontcolor="#111111";
    ins   [label="INS / GNSS\nlat  lon  alt  AGL", fillcolor="#dbeafe", color="#2563eb"];
    shoot [label="SHOOT_TARGETED(EAR)\nevery 0.1 s in find_loudspot\ncarries the position", fillcolor="#dbeafe", color="#2563eb"];
    stop  [label="STOP_TARGETED(EAR)\nend of survey", fillcolor="#dbeafe", color="#2563eb"];
  }

  mic [label="earcam --server\nUSB microphone\n48 kHz, 1.8-3.2 kHz band", fillcolor="#fed7aa", color="#ea580c"];

  subgraph cluster_mora {
    label="CATIA service on MORA"; fontsize=20; color="#16a34a";
    fillcolor="#f0fdf4"; style="rounded,filled"; margin=22; fontcolor="#111111";
    newest [label="newest 50 ms window\nlevel  trend  contrast  clip", fillcolor="#dcfce7", color="#16a34a"];
    fuse   [label="position + newest window\n= one geotagged sample", fillcolor="#dcfce7", color="#16a34a"];
    buffer [label="RAM buffer (max 8192)\n+ earlogs/*.csv", fillcolor="#dcfce7", color="#16a34a"];
    solve  [label="calculated_loudestspot()\n< 1 ms", fillcolor="#fef08a", color="#ca8a04"];
  }

  drop [label="move DROP waypoint\nto loudest spot", fillcolor="#fef9c3", color="#ca8a04", penwidth=3.0];

  ins    -> shoot  [label="position at trigger"];
  shoot  -> fuse   [label="UART frame", color="#2563eb"];
  mic    -> newest [label="SAMPLE every 50 ms", color="#ea580c"];
  newest -> fuse   [label="copy (<= 50 ms old)"];
  fuse   -> buffer;
  buffer -> solve;
  stop   -> solve  [label="UART frame", color="#2563eb"];
  solve  -> drop   [label="EAR_RESULT\nlat lon AGL alt confidence", color="#ca8a04"];

  { rank=same; ins; mic; }
  { rank=same; buffer; stop; }
}
