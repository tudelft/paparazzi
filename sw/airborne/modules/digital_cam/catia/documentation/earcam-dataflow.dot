// EARcam position/sound data flow. Render: dot -Tsvg earcam-dataflow.dot -o earcam-dataflow.svg
digraph earcam_dataflow {
  graph [rankdir=LR, bgcolor="#0f172a", fontname="DejaVu Sans Bold", fontsize=26,
         fontcolor="#f8fafc", pad=0.5, nodesep=0.55, ranksep=0.8, splines=spline, newrank=true,
         label="How a sound sample gets its position\nflight-controller position + microphone level are fused in CATIA\n ", labelloc=t];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans Bold", fontsize=21,
         fontcolor="#f8fafc", color="#94a3b8", penwidth=2.5, margin="0.32,0.20"];
  edge  [fontname="DejaVu Sans Bold", fontsize=19, fontcolor="#f8fafc", color="#e2e8f0",
         penwidth=3.2, arrowsize=1.3];

  subgraph cluster_fc {
    label="FLIGHT CONTROLLER  (digital_cam_uart)"; fontsize=21; color="#60a5fa";
    fillcolor="#0b1728"; style="rounded,filled"; margin=24;
    ins   [label="INS / GNSS\nlat  lon  alt  AGL", fillcolor="#1d4ed8"];
    shoot [label="SHOOT_TARGETED(EAR)\nevery 0.1 s in find_loudspot\ncarries the position", fillcolor="#1d4ed8"];
    stop  [label="STOP_TARGETED(EAR)\nend of survey", fillcolor="#1d4ed8"];
  }

  mic [label="earcam --server\nUSB microphone\n48 kHz, 1.8-3.2 kHz band", fillcolor="#7c2d12", color="#fb923c"];

  subgraph cluster_mora {
    label="MORA  (CATIA)"; fontsize=21; color="#34d399";
    fillcolor="#0b1728"; style="rounded,filled"; margin=24;
    newest [label="newest 50 ms window\nlevel  trend  contrast  clip", fillcolor="#047857"];
    fuse   [label="position + newest window\n= one geotagged sample", fillcolor="#047857"];
    buffer [label="RAM buffer (max 8192)\n+ earlogs/*.csv", fillcolor="#047857"];
    solve  [label="calculated_loudestspot()\n< 1 ms", fillcolor="#b45309", color="#fbbf24"];
  }

  drop [label="move DROP waypoint\nto loudest spot", fillcolor="#1d4ed8", color="#60a5fa"];

  ins    -> shoot  [label="position at trigger"];
  shoot  -> fuse   [label="UART frame", color="#93c5fd"];
  mic    -> newest [label="SAMPLE every 50 ms", color="#fdba74"];
  newest -> fuse   [label="copy (<= 50 ms old)"];
  fuse   -> buffer;
  buffer -> solve;
  stop   -> solve  [label="UART frame", color="#93c5fd"];
  solve  -> drop   [label="EAR_RESULT\nlat lon AGL alt confidence", color="#fbbf24"];

  { rank=same; ins; mic; }
  { rank=same; buffer; stop; }
}
