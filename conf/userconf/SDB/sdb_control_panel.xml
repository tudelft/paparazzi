<control_panel name="paparazzi control panel">
  <section name="programs">
    <program name="GCS" command="sw/ground_segment/cockpit/gcs">
      <arg flag="-layout" constant="bottom_settings.xml"/>
    </program>
    <program name="Plot Meteo Profile" command="sw/logalizer/plotprofile"/>
    <program name="UnifiedMoCap" command="sw/ext/unifiedmocaprouter/build/mocap-router"/>
  </section>
  <section name="sessions">
    <session name="Flight UDP Optitrack + Joystick">
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="Server"/>
      <program name="GCS">
        <arg flag="-speech"/>
      </program>
      <program name="Joystick">
        <arg flag="-ac" constant="@AIRCRAFT"/>
        <arg flag="hobbyking.xml"/>
        <arg flag="-d 0"/>
      </program>
      <program name="NatNet3">
        <arg flag="-ac 9999" constant="@AC_ID"/>
        <arg flag="-o"/>
        <arg flag="-zf"/>
      </program>
    </session>
    <session name="Flight UDP/WiFi">
      <program name="Server"/>
      <program name="GCS"/>
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="Herelink PprzLink Router">
        <arg flag="-e udp://192.168.0.11:5242:192.168.0.10:5243"/>
        <arg flag="-e udp://0.0.0.0:4243:192.168.43.255:4242"/>
      </program>
    </session>
    <session name="Flight ttyUSB0 Transparent @57600">
      <program name="Data Link">
        <arg flag="-d" constant="/dev/ttyUSB0"/>
        <arg flag="-s" constant="57600"/>
      </program>
      <program name="Server"/>
      <program name="GCS">
        <arg flag="-speech"/>
      </program>
    </session>
    <session name="Sim_Swarm">
      <program name="Simulator">
        <arg flag="-a" constant="B_Chicken"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="GCS">
        <arg flag="-layout" constant="bottom_settings.xml"/>
      </program>
      <program name="Simulator">
        <arg flag="-a" constant="B_Cow"/>
        <arg flag=""/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Environment Simulator"/>
      <program name="Joystick">
        <arg flag="-ac" constant="B_Cow"/>
        <arg flag="sm600.xml"/>
        <arg flag="-d" constant="1"/>
      </program>
    </session>
    <session name="Simulation - Gazebo">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="GCS">
        <arg flag="-speech"/>
        <arg flag="-maximize"/>
        <arg flag="-center_ac"/>
        <arg flag="-mercator"/>
        <arg flag="-maps_no_http"/>
        <arg flag="-track_size" constant="200"/>
        <arg flag="-zoom" constant="40."/>
      </program>
      <program name="Gazebo"/>
    </session>
    <session name="Simulation - Gazebo + Joystick">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="GCS">
        <arg flag="-speech"/>
        <arg flag="-maximize"/>
        <arg flag="-center_ac"/>
        <arg flag="-mercator"/>
        <arg flag="-maps_no_http"/>
        <arg flag="-track_size" constant="200"/>
        <arg flag="-zoom" constant="40."/>
      </program>
      <program name="Joystick">
        <arg flag="-ac" constant="@AIRCRAFT"/>
        <arg flag="hobbyking.xml"/>
        <arg flag="-d 0"/>
      </program>
      <program name="Gazebo"/>
    </session>
    <session name="helidd">
      <program name="BluegigaUsbDongle">
        <arg flag="/dev/ttyACM0" constant="00:07:80:2d:d6:d9"/>
        <arg flag="4242" constant="4252"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_port" constant="4242"/>
        <arg flag="-udp_uplink_port" constant="4252"/>
      </program>
      <program name="Server"/>
      <program name="Messages"/>
      <program name="GCS">
        <arg flag="-speech"/>
      </program>
      <program name="Joystick">
        <arg flag="-d" constant="2"/>
        <arg flag="-ac" constant="GeniusDD"/>
        <arg flag="hobbyking.xml"/>
      </program>
    </session>
    <session name="optitrack cyberzoo Damian">
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server"/>
      <program name="Messages">
        <arg flag="-c" constant="datalink"/>
      </program>
      <program name="PprzGCS"/>
      <program name="Herelink PprzLink Router">
        <arg flag="-e udp://192.168.0.11:5242:192.168.0.10:5243"/>
        <arg flag="-e udp://0.0.0.0:4243:192.168.43.255:4242"/>
      </program>
      <program name="NatNet3">
        <arg flag="--long_edge" constant="right"/>
        <arg flag="--x_side" constant="right"/>
        <arg flag="--ac_nose" constant="right"/>
        <arg flag="-ac" constant="2210"/>
        <arg flag="121"/>
      </program>
    </session>
    <session name="sdb control cyberzoo">
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="Server"/>
      <program name="Messages"/>
      <program name="GCS">
        <arg flag="-layout" constant="bottom_settings.xml"/>
      </program>
      <program name="Joystick">
        <arg flag="-ac" constant="B_Cow"/>
        <arg flag="sm600.xml"/>
        <arg flag="-d" constant="0"/>
      </program>
      <program name="UnifiedMoCap">
        <arg flag="optitrack"/>
        <arg flag="ivy"/>
        <arg flag="--publish_frequency" constant="10"/>
        <arg flag="--coordinate_system" constant="enu"/>
        <arg flag="--coordinate_north" constant="far"/>
        <arg flag=""/>
        <arg flag="--craft_noses" constant="right"/>
        <arg flag="--streaming_ids" constant="200"/>
        <arg flag="--ac_id" constant="121"/>
      </program>
    </session>
  </section>
</control_panel>
