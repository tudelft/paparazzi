<!DOCTYPE autopilot SYSTEM "autopilot.dtd">

<autopilot name="Swing Autopilot">

    <state_machine name="ap" freq="PERIODIC_FREQUENCY" gcs_mode="true" settings_mode="true" settings_handler="autopilot_generated|SetModeHandler">

        <includes>
            <include name="autopilot_rc_helpers.h"/>
            <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE_FLATNESS"/>  
            <define name="MODE_AUTO1" value="AP_MODE_ATTITUDE_FLATNESS"/> <!-- UNUSED -->
            <define name="MODE_AUTO2" value="AP_MODE_GUIDANCE_FLATNESS"/>
        </includes>

        <!-- <settings>
            <dl_setting var="autopilot.kill_throttle" min="0" step="1" max="1" module="autopilot" values="Resurrect|Kill" handler="KillThrottle"/>
        </settings> -->

        <mode_selection>
            <mode_select cond="RCMode0()" mode="MODE_MANUAL"/>
            <mode_select cond="RCMode1()" mode="MODE_AUTO1"/>
            <mode_select cond="RCMode2()" mode="MODE_AUTO2"/>
        </mode_selection>

        <mode name="KILL">
            <on_enter>
                <!-- <call fun="guidance_h_mode_changed(GUIDANCE_H_MODE_NONE)"/> -->
                <!-- <call fun="guidance_v_mode_changed(GUIDANCE_V_MODE_KILL)"/> -->
                <call fun="stabilization_mode_changed(STABILIZATION_MODE_NONE, 0)"/>
                <call fun="autopilot_set_in_flight(false)"/>
                <call fun="autopilot_set_motors_on(false)"/>
            </on_enter>
            <control>
                <call fun="SetCommands(commands_failsafe)"/>
            </control>
        </mode>

        <mode name="ATTITUDE_FLATNESS" shortname="ATT_FL">
            <on_enter>
            </on_enter>
            <control>
                <call fun="flatness_guidance_fsm_init()"/>
                <call fun="get_spec_thrust()" store="float spec_thrust"/>
                <call fun="flatness_stabilization_run(autopilot_in_flight(), &fl_stabilization.rc_sp, spec_thrust, fl_stabilization.cmd)"/>
                <call fun="SetRotorcraftCommands(fl_stabilization.cmd, autopilot_in_flight(), autopilot_get_motors_on())"/>
            </control>
        </mode>

        <mode name="GUIDANCE_FLATNESS" shortname="GUID_FL">
            <on_enter>
            </on_enter>
            <control>
                <!-- <call fun="flatness_guidance_run(autopilot_in_flight(), fl_stabilization.cmd)"/> -->
                <call fun="flatness_guidance_fsm(autopilot_in_flight(), fl_stabilization.cmd)"/>
                <call fun="SetRotorcraftCommands(fl_stabilization.cmd, autopilot_in_flight(), autopilot_get_motors_on())"/>
            </control>
        </mode>

    </state_machine>

</autopilot>
