<!DOCTYPE autopilot SYSTEM "autopilot.dtd">

<autopilot name="Oneloop Autopilot Cyclone">
  <state_machine name="ap" freq="PERIODIC_FREQUENCY" gcs_mode="true" settings_mode="true" settings_handler="autopilot_generated|SetModeHandler">

    <includes>
      <include name="generated/airframe.h"/>
      <include name="autopilot.h"/>
      <include name="autopilot_rc_helpers.h"/>
      <include name="oneloop/oneloop_andi.h"/>
      <include name="stabilization/stabilization_attitude.h"/>
      <include name="modules/radio_control/radio_control.h"/>
      <include name="modules/actuators/actuators.h"/>
      <include name="modules/actuators/actuators_t4.h"/><!-- should not be needed here fixme -->
      <include name="modules/actuators/actuators_t4_uart.h"/>
    </includes>

    <settings>
      <dl_setting var="autopilot.kill_throttle" min="0" step="1" max="1" values="Resurrect|Kill"/> <!-- handler="KillThrottle" -->
    </settings>

    <!-- Kill throttle mode 0 -->
    <mode name="KILL">
      <select cond="kill_switch_is_on()"/>
      <on_enter>
        <call fun="autopilot_set_in_flight(false)"/>
        <call fun="autopilot_set_motors_on(false)"/>
      </on_enter>
      <control>
        <call fun="SetCommands(commands_failsafe)"/>
      </control>
    </mode>

    <!-- Failsafe mode 1 (required for compiling)-->
    <mode name="FAILSAFE" shortname="FAIL">    
      <!-- Failsafe does not work needs to be fixed-->
    </mode>

    <!-- Rate mode 2-->
    <mode name="RATE" shortname="RATE">
      <select cond="RCMode0()"/>
      <on_enter>
        <call fun="oneloop_andi_enter(CONTROL_MODE_RATE, CONTROL_TYPE_ANDI)"/>
      </on_enter>
      <control>
        <call fun="oneloop_andi_run(CONTROL_MODE_RATE)"/>
      </control>
    </mode>

    <mode name="ATTITUDE" shortname="ATTI">
      <select cond="RCMode1()"/>
      <on_enter>
        <call fun="oneloop_andi_enter(CONTROL_MODE_ATTITUDE, CONTROL_TYPE_ANDI)"/>
      </on_enter>
      <control>
        <call fun="oneloop_andi_run(CONTROL_MODE_ATTITUDE)"/>
      </control>
    </mode>

    <!-- Nav mode (required for compiling)-->
    <mode name="NAV" shortname="NAV">
      <select cond="RCMode2()"/>
      <on_enter>
        <call fun="oneloop_andi_enter(CONTROL_MODE_RATE, CONTROL_TYPE_ANDI)"/>
      </on_enter>
      <control>
        <call fun="oneloop_andi_run(CONTROL_MODE_RATE)"/>
      </control>
    </mode>

  </state_machine>
</autopilot>
