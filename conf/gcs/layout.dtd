<!-- ======================================================================= -->
<!-- Paparazzi GCS layout DTD (unified reference)                            -->
<!--                                                                         -->
<!-- One reference DTD describing BOTH layout formats:                       -->
<!--   * Modern PprzGCS layouts, rooted at <gcsconf>, which wrap the window  -->
<!--     <layout> together with optional <menus> and <speech> sections.      -->
<!--   * Legacy GCS layouts (and the partial column/panel snippets that the  -->
<!--     old ground station includes), rooted directly at <layout> with no   -->
<!--     <gcsconf> wrapper.                                                   -->
<!--                                                                         -->
<!-- A DTD never fixes the document root by itself: every file selects its   -->
<!-- own root through its DOCTYPE (<!DOCTYPE layout ...> for legacy files,    -->
<!-- <!DOCTYPE gcsconf ...> for modern ones). Declaring both roots here lets -->
<!-- this single DTD validate either kind of file, so old layouts keep       -->
<!-- working unchanged. At run time the loader (cockpit configurator.cpp)    -->
<!-- additionally synthesises the <gcsconf> wrapper in memory for            -->
<!-- <layout>-rooted files, but that is transparent to validation.           -->
<!--                                                                         -->
<!-- Flat schema (canonical):                                                -->
<!--   A <widget> fully describes one panel.                                 -->
<!--   * Identity & placement come from the reserved STRUCTURAL attributes   -->
<!--     (name, size, id, container, alt, title, icon, show_header,          -->
<!--     aircraft_tabs, region, x, y), consumed by the layout builder.       -->
<!--   * Every OTHER attribute is a free-form widget OPTION, forwarded to    -->
<!--     the widget as a Qt property (e.g. max_history, background_color,    -->
<!--     select_whole_line, show_background). This is an OPEN extension      -->
<!--     point: a widget may accept further options a DTD cannot enumerate,  -->
<!--     so only the common ones are listed below, for documentation.        -->
<!--   * CHILDREN are sub-widgets: a map's docked / floating panels and an   -->
<!--     aircraft panel's tabs are direct child <widget> elements (a map     -->
<!--     panel selects its slot with region="left|right|floating"); a        -->
<!--     mini-plotter's curves are <plot> children; map value overlays are   -->
<!--     <papget> children.                                                  -->
<!--                                                                         -->
<!-- Backward compatibility:                                                 -->
<!--   * The legacy NESTED forms - a <configure> block, the                  -->
<!--     <floating>/<columnLeft>/<columnRight> panel wrappers, and per-widget-->
<!--     <property name= value=> entries - are still declared so old layout  -->
<!--     files keep validating. The loader rewrites them into the flat       -->
<!--     schema in memory before building, so the widgets only ever see the  -->
<!--     flat form.                                                          -->
<!--   * Some legacy files spell structural attribute KEYS in upper case     -->
<!--     (NAME=, SIZE=, VALUE=); the loader lower-cases the keys at run time. -->
<!--     The upper-case aliases are declared below so those files validate.   -->
<!-- ======================================================================= -->


<!-- ===== Document roots ================================================== -->

<!-- Modern root: the window layout plus optional menu and speech settings. -->
<!-- <menus> and <speech> are read by name and order-independent at run      -->
<!-- time; the canonical order is given here.                                -->
<!ELEMENT gcsconf (layout, menus?, speech?)>

<!-- The window layout. It holds exactly one geometry child: a splitter      -->
<!-- (<rows>/<columns>) or a single <widget>.                                -->
<!ELEMENT layout (rows | columns | widget)>
<!ATTLIST layout
    width          CDATA #IMPLIED
    height         CDATA #IMPLIED
    show_statusbar CDATA #IMPLIED
    show_toolbar   CDATA #IMPLIED
>


<!-- ===== Splitters ====================================================== -->
<!-- <rows> stacks its children vertically, <columns> places them side by    -->
<!-- side. Either may contain any mix of nested splitters and widgets.       -->
<!ELEMENT rows (rows | columns | widget)*>
<!ATTLIST rows
    size CDATA #IMPLIED
    SIZE CDATA #IMPLIED
    id   CDATA #IMPLIED
>

<!ELEMENT columns (rows | columns | widget)*>
<!ATTLIST columns
    size CDATA #IMPLIED
    SIZE CDATA #IMPLIED
    id   CDATA #IMPLIED
>


<!-- ===== Widgets ======================================================== -->
<!-- A panel in the layout. In the flat schema its CHILDREN are sub-widgets   -->
<!-- (map dock/floating panels, aircraft tabs), <plot> curves, or <papget>    -->
<!-- overlays. The legacy <configure>/<property> children are also accepted   -->
<!-- (and flattened by the loader) so old files keep validating.             -->
<!ELEMENT widget (widget | plot | papget | configure | property)*>
<!-- Reserved STRUCTURAL attributes come first; the rest are the common       -->
<!-- widget OPTIONS, listed for documentation only (the option set is open).  -->
<!ATTLIST widget
    name          CDATA #IMPLIED
    NAME          CDATA #IMPLIED
    size          CDATA #IMPLIED
    SIZE          CDATA #IMPLIED
    id            CDATA #IMPLIED
    container     CDATA #IMPLIED
    title         CDATA #IMPLIED
    alt           CDATA #IMPLIED
    icon          CDATA #IMPLIED
    show_header   CDATA #IMPLIED
    aircraft_tabs CDATA #IMPLIED
    region        CDATA #IMPLIED
    x             CDATA #IMPLIED
    y             CDATA #IMPLIED
    border            CDATA #IMPLIED
    background_color  CDATA #IMPLIED
    max_history       CDATA #IMPLIED
    select_whole_line CDATA #IMPLIED
    show_blocks       CDATA #IMPLIED
    show_details      CDATA #IMPLIED
    show_missions     CDATA #IMPLIED
    show_background   CDATA #IMPLIED
    show_filter       CDATA #IMPLIED
    colorize          CDATA #IMPLIED
    silence_filtered  CDATA #IMPLIED
    style_sheet       CDATA #IMPLIED
    filter            CDATA #IMPLIED
>


<!-- ===== Plotter curves ================================================= -->
<!-- A single curve, declared as a child of a mini-plotter <widget>.         -->
<!ELEMENT plot EMPTY>
<!ATTLIST plot
    name CDATA #IMPLIED
    min  CDATA #IMPLIED
    max  CDATA #IMPLIED
>


<!-- ===== Papget map overlays ============================================ -->
<!-- Real-time value overlay, a direct child of the map <widget>. Its         -->
<!-- name/value <property> children are part of the overlay API              -->
<!-- (field/scale/format/...), not widget options, and are kept as-is.       -->
<!ELEMENT papget (property)*>
<!ATTLIST papget
    type    CDATA #REQUIRED
    x       CDATA #REQUIRED
    y       CDATA #REQUIRED
    display CDATA #IMPLIED
>


<!-- ===== Legacy nested forms (flattened by the loader) ================== -->
<!-- Kept so pre-existing layout files keep validating. New layouts should    -->
<!-- use the flat schema (options as <widget> attributes, panels as direct    -->
<!-- <widget> children carrying region=).                                     -->

<!-- Legacy widget-options / containers block. Open content on purpose.       -->
<!ELEMENT configure ANY>
<!ATTLIST configure
    border            CDATA #IMPLIED
    background_color  CDATA #IMPLIED
    max_history       CDATA #IMPLIED
    select_whole_line CDATA #IMPLIED
    show_details      CDATA #IMPLIED
    show_missions     CDATA #IMPLIED
>

<!-- Legacy map side-column and floating-overlay panel wrappers.             -->
<!ELEMENT columnLeft  (widget)*>
<!ELEMENT columnRight (widget)*>
<!ELEMENT floating    (widget)*>

<!-- Generic name/value property: kept for <papget> children and for legacy   -->
<!-- per-widget option entries (the loader turns the latter into attributes). -->
<!-- name/value are required in practice; the upper-case aliases cover the     -->
<!-- legacy files and are normalised by the loader.                           -->
<!ELEMENT property EMPTY>
<!ATTLIST property
    name  CDATA #IMPLIED
    NAME  CDATA #IMPLIED
    value CDATA #IMPLIED
    VALUE CDATA #IMPLIED
>


<!-- ===== Menus (modern <gcsconf> only) ================================== -->
<!-- Enable/disable and show/hide entries of the application menu.           -->
<!ELEMENT menus (menubar | menu | item)*>

<!ELEMENT menubar EMPTY>
<!ATTLIST menubar
    visible        CDATA #IMPLIED
    keep_shortcuts CDATA #IMPLIED
>

<!ELEMENT menu (menu | item)*>
<!ATTLIST menu
    name    CDATA #REQUIRED
    enabled CDATA #IMPLIED
    visible CDATA #IMPLIED
>

<!ELEMENT item EMPTY>
<!ATTLIST item
    name    CDATA #REQUIRED
    enabled CDATA #IMPLIED
    visible CDATA #IMPLIED
>


<!-- ===== Speech (modern <gcsconf> only) ================================= -->
<!-- Spoken telemetry messages. Note: the mixed-case "onChange" attribute is -->
<!-- intentional and preserved as-is (the loader does not lower-case keys in -->
<!-- the speech block).                                                      -->
<!ELEMENT speech (message)*>
<!ATTLIST speech
    locale CDATA #IMPLIED
>

<!ELEMENT message EMPTY>
<!ATTLIST message
    name           CDATA #REQUIRED
    text           CDATA #IMPLIED
    timeout        CDATA #IMPLIED
    priority       CDATA #IMPLIED
    expire         CDATA #IMPLIED
    onChange       CDATA #IMPLIED
    postprocessing CDATA #IMPLIED
>
