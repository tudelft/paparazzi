  <variables>
    <!-- Retry counters; both are reset when m4_search is (re)started from the GCS. -->
    <variable var="earcam_retry" type="uint8_t" init="0"/>
    <variable var="drop_approaches" type="uint8_t" init="0"/>
  </variables>

  <modules>
    <module name="digital_cam_earcam"/>
    <module name="nav_drop"/>
    <module name="wind_circle"/>
  </modules>

  <blocks>
    <!-- ================================================================================
         0. Start-up, take-off and hold. Standard EasyStar 3 sequence.
         ================================================================================ -->

    <!-- WHY: never arm before the GPS is good; the whole mission is GPS-referenced. -->
    <block name="Wait GPS">
      <set value="1" var="autopilot.kill_throttle"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <!-- WHY: takes the ground reference (ground_alt, HOME) from the GPS at the launch spot
         after 10 s of settling. Every "height" in this plan is relative to this reference. -->
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 10)"/>
      <call_once fun="NavSetGroundReferenceHere()"/>
    </block>
    <!-- Motor off, wings level, waiting for the Takeoff button. -->
    <block name="Holding point">
      <set value="1" var="autopilot.kill_throttle"/>
      <attitude roll="0" throttle="0" vmode="throttle"/>
    </block>
    <!-- Hand launch: motor on, climb towards CLIMB; 25 m above the reference -> Standby. -->
    <block name="Takeoff" strip_icon="takeoff.png" strip_button="Takeoff (wp CLIMB)">
      <set var="autopilot.kill_throttle" value="0"/>
      <set var="autopilot.flight_time" value="0"/>
      <set var="autopilot.launch" value="1"/>
      <exception cond="GetPosAlt() @GT GetAltRef()+25" deroute="Standby"/>
      <go wp="CLIMB"/>
    </block>
    <!-- Safe hold at 70 m and the exit of every mission path (success or abort). The motor
         is explicitly re-enabled here because several mission blocks fly with it OFF. -->
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>

    <!-- ================================================================================
         1. Acoustic search around M4C
         WHY a star and not a survey: the rules already put the alarm within 25 m of M4C.
         Straight legs through the centre from 4 headings, each with the motor off over the
         centre, give a sharp "loudest spot" in a few minutes. Every following star is
         centred on the previous estimate, so the estimate homes in on the alarm.
         ================================================================================ -->

    <!-- GCS entry point (strip button). Resets the retry counters, measures the wind. -->
    <block name="m4_search" strip_button="M4 search + drop" strip_icon="survey.png">
      <set var="earcam_retry" value="0"/>
      <set var="drop_approaches" value="0"/>
      <deroute block="m4_wind"/>
    </block>

    <!-- Onboard wind measurement: one circle over M4C at the safe height and the star
         airspeed, motor on. wind_circle collects the GPS ground speed in 36 course bins;
         after 2/3 of a turn it fits the circle and publishes the wind (wind_circle.ready).
         Normally done in about one turn (20 s); 2.5 turns without a fit (gusty, GPS poor)
         -> continue anyway, nav_drop then works with the last known wind (zero at
         start-up) and the run-in lane course is taken as it is.
         WHY here and not in Standby: it is inside the autonomous sequence, so nothing
         depends on the GCS, and 35 m is the height of the star that follows. -->
    <block name="m4_wind">
      <set var="v_ctl_auto_airspeed_setpoint" value="10.0"/>
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <call_once fun="wind_circle_start()"/>
      <exception cond="wind_circle.ready @AND (NavCircleCount() @GT 1.0)" deroute="m4_star"/>
      <exception cond="NavCircleCount() @GT 2.5" deroute="m4_star"/>
      <circle radius="earcam_refine_turn_radius_m" wp="M4C"/>
    </block>

    <!-- Star configuration. These <set> lines are THE tuning knobs of the search:
           airspeed 10 m/s        slow = more samples per metre and a smaller turn circle.
           earcam_quiet_only 1    samples count only after the motor has been off for
                                  EARCAM_QUIET_DELAY_S (1.5 s, prop spin-down); the pusher
                                  prop sits right next to the microphone. 0 = always sample.
           turn radius 30 m       about 19 deg bank at 10 m/s; legs become 2 x 72 m because
                                  the module lengthens them so the turn circles fit.
           height_from/to 35 m    leg start/end height above ground_alt (M4_SAFE_HEIGHT_M).
                                  Equal values = level leg (the motor-off part still glides
                                  down about 6 m, see refine_leg). THIS SITE: the star spans
                                  130 m around the estimate, i.e. over the west forest and
                                  the east trees (up to 18 m), so 35 m is the floor here.
                                  Elsewhere lower = sharper peak; the module never goes
                                  below EARCAM_REFINE_HEIGHT_MIN_M (8 m, airframe).
           converge 1.5 m         done when two successive estimates agree within this.
         earcam_start() clears MORA's sample buffer and starts the periodic EAR shots;
         earcam_result_from_waypoint(M4C) makes M4C the "current estimate", so the first
         star is centred on the given point without a survey. -->
    <block name="m4_star">
      <call_once fun="wind_circle_stop()"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="10.0"/>
      <set var="earcam_quiet_only" value="1"/>
      <set var="earcam_refine_turn_radius_m" value="30"/>
      <set var="earcam_refine_height_from_m" value="M4_SAFE_HEIGHT_M"/>
      <set var="earcam_refine_height_to_m" value="M4_SAFE_HEIGHT_M"/>
      <set var="earcam_refine_converge_m" value="1.5"/>
      <call_once fun="earcam_start()"/>
      <call_once fun="earcam_result_from_waypoint(WP_M4C)"/>
      <deroute block="refine_setup"/>
    </block>

    <!-- Star geometry: writes leg 0 into _R_FROM/_R_TO and the turn circle that follows it
         into _R_TURN, all centred on the current estimate. Legs pass through the centre at
         0, 45, 90 and 135 deg; consecutive legs are joined by one circle tangent to both. -->
    <block name="refine_setup">
      <call_once fun="earcam_refine_setup(WP__R_FROM, WP__R_TO, WP__R_TURN)"/>
      <deroute block="refine_leg"/>
    </block>

    <!-- One straight leg _R_FROM -> _R_TO through the estimate.
         HOW the quiet zone works: the pre_call runs every cycle and kills the throttle from
         40 m BEFORE the centre until 30 m AFTER it; the motor is on elsewhere on the leg.
         At 10 m/s that is 7 s without motor: 1.5 s spin-down, then about 5.5 s of clean
         listening while the aircraft glides from 12 m to roughly 6 m (glide ratio 11).
         Adjust (40, 30) if the prop stops slower/faster or the glide ends up too low.
         The leg ends when the aircraft is within CARROT distance of _R_TO -> refine_turn. -->
    <block name="refine_leg" pre_call="earcam_refine_leg_throttle(40, 30)">
      <exception cond="NavApproachingFrom(WP__R_TO, WP__R_FROM, CARROT)" deroute="refine_turn"/>
      <go from="_R_FROM" hmode="route" wp="_R_TO"/>
    </block>

    <!-- Turn circle onto the next leg, motor ON (the pre_call restores it every cycle; the
         turn needs power and with quiet_only the samples taken here do not count).
         Exit when the heading matches the next leg (earcam_refine_turning() false) or after
         40 s as a safety net against circling forever in strong wind. -->
    <block name="refine_turn" pre_call="autopilot_set_kill_throttle(false)">
      <exception cond="!earcam_refine_turning()" deroute="refine_next"/>
      <exception cond="NavBlockTime() @GT 40" deroute="refine_next"/>
      <circle radius="earcam_refine_turn_radius()" wp="_R_TURN"/>
    </block>

    <!-- Advance to the next leg (returns 0 -> fly it). After the last leg of the star, ask
         MORA for an interim solution over all samples so far (earcam_solve); sampling keeps
         running. NOTE: request here, wait in the next block, because exceptions are checked
         before the body: one block cannot both send the request and test the reply. -->
    <block name="refine_next">
      <exception cond="earcam_refine_next_leg(WP__R_FROM, WP__R_TO, WP__R_TURN) == 0" deroute="refine_leg"/>
      <call_once fun="earcam_solve()"/>
      <deroute block="refine_solve"/>
    </block>

    <!-- Wait for MORA's answer while circling the last turn point; it normally arrives
         well under 1 s. No answer within 5 s = link or MORA problem -> m4_failed. -->
    <block name="refine_solve">
      <exception cond="earcam_result_fresh" deroute="refine_check"/>
      <exception cond="NavBlockTime() @GT 5" deroute="m4_failed"/>
      <circle radius="earcam_refine_turn_radius()" wp="_R_TURN"/>
    </block>

    <!-- Compare the new estimate with the previous one: sets earcam_refine_shift_m and
         earcam_refine_converged (shift <= converge_m, or EARCAM_REFINE_MAX_ITERATIONS). -->
    <block name="refine_check">
      <call_once fun="earcam_refine_update()"/>
      <deroute block="refine_decide"/>
    </block>

    <!-- Decide. Plausibility first: the rules put the alarm within 25 m of M4C, so an
         estimate further than 35 m (25 m plus margin for the given point's own accuracy)
         is noise from elsewhere (another drone, a generator...) -> m4_failed.
         Converged -> release phase. Otherwise fly another star around the new estimate. -->
    <block name="refine_decide">
      <exception cond="!earcam_result_within(WP_M4C, 35)" deroute="m4_failed"/>
      <exception cond="earcam_refine_converged" deroute="goto_loudspot"/>
      <deroute block="refine_setup"/>
    </block>

    <!-- Search failure: motor on, stop sampling, count the retry. First failure: circle M4C
         for 3 s and restart the whole search from M4C with a fresh sample buffer. Second
         failure: hold in Standby and let the team decide (e.g. press "M4 search + drop"
         again once the alarm is confirmed to be sounding). -->
    <block name="m4_failed">
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <call_once fun="earcam_stop()"/>
      <set var="earcam_retry" value="earcam_retry + 1"/>
      <exception cond="earcam_retry @GT 1" deroute="Standby"/>
      <exception cond="NavBlockTime() @GT 3" deroute="m4_star"/>
      <circle radius="nav_radius" wp="M4C"/>
    </block>

    <!-- ================================================================================
         2. Final result and low release
         WHY nav_drop: it is the proven Paparazzi drop module (OBC 2014). It computes where
         to open the hatch so that the kit, after TRIGGER_DELAY and its fall through the
         air (with wind), lands ON the target. This plan only adds the low altitude profile
         and the 2 m rule gate around it.
         ================================================================================ -->

    <!-- Stop sampling: MORA replies with the FINAL loudest spot over all samples and saves
         the sound picture (photos/eNNNNNN.jpg on MORA). Motor on for the approach. -->
    <block name="goto_loudspot">
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <call_once fun="earcam_stop()"/>
      <deroute block="goto_loudspot_wait"/>
    </block>
    <!-- Wait for that final reply so DROP is exactly the pictured spot; if it does not come
         within 5 s continue with the last interim result, which is nearly the same. -->
    <block name="goto_loudspot_wait">
      <exception cond="earcam_result_fresh" deroute="drop_setup"/>
      <exception cond="NavBlockTime() @GT 5" deroute="drop_setup"/>
      <circle radius="earcam_refine_turn_radius()" wp="_R_TURN"/>
    </block>

    <!-- Approach layout, as flown at the OBC 2014 (include_obc2014_mission.xml). Also the
         GCS "Drop" button, to re-fly the approach by hand on the current DROP position.
           1. DROP <- loudest spot (lat/lon only; height stays 0 = ground).
           2. START <- 250 m before DROP on the run-in course. THE COURSE IS THE LANE
              (M4_LANE_COURSE_DEG, south to north between the tree lines), tilted by up to
              10 deg when that keeps a corridor 10 m either side of the track clear of the
              obstacle sectors from START to 120 m past the target; among equally clear
              tilts the one nearer to the wind (wind_circle_upwind_course) is taken.
              WHY not simply upwind: with 4 m/s from the south-west the upwind course points
              straight into the forest. Headwind only shortens the fall travel; a 45 m lane
              between 15 m trees decides the direction.
              WHY 250 m: a long straight run-in lets the lateral loop settle well under a
              metre and leaves room to descend from 15 m to 1.5 m at a 1:15 glide.
              No clear corridor at all (target within about 10 m of a tree line) ->
              block drop_high: same lane, but the release is made from 35 m.
           3. nav_drop_compute_approach: first RELEASE estimate and _DROPTURN (base turn circle
              beside START, on the M4_DROPTURN_SIDE = east = open meadow side).
           4. _CLIMBOUT <- 170 m past DROP in the lane at 35 m (replaces the nav_drop default
              of 8 s past the release, which would have us turn towards the east trees while
              still low). 170 m keeps it short of the north tree block for any target in
              the 25 m circle.
           5. _LEVEL <- 50 m before RELEASE at the release height: the glide ends here and the
              last 50 m are flown level on the rangefinder so the height at release is stable.
           6. Slow to 10 m/s (slower = shorter fall travel = smaller timing error).
           7. Circle _DROPTURN until the heading is 15 deg short of the run-in heading, then
              roll out onto the line START -> RELEASE. -->
    <block name="drop_setup" strip_button="Drop" strip_icon="parachute.png">
      <set var="drop_approaches" value="drop_approaches + 1"/>
      <call_once fun="earcam_result_to_waypoint(WP_DROP)"/>
      <call_once fun="earcam_place_run_in_lane(WP_START, WP_DROP, 250, 120, M4_LANE_MARGIN_M, M4_LANE_COURSE_DEG, M4_LANE_MAX_TILT_DEG, 5, wind_circle_upwind_course(), m4_obstacle)"/>
      <deroute block="drop_approach"/>
    </block>
    <!-- Separate block: exceptions are tested before the body, so the corridor verdict of
         drop_setup can only be acted on here. -->
    <block name="drop_approach">
      <exception cond="!earcam_run_in_clear" deroute="drop_high"/>
      <call_once fun="nav_move_waypoint_enu(WP_START, WaypointX(WP_START), WaypointY(WP_START), WaypointAlt(WP_DROP) + 15)"/>
      <call_once fun="nav_drop_compute_approach(WP_DROP, WP_START, WP__DROPTURN, WP__CLIMBOUT, M4_DROPTURN_SIDE * fabsf(nav_radius))"/>
      <call_once fun="nav_move_waypoint_enu(WP__CLIMBOUT, WaypointX(WP_DROP) + (WaypointX(WP_DROP) - WaypointX(WP_START)) * 0.68, WaypointY(WP_DROP) + (WaypointY(WP_DROP) - WaypointY(WP_START)) * 0.68, WaypointAlt(WP_DROP) + M4_SAFE_HEIGHT_M)"/>
      <call_once fun="earcam_drop_level_point(WP_START, WP_RELEASE, WP_DROP, WP__LEVEL, 50)"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="10.0"/>
      <circle radius="M4_DROPTURN_SIDE * fabsf(nav_radius)" until="NavQdrCloseTo(DegOfRad(nav_drop_start_qdr)-15)" wp="_DROPTURN"/>
      <deroute block="drop_glide"/>
    </block>

    <!-- Descent: straight glide START (15 m) -> _LEVEL (1.5 m). vmode="glide" gives the
         altitude loop the correct sink-rate feed-forward, so the aircraft arrives at _LEVEL
         at the right height instead of lagging above it. Every cycle nav_drop_update_release
         re-computes RELEASE from the actual ground speed, wind and fall height (rangefinder
         when in range); it returns true only on an internal error -> Standby.
         Safety: rangefinder below 0.6 m (earcam_drop_too_low) -> go around at once.
         Safety net: inside an obstacle sector below 25 m (blown or navigated off the lane)
         -> drop_go_around: motor on, climb straight ahead. -->
    <block name="drop_glide">
      <exception cond="m4_obstacle(GetPosX(), GetPosY()) @AND (GetPosHeight() @LT M4_ESCAPE_HEIGHT_M)" deroute="drop_go_around"/>
      <exception cond="earcam_drop_too_low(WP_DROP)" deroute="drop_go_around"/>
      <exception cond="nav_drop_update_release(WP_DROP)" deroute="Standby"/>
      <go from="START" hmode="route" vmode="glide" wp="_LEVEL"/>
      <deroute block="drop_final"/>
    </block>

    <!-- Final 50 m: level at earcam_drop_release_agl_m (1.5 m) OVER THE GROUND MEASURED BY
         THE RANGEFINDER (earcam_drop_altitude), so baro drift or a gentle slope do not
         matter. RELEASE is still updated every cycle.
         THE RELEASE is the third exception: in the cycle the aircraft crosses the line
         through RELEASE perpendicular to the run-in (approaching_time 0), earcam_drop_shoot
         checks the height; at or below earcam_drop_max_agl_m (2 m) it opens the hatch and
         returns 0 -> drop_climbout. WHY an exception and not the next block: a block change
         costs 2-3 navigation cycles, i.e. 1-1.5 m along track at 10 m/s.
         Too high at that moment: the hatch stays closed (no points above 2 m, and the kit
         would land further away anyway), the <go> finishes and we go to drop_missed. -->
    <block name="drop_final">
      <exception cond="m4_obstacle(GetPosX(), GetPosY()) @AND (GetPosHeight() @LT M4_ESCAPE_HEIGHT_M)" deroute="drop_go_around"/>
      <exception cond="earcam_drop_too_low(WP_DROP)" deroute="drop_go_around"/>
      <exception cond="nav_drop_update_release(WP_DROP)" deroute="Standby"/>
      <exception cond="NavApproachingFrom(WP_RELEASE, WP__LEVEL, 0) @AND (earcam_drop_shoot(WP_DROP) == 0)" deroute="drop_climbout"/>
      <go approaching_time="0" from="_LEVEL" hmode="route" wp="RELEASE" vmode="alt" alt="earcam_drop_altitude(WP_DROP)"/>
      <deroute block="drop_missed"/>
    </block>

    <!-- Kit is away. Mark the expected impact point (_IMPACT) and downlink the geometry for
         the log/GCS, then power up (12 m/s) and climb straight ahead in the lane to
         _CLIMBOUT (170 m past DROP, 35 m); approaching_time 0 = fly all the way there, so
         the turn towards Standby only starts above the trees. -->
    <block name="drop_climbout">
      <call_once fun="earcam_drop_mark_impact(WP_DROP, WP_RELEASE, WP__IMPACT)"/>
      <call_once fun="DownlinkSendWpNr(WP__IMPACT)"/>
      <call_once fun="DownlinkSendWpNr(WP_START)"/>
      <call_once fun="DownlinkSendWpNr(WP_RELEASE)"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="12.0"/>
      <go approaching_time="0" from="RELEASE" hmode="route" wp="_CLIMBOUT"/>
      <deroute block="drop_decide"/>
    </block>
    <!-- Passed RELEASE above 2 m: nothing was dropped. Climb out the same way, then decide. -->
    <block name="drop_missed">
      <set var="v_ctl_auto_airspeed_setpoint" value="12.0"/>
      <go approaching_time="0" from="RELEASE" hmode="route" wp="_CLIMBOUT"/>
      <deroute block="drop_decide"/>
    </block>

    <!-- Rangefinder said "too low" (below 0.6 m), or the aircraft is low inside an obstacle
         sector: motor on, full airspeed, climb away along the lane to _CLIMBOUT now. -->
    <block name="drop_go_around">
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="12.0"/>
      <go approaching_time="0" wp="_CLIMBOUT"/>
      <deroute block="drop_decide"/>
    </block>

    <!-- No corridor clear of the trees for a low run-in (the target lies within about 10 m
         of a tree line): release from the safe height instead. Same lane, START and
         RELEASE at 35 m, nav_drop compensates the longer fall (wind from m4_wind matters
         here). No low-release points, but the kit lands close and nothing is hit. -->
    <block name="drop_high">
      <call_once fun="nav_move_waypoint_enu(WP_START, WaypointX(WP_START), WaypointY(WP_START), WaypointAlt(WP_DROP) + M4_SAFE_HEIGHT_M)"/>
      <call_once fun="nav_drop_compute_approach(WP_DROP, WP_START, WP__DROPTURN, WP__CLIMBOUT, M4_DROPTURN_SIDE * fabsf(nav_radius))"/>
      <call_once fun="nav_move_waypoint_enu(WP__CLIMBOUT, WaypointX(WP_DROP) + (WaypointX(WP_DROP) - WaypointX(WP_START)) * 0.68, WaypointY(WP_DROP) + (WaypointY(WP_DROP) - WaypointY(WP_START)) * 0.68, WaypointAlt(WP_DROP) + M4_SAFE_HEIGHT_M)"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="10.0"/>
      <circle radius="M4_DROPTURN_SIDE * fabsf(nav_radius)" until="NavQdrCloseTo(DegOfRad(nav_drop_start_qdr)-15)" wp="_DROPTURN"/>
      <deroute block="drop_high_run"/>
    </block>
    <!-- Level run-in at 35 m; RELEASE is re-computed every cycle for the real ground speed and
         fall height; the hatch opens when the RELEASE line is crossed (no 2 m gate). -->
    <block name="drop_high_run">
      <exception cond="nav_drop_update_release(WP_DROP)" deroute="Standby"/>
      <exception cond="NavApproachingFrom(WP_RELEASE, WP_START, 0) @AND (earcam_drop_shoot_high(WP_DROP) == 0)" deroute="drop_climbout"/>
      <go approaching_time="0" from="START" hmode="route" wp="RELEASE"/>
      <deroute block="drop_missed"/>
    </block>

    <!-- Released -> mission done, back to Standby (then press Land). Not released -> fly the
         approach again; drop_setup lays it out anew from the present course. At most 3
         approaches in total, then Standby so the team can decide. -->
    <block name="drop_decide">
      <exception cond="earcam_drop_released" deroute="Standby"/>
      <exception cond="drop_approaches @GT 2" deroute="Standby"/>
      <deroute block="drop_setup"/>
    </block>

    <!-- ================================================================================
         3. Landing: base leg circle, glide AF -> TD, flare with the motor off.
         Put TD in the designated landing area for the landing bonus.
         ================================================================================ -->
    <block name="land" strip_button="Land" strip_icon="land-right.png">
      <call_once fun="nav_compute_baseleg(WP_AF, WP_TD, WP__BASELEG, nav_radius)"/>
      <circle radius="nav_radius" until="NavCircleCount() @GT 0.5" wp="_BASELEG"/>
      <circle radius="nav_radius" until="And(NavQdrCloseTo(DegOfRad(baseleg_out_qdr)-(nav_radius/fabs(nav_radius))*10), 10 @GT fabs(GetPosAlt() - WaypointAlt(WP__BASELEG)))" wp="_BASELEG"/>
      <deroute block="final"/>
    </block>
    <block name="final">
      <exception cond="GetAltRef() + 10 @GT GetPosAlt()" deroute="flare"/>
      <go from="AF" hmode="route" vmode="glide" wp="TD"/>
    </block>
    <block name="flare">
      <go approaching_time="0" from="AF" hmode="route" throttle="0.0" vmode="throttle" wp="TD"/>
      <attitude roll="0.0" throttle="0.0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
