<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">

<flight_plan name="NPS Fixedwing Tuning" lat0="43.46223" lon0="1.27289"
             ground_alt="185" alt="225" security_height="15" max_dist_from_home="1000">
  <header>
#include "modules/datalink/datalink.h"
  </header>

  <waypoints>
    <waypoint name="HOME" x="0" y="0"/>
    <waypoint name="1" x="20" y="120"/>
    <waypoint name="2" x="140" y="120"/>
  </waypoints>

  <blocks>
    <block name="Holding point">
      <set var="autopilot.kill_throttle" value="1"/>
      <attitude roll="0" throttle="0" vmode="throttle"/>
    </block>

    <block name="Takeoff">
      <set var="autopilot.kill_throttle" value="0"/>
      <set var="autopilot.flight_time" value="0"/>
      <attitude roll="0" pitch="5" throttle="1.0" vmode="throttle"
                until="GetPosAlt() @GT ground_alt + 25"/>
      <set var="flight_altitude" value="GetPosAlt()"/>
      <deroute block="Oval 1-2"/>
    </block>

    <block name="Oval 1-2">
      <oval p1="1" p2="2" radius="nav_radius" alt="flight_altitude"/>
    </block>
  </blocks>
</flight_plan>