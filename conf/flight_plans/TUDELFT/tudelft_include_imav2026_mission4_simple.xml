<!-- <!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd"> -->

<!-- 
  SIMPLIEFIED MISSION4 Just in case the real Mission4 does not work so well

  EARcam search: listen for X seconds in a flower around MRP, then descend
  to Z(30?) m above the ground reference and refine for X seconds around TANGUY.
  CATIA must have the real or simulated EARcam backend enabled. -->
<!-- <flight_plan alt="190" ground_alt="140" lat0="48.808252" lon0="7.856789" max_dist_from_home="900" name="IMAV2026_EARCAM" security_height="40" home_mode_height="50">  -->
<!---->
<procedure>
  <header>
#include "modules/datalink/datalink.h"
#include "modules/digital_cam/dc.h"
#include "modules/digital_cam/earcam_ctrl.h"
#include "math/pprz_random.h"

//Enable energy control commands from within flightplan
    #include "firmwares/fixedwing/guidance/energy_ctrl.h"

// States
    #define AircraftIsBooting()  LessThan(nav_block,4)  // LessThan(nav_block,IndexOfBlock('Mission.ReadyForDeparture'))

#define DropClose() ({ commands[COMMAND_HATCH] = MIN_PPRZ; })
#define DropOpen() ({ commands[COMMAND_HATCH] = SERVO_HATCH_OPEN; })
  </header>

  <variables>
    <variable var="tanguy_random_radius" type="float" init="0."/>
    <variable var="tanguy_random_angle" type="float" init="0."/>
  </variables>

  <waypoints>
    <!--<waypoint name="HOME" x="0" y="0" height="2."/>--><!-- LEAVEIN PLACE but it is SET from MAIN flight plan -->

    <!-- Moved by the flight plan to the EARcam result; height is the release height. -->
    <waypoint name="DROP" lat="48.81045" lon="7.85170" height="20.0"/><!-- TODO: Height adjusted for rangefinder 1.5M -->
    <waypoint name="DROP_START" lat="48.80990" lon="7.85170" height="20.0"/><!-- TODO: Height adjustment based on mission requirements -->
    <!-- The given Manequin Research Area MID point of Circle of 25m -->
    <waypoint name="MRP" lat="48.81050" lon="7.85160"/>
    <waypoint name="_MRP_EDGE" lat="48.81050" lon="7.85160"/>
    <!-- Poor Tanguy firefighter with MotionSCOUT, the position to be found and re-positioned by the system -->
    <waypoint name="TANGUY" lat="48.81050" lon="7.85160" height="1.7"/><!-- Zero actually, but in case we make aFP mistake and use this instead of drop -->
    <waypoint name="_TANGUY_EDGE" x="-25.0" y="62.0" height="0."/>
    <!-- USED only for height reference  for the refine listen run MUST BE above treetops -->
    <waypoint name="REFINE" lat="48.81050" lon="7.85160" height="17"/>
  </waypoints>


  <blocks>

    <!-- <attitude roll="0" throttle="0" vmode="throttle"/>--> <!-- To disable wriggly Actuators in Auto2, and throttle to 0 just in case -->
    <!-- If you have an RC transmitter backup, one must have the TX at least switched on once. This check can be disabled if everything works 100% in Auto2 and you have no TX -->
    <!-- To make sure we do not hop to AUTO2 and motor could starts running, at least switch on then maybe off if you want to -->
    <!-- <block name="Waiting for RC Transmitter">
      <while cond="RCLost()"/>
      <exception cond="ThrottleHigh()" deroute="Takeoff"/>
    </block> -->
    
    <block name="Takeoff Mission 4" strip_icon="takeoff.png" strip_button="Takeoff M4">
      <set var="autopilot.kill_throttle" value="0"/>
      <set var="autopilot.flight_time" value="0"/>
      <set var="autopilot.launch" value="1"/>
      <exception cond="GetPosAlt() @GT GetAltRef()+25" deroute="go_find_tanguy_and_rescue"/>
      <call_once fun="NavSetWaypointHere(WP_TAKEOFF_POINT)"/>
      <go from="TAKEOFF_POINT" hmode="route" wp="CLIMB" throttle="1.0" vmode="throttle" pitch="15" until="GetPosAlt() @GT GetAltRef() + 25"/>
    </block>

    <!-- <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <circle radius="nav_radius" wp="STDBY"/>
    </block> -->

    <!-- 1. Reach MRP before starting the 40-second flower timer. -->
    <block name="go_find_tanguy_and_rescue" strip_button="rescue" strip_icon="learn.png">
      <!-- <exception cond="block_time @GT 300" deroute="land"/> -->
      <set var="WaypointX(WP__MRP_EDGE)" value="WaypointX(WP_MRP) + 29"/>
      <set var="WaypointY(WP__MRP_EDGE)" value="WaypointY(WP_MRP)"/>
      <call_once fun="earcam_start()"/>
      <go approaching_time="0" hmode="route" wp="MRP"/>
      <deroute block="find_loudspot_scan"/>
    </block>

    <block name="find_loudspot_scan">
      <call_once fun="nav_flower_setup(WP_MRP, WP__MRP_EDGE)"/>
      <call break="true" fun="nav_flower_run()" until="NavBlockTime() @GT 50"/>
      <deroute block="find_loudspot_finish"/>
    </block>

    <!-- 2. Coarse result: MORA fuses the survey samples (sampling keeps running).
         Block exceptions are evaluated before the block body, so a block that
         requests a solve must not test the reply flag itself: request here, wait
         in the next block. -->
    <block name="find_loudspot_finish">
      <call_once fun="earcam_solve()"/>
      <deroute block="find_loudspot_wait"/>
    </block>

    <block name="find_loudspot_wait">
      <exception cond="earcam_result_fresh" deroute="refine_setup"/>
      <exception cond="NavBlockTime() @GT 5" deroute="refine_setup"/>
      <circle wp="MRP" radius="nav_radius"/>
    </block>

    <block name="find_loudspot_failed">
      <call_once fun="earcam_stop()"/>
      <deroute block="loudspot_random"/>
    </block>

    <!-- 3. Refine around an in-circle estimate, otherwise around MRP.
          Reach 30 m before starting the second 40-second listening pass. -->
    <block name="refine_setup">
      <exception cond="earcam_result_within(WP_MRP, 25)" deroute="refine_setup_result"/>
      <set var="WaypointX(WP_TANGUY)" value="WaypointX(WP_MRP)"/>
      <set var="WaypointY(WP_TANGUY)" value="WaypointY(WP_MRP)"/>
      <deroute block="refine_setup_geometry"/>
    </block>

    <block name="refine_setup_result">
      <call_once fun="earcam_result_to_waypoint(WP_TANGUY)"/>
      <deroute block="refine_setup_geometry"/>
    </block>

    <block name="refine_setup_geometry">
      <set var="WaypointX(WP__TANGUY_EDGE)" value="WaypointX(WP_TANGUY) + 29"/>
      <set var="WaypointY(WP__TANGUY_EDGE)" value="WaypointY(WP_TANGUY)"/>
      <call_once fun="nav_flower_setup(WP_TANGUY, WP__TANGUY_EDGE)"/>
      <deroute block="refine_descend"/>
    </block>

    <block name="refine_descend">
      <exception cond="NavBlockTime() @GT 90" deroute="find_loudspot_failed"/>
      <call break="true" fun="nav_flower_run()" until="LessThan(fabs(GetPosAlt() - WaypointAlt(WP_REFINE)), 2)"/>
      <deroute block="refine_flower"/>
    </block>

    <block name="refine_flower">
      <call break="true" fun="nav_flower_run()" until="NavBlockTime() @GT 39"/><!-- TODO: Adjust the 40s duration based on actual testing results -->
      <deroute block="loudspot"/>
    </block>

    <!-- 4. After both passes, use the final estimate or the last valid interim one.
          An outside estimate is projected into the MRP circle with 1 cm margin.
          With no valid estimate, choose TANGUY uniformly inside that circle.
          DROP follows this constrained TANGUY position, not the raw sound picture. -->
    <block name="loudspot">
      <set var="earcam_result_fresh" value="FALSE"/>
      <call_once fun="earcam_stop()"/>
      <deroute block="loudspot_wait"/>
    </block>

    <block name="loudspot_wait">
      <exception cond="earcam_result_fresh" deroute="loudspot_apply"/>
      <exception cond="NavBlockTime() @GT 5" deroute="loudspot_apply"/>
      <circle radius="nav_radius" wp="TANGUY"/>
    </block>

    <block name="loudspot_apply">
      <exception cond="!earcam_result_valid" deroute="loudspot_random"/>
      <exception cond="earcam_result_to_waypoint_in_circle(WP_TANGUY, WP_MRP, 25)" deroute="find_loudspot_failed"/>
      <deroute block="loudspot_ready"/>
    </block>

    <block name="loudspot_random">
      <call_once fun="init_random()"/>
      <set var="tanguy_random_radius" value="24.99 * sqrt(rand_uniform())"/>
      <set var="tanguy_random_angle" value="RadOfDeg(360) * rand_uniform()"/>
      <set var="WaypointX(WP_TANGUY)" value="WaypointX(WP_MRP) + tanguy_random_radius * cosf(tanguy_random_angle)"/>
      <set var="WaypointY(WP_TANGUY)" value="WaypointY(WP_MRP) + tanguy_random_radius * sinf(tanguy_random_angle)"/>
      <deroute block="loudspot_ready"/>
    </block>

    <block name="loudspot_ready">
      <set var="WaypointX(WP_DROP)" value="WaypointX(WP_TANGUY)"/>
      <set var="WaypointY(WP_DROP)" value="WaypointY(WP_TANGUY)"/>
      <call_once fun="earcam_place_run_in(WP_DROP_START, WP_DROP, 3 * fabs(nav_radius))"/>
      <deroute block="drop_approach"/>
    </block>

<!--  AS REMINDER
 extern unit_t nav_drop_compute_approach( uint8_t wp_target, uint8_t wp_start, float radius );
extern unit_t nav_drop_update_release( uint8_t wp_target );
extern unit_t nav_drop_shoot( void );
extern float nav_drop_trigger_delay, nav_drop_start_qdr;
extern bool_t compute_alignment(uint8_t w1, uint8_t w2, uint8_t start, uint8_t end, float d_before, float d_after);

#define NavDropComputeApproach(_target, _start, _radius) nav_drop_compute_approach(_target, _start, _radius)
#define NavDropUpdateRelease(_wp) nav_drop_update_release(_wp)
#define NavDropShoot() nav_drop_shoot()
#define NavDropCloseHatch() ({ commands[COMMAND_HATCH] = MIN_PPRZ; })
#define NavDropAligned() Qdr(DegOfRad(nav_drop_qdr_aligned)) -->

    <block name="drop_approach">
      <exception cond="NavApproaching(WP_DROP_START, CARROT)" deroute="drop"/>
      <go hmode="route" wp="DROP_START"/>
    </block>
    
    <!--TODO Height on Rangefinder 1.5M-->
    <block name="drop" strip_button="Drop" strip_icon="parachute.png">
      <exception cond="NavApproachingFrom(WP_DROP, WP_DROP_START, 0)" deroute="drop_release"/>
      <go from="DROP_START" hmode="route" wp="DROP"/>
    </block>

    <block name="drop_release">
      <call_once fun="DropOpen()"/>
      <deroute block="Common.land"/>
    </block>

    <!-- 
    *********************************************************
    ********************* Autolanding ***********************
    *********************************************************
    -->
    <!-- TODO: Use the Precision-Landing module options for the final approach when that reliably works tested -->

      <!-- CDW call_once fun="nav_compute_flare_from_aftd(WP_AF, WP_TD, WP_FLARE)"/-->
    <!-- <block name="ComputeLandingApproach" >
      <call_once fun="nav_compute_final_from_glide(WP_AF, WP_TD, V_CTL_GLIDE_RATIO)"/>
      <call_once fun="DownlinkSendWpNr(WP_AF)"/>
      <call_once fun="DownlinkSendWpNr(WP_FLARE)"/>
      </block> -->

    <!-- TODO: Make it NON circle and mind tree hight-->
    
    <!-- Manual emergency action: AUX1 at maximum disables normal guidance and
         commands a steep fixed-wing attitude with the motor stopped. -->
    
  </blocks>
</procedure>
<!-- </flight_plan> -->
