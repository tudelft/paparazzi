<!DOCTYPE procedure SYSTEM "../flight_plan.dtd">

<!--
  IMAV 2026 Precision Landing Flight Plan
  =======================================
  Shared flight plan for ZOHD Talon 250G ("Adam") and Multiplex EasyStar 3.
  
  Overview:
  - Survey and replace the example origin and TD before use; startup does not relocate them.
  - Waypoint 'AF' (Approach Fix) is positioned ~149 m upstream of the fixed-wing sector center.
  - TD is the center of sector Takeoff_Landing_zone_Fixedwing.
  - Upstream glide aim: Adam 7m, EasyStar 12m; validate actual contact and stop separately.
  - Projected contact must remain inside Takeoff_Landing_zone_Fixedwing and within the 1.2m lateral controller limit.
  - A landing is valid only after the aircraft is stationary with its engine off inside that sector.
  
  Field Execution & Tuning Quick Reference:
  - Select 'Land Right AF-TD' or 'Land Left AF-TD' from GCS to start landing sequence.
  - Adjustable GCS Variables:
      * landing_airspeed (m/s): Target approach speed (default 9.0 m/s). Must stay above stall.
      * final_height (m): Height above TD elevation at Approach Fix (default 17.0 m).
      * brake_agl (m): Laser AGL altitude below which predictive crow braking activates (default 3.5 m).
      * flare_agl (m): Laser AGL altitude where fixed pitch flare engages (default 2.0m Adam / 1.2m EasyStar).
      * glide_aim (m): Upstream endpoint of the geometric glide path (EasyStar 12.0m).
      * brake_aim (m): Independent predicted-contact target for close-range crow braking (EasyStar 2.0m).
      * touchdown_pitch (deg): Commanded flare pitch attitude (Adam +4.0 deg / EasyStar 0.0 deg).
      * flare_brake (0-0.75): Constant crow deflection held during flare (0.30 Adam / 0.65 EasyStar).
      * landing_max_retries: Number of automatic go-around retries permitted (default 0).
-->
<procedure>
  <header>
#include "modules/datalink/datalink.h"
#include "modules/digital_cam/uart_cam_ctrl.h"
#include "modules/sonar/agl_dist.h"
  </header>

  <!-- Waypoint Definitions (ENU coordinates in meters relative to lat0/lon0 reference) -->
  <waypoints>
    <waypoint name="WAIT360" x="49.5" y="100.1"/>

    <waypoint name="_BASELEG" x="168.8" y="-13.8"/>

    <!-- Precision Landing Runway Waypoints -->
    <waypoint height="20.0" name="AF" x="-13.1" y="52.3"/> <!-- Xmeters upstream on the sector centerline -->
    <waypoint height="0.0" name="TD" x="-22.0" y="201.0"/> <!-- Fixed-wing landing-sector center -->
  </waypoints>

  <!-- <exceptions>-->
    <!-- Global exceptions can be defined here -->
  <!--</exceptions> -->

  <blocks>

    <!-- Landing Entry Blocks: Initiate landing sequence with Right or Left baseleg pattern -->
    <block name="PCLand Right AF-TD" strip_button="Land right (wp AF-TD)" strip_icon="land-right.png" group="PCland" on_enter="precision_landing_start()">
      <exception cond="!precision_landing_parameters_valid() @OR !precision_landing_entry_valid(WP_AF, WP_TD, DEFAULT_CIRCLE_RADIUS)" deroute="wait360"/>
      <call_once fun="precision_landing_reset_retries()"/>
      <set value="WaypointAlt(WP_TD) + precision_landing_final_height" var="WaypointAlt(WP_AF)"/>
      <set value="DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <block name="PCLand Left AF-TD" strip_button="Land left (wp AF-TD)" strip_icon="land-left.png" group="PCland" on_enter="precision_landing_start()">
      <exception cond="!precision_landing_parameters_valid() @OR !precision_landing_entry_valid(WP_AF, WP_TD, DEFAULT_CIRCLE_RADIUS)" deroute="wait360"/>
      <call_once fun="precision_landing_reset_retries()"/>
      <set value="WaypointAlt(WP_TD) + precision_landing_final_height" var="WaypointAlt(WP_AF)"/>
      <set value="-DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <!-- Baseleg Navigation & Runway Alignment -->
    <block name="land">
      <exception cond="!precision_landing_is_active()" deroute="wait360"/>
      <exception cond="!precision_landing_parameters_valid() @OR !precision_landing_entry_valid(WP_AF, WP_TD, nav_radius)" deroute="wait360"/>
      <exception cond="NavBlockTime() @GT 90" deroute="wait360"/>
      <set value="precision_landing_approach_airspeed" var="v_ctl_auto_airspeed_setpoint"/>
      <call_once fun="nav_compute_baseleg(WP_AF, WP_TD, WP__BASELEG, nav_radius)"/>
      <circle radius="nav_radius" until="NavCircleCount() @GT 0.5" wp="_BASELEG"/>
      <circle climb="-0.8" radius="nav_radius" until="2 @GT fabs(GetPosAlt() - WaypointAlt(WP__BASELEG))" vmode="climb" wp="_BASELEG"/>
      <circle radius="nav_radius" until="NavQdrCloseTo(DegOfRad(baseleg_out_qdr)-(nav_radius/fabs(nav_radius))*10)" wp="_BASELEG"/>
    </block>

    <!-- Block pre_call evaluates decisions before generated exceptions. -->
    <block name="final" on_enter="precision_landing_setup_zone(WP_AF, WP_TD, WP__TLFW1, WP__TLFW2, WP__TLFW3, WP__TLFW4)" pre_call="precision_landing_run()" on_exit="precision_landing_release()">
      <set value="precision_landing_approach_airspeed" var="v_ctl_auto_airspeed_setpoint"/>
      <!-- Commitment takes precedence over powered abort. -->
      <exception cond="precision_landing_cancelled" deroute="wait360"/>
      <exception cond="precision_landing_commit_flare" deroute="flare"/>
      <exception cond="precision_landing_abort @OR !precision_landing_parameters_valid()" deroute="go_around"/>
      <exception cond="precision_landing_agl_fresh @AND (precision_landing_flare_agl @GT agl_dist_value_filtered)" deroute="flare"/>
      <!-- Execute geometric glide slope along AF-to-TD route; pre_call runs prediction/braking, post_call updates glide slope altitude -->
      <go approaching_time="0" from="AF" hmode="route" vmode="glide" wp="TD" post_call="precision_landing_glide()"/>
      <deroute block="go_around"/>
    </block>

    <!-- Zero throttle is local to flare; global kill remains owned by the pilot/failsafes. -->
    <block name="flare" on_enter="precision_landing_flare_run()" pre_call="precision_landing_flare_run()" on_exit="precision_landing_stop()">
      <exception cond="precision_landing_cancelled" deroute="wait360"/>
      <while cond="TRUE"/>
    </block>

    <!-- Go-Around State: Straight climb-out on runway heading, retracts brakes, climbs to 25m AGL before re-entering baseleg -->
    <block name="go_around" on_enter="precision_landing_check_abort()" pre_call="precision_landing_check_abort()">
      <exception cond="precision_landing_cancelled" deroute="wait360"/>
      <exception cond="precision_landing_commit_flare" deroute="flare"/>
      <call_once fun="precision_landing_release()"/>
      <set value="NOMINAL_AIRSPEED" var="v_ctl_auto_airspeed_setpoint"/>
      <heading course="DegOfRad(atan2(WaypointX(WP_TD)-WaypointX(WP_AF), WaypointY(WP_TD)-WaypointY(WP_AF)))" pitch="DegOfRad(TAKEOFF_PITCH_ANGLE)" throttle="1.0" vmode="throttle" until="GetPosAlt() @GT GetAltRef()+25"/>
      <go from="TD" hmode="route" wp="AF" alt="GetAltRef()+25"/>
      <call_once fun="precision_landing_record_retry()"/>
      <deroute block="retry decision"/>
    </block>

    <!-- Retry Decision: default zero retries returns to Standby after the first safety abort. -->
    <!-- Of no succes after X times We like to do a regular auto landing then -->
    <block name="retry_decision">
      <exception cond="!precision_landing_is_active()" deroute="wait360"/>
      <exception cond="!precision_landing_parameters_valid()" deroute="wait360"/>
      <exception cond="precision_landing_retry_allowed()" deroute="land"/>
      <deroute block="standby"/>
    </block>

    <block key="Ctrl+a" name="wait360" strip_button="Wait360" strip_icon="home.png" group="home">
      <call_once fun="dc_stop()"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="mapping_airspeed"/>
      <circle radius="DEFAULT_CIRCLE_RADIUS" vmode="alt" alt="GetAltRef()+mapping_height" wp="STDBY"/>
    </block>
  </blocks>
</procedure>
