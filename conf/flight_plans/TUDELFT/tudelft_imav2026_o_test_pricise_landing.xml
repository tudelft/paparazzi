<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">

<!--
  IMAV 2026 Precision Landing Flight Plan
  =======================================
  Shared flight plan for ZOHD Talon 250G ("Adam") and Multiplex EasyStar 3.
  
  Overview:
  - Touchdown target waypoint 'TD' is the surveyed center of the 20 x 3 m precision landing box.
  - Waypoint 'AF' (Approach Fix) is positioned ~149 m upstream along the runway centerline into wind.
  - The controller uses an upstream aim point ('aim_before_td', default 6m before TD) to absorb flare float.
  - Hard safety abort limits retain 2.0m longitudinal and 0.3m lateral margin inside the official scoring box.
  
  Field Execution & Tuning Quick Reference:
  - Select 'Land Right AF-TD' or 'Land Left AF-TD' from GCS to start landing sequence.
  - Adjustable GCS Variables:
      * landing_airspeed (m/s): Target approach speed (default 9.0 m/s). Must stay above stall.
      * final_height (m): Height above TD elevation at Approach Fix (default 17.0 m).
      * brake_agl (m): Laser AGL altitude below which predictive crow braking activates (default 3.5 m).
      * flare_agl (m): Laser AGL altitude where fixed pitch flare engages (default 2.0m Adam / 1.2m EasyStar).
      * aim_before_td (m): Distance upstream of TD used as nominal zero-brake aim (default 6.0 m).
      * touchdown_pitch (deg): Commanded flare pitch attitude (default +4.0 deg for foam pusher airframes).
      * flare_brake (0-0.75): Constant crow deflection held during flare (0.30 Adam / 0.65 EasyStar).
      * landing_max_retries: Number of automatic go-around retries permitted (default 2).
-->
<flight_plan alt="355" ground_alt="295" lat0="43.46223" lon0="1.27289" max_dist_from_home="1500" name="Precision Landing Test" security_height="25">
  <header>
#include "modules/datalink/datalink.h"
#include "modules/digital_cam/uart_cam_ctrl.h"
#include "modules/sonar/agl_dist.h"
</header>

  <!-- Waypoint Definitions (ENU coordinates in meters relative to lat0/lon0 reference) -->
  <waypoints>
    <waypoint name="HOME" x="0" y="0"/>
    <waypoint name="STDBY" x="49.5" y="100.1"/>
    <waypoint name="1" x="10.1" y="189.9"/>
    <waypoint name="2" x="132.3" y="139.1"/>
    <waypoint name="MOB" x="137.0" y="-11.6"/>
    <waypoint name="S1" x="-119.2" y="69.6"/>
    <waypoint name="S2" x="274.4" y="209.5"/>
    <waypoint name="_BASELEG" x="168.8" y="-13.8"/>
    <waypoint name="CLIMB" x="-114.5" y="162.3"/>
    <!-- MotionSCOUT acoustic target location -->
    <waypoint name="MSCOUT" x="-54.0" y="62.0"/>
    <!-- Precision Landing Runway Waypoints -->
    <waypoint alt="312.0" name="AF" x="177.4" y="45.1"/> <!-- Approach Fix: ~149m upstream of TD -->
    <waypoint alt="295.0" name="TD" x="28.8" y="57.0"/>  <!-- Touchdown Target: Center of 20 x 3 m box -->
  </waypoints>

  <!-- Live Flight-Plan Variables (Real-time tuning via Paparazzi GCS) -->
  <variables>
    <variable var="landing_airspeed" init="PRECISION_LANDING_APPROACH_AIRSPEED" min="7.0" max="12.0" step="0.1" unit="m/s"/>
    <variable var="final_height" init="PRECISION_LANDING_FINAL_HEIGHT" min="10.0" max="25.0" step="0.5" unit="m"/>
    <variable var="brake_agl" init="PRECISION_LANDING_BRAKE_AGL" min="2.5" max="4.0" step="0.1" unit="m"/>
    <variable var="flare_agl" init="PRECISION_LANDING_FLARE_AGL" min="0.5" max="2.5" step="0.1" unit="m"/>
    <variable var="aim_before_td" init="PRECISION_LANDING_AIM_BEFORE_TD" min="2.0" max="7.0" step="0.5" unit="m"/>
    <variable var="touchdown_pitch" init="PRECISION_LANDING_TOUCHDOWN_PITCH" min="-5.0" max="10.0" step="0.5" unit="deg"/>
    <variable var="flare_brake" init="PRECISION_LANDING_FLARE_BRAKE" min="0.0" max="0.75" step="0.05"/>
    <variable var="landing_retry_count" type="uint8_t" init="0"/>
    <variable var="landing_max_retries" type="uint8_t" init="2" min="0" max="5" step="1"/>
  </variables>

  <!-- Loaded Modules -->
  <modules>
    <module name="precision_landing"/>
  </modules>

  <exceptions>
    <!-- Global exceptions can be defined here -->
  </exceptions>

  <blocks>
    <!-- Block 0: Wait for 3D GNSS lock before disarming disarm checks -->
    <block name="Wait GPS">
      <set value="1" var="autopilot.kill_throttle"/>
      <while cond="!GpsFixValid()"/>
    </block>

    <!-- Block 1: Ground reference initialization -->
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 10)"/>
      <call_once fun="NavSetGroundReferenceHere()"/>
    </block>

    <!-- Block 2: Ground holding point (safety disarm) -->
    <block name="Holding point">
      <call_once fun="precision_landing_stop()"/>
      <set value="1" var="autopilot.kill_throttle"/>
      <attitude roll="0" throttle="0" vmode="throttle"/>
    </block>

    <!-- Block 3: Pre-flight bench inspection for crow airbrakes -->
    <block name="Crow brake bench test" strip_button="Crow bench test" group="land">
      <set value="1" var="autopilot.kill_throttle"/>
      <call_once fun="AirbrakesOn()"/>
      <attitude pitch="0" roll="0" throttle="0" until="stage_time @GT 3" vmode="throttle"/>
      <call_once fun="AirbrakesOff()"/>
      <deroute block="Holding point"/>
    </block>

    <!-- Block 4: Hand-launch Takeoff sequence -->
    <block key="t" name="Takeoff" strip_button="Takeoff (wp CLIMB)" strip_icon="takeoff.png" group="home">
      <exception cond="GetPosAlt() @GT GetAltRef()+25" deroute="Standby"/>
      <call_once fun="precision_landing_stop()"/>
      <set value="0" var="autopilot.kill_throttle"/>
      <set value="0" var="autopilot.flight_time"/>
      <go from="HOME" throttle="1.0" vmode="throttle" wp="CLIMB" pitch="DegOfRad(TAKEOFF_PITCH_ANGLE)"/>
    </block>

    <!-- Block 5: Standby loiter circle -->
    <block key="Ctrl+a" name="Standby" strip_button="Standby" strip_icon="home.png" group="home">
      <call_once fun="precision_landing_stop()"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>

    <!-- Mission Pattern Blocks -->
    <block name="Oval 1-2" strip_button="Oval (wp 1-2)" strip_icon="oval.png" group="base_pattern">
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_AICAM)"/>
      <call_once fun="dc_send_command(DC_SHOOT)"/>
      <set value="DC_AUTOSHOOT_PERIODIC" var="dc_autoshoot"/>
      <oval p1="1" p2="2" radius="nav_radius"/>
    </block>

    <block name="XOval 1-2" strip_button="XOval (wp 1-2)" strip_icon="lookdown.png" group="base_pattern">
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_LWIR)"/>
      <call_once fun="dc_send_command(DC_SHOOT)"/>
      <set value="DC_AUTOSHOOT_PERIODIC" var="dc_autoshoot"/>
      <oval p1="1" p2="2" radius="nav_radius"/>
    </block>

    <block name="Survey S1-S2" strip_button="Survey (wp S1-S2)" strip_icon="survey.png" group="extra_pattern">
      <survey_rectangle grid="150" wp1="S1" wp2="S2"/>
    </block>

    <!-- Landing Entry Blocks: Initiate landing sequence with Right or Left baseleg pattern -->
    <block name="Land Right AF-TD" strip_button="Land right (wp AF-TD)" strip_icon="land-right.png" group="land">
      <set value="0" var="landing_retry_count"/>
      <set value="WaypointAlt(WP_TD) + final_height" var="WaypointAlt(WP_AF)"/>
      <set value="DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <block name="Land Left AF-TD" strip_button="Land left (wp AF-TD)" strip_icon="land-left.png" group="land">
      <set value="0" var="landing_retry_count"/>
      <set value="WaypointAlt(WP_TD) + final_height" var="WaypointAlt(WP_AF)"/>
      <set value="-DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <!-- Baseleg Navigation & Runway Alignment -->
    <block name="land">
      <set value="landing_airspeed" var="v_ctl_auto_airspeed_setpoint"/>
      <call_once fun="nav_compute_baseleg(WP_AF, WP_TD, WP__BASELEG, nav_radius)"/>
      <circle radius="nav_radius" until="NavCircleCount() @GT 0.5" wp="_BASELEG"/>
      <circle radius="nav_radius" until="NavQdrCloseTo(DegOfRad(baseleg_out_qdr)-(nav_radius/fabs(nav_radius))*10) @AND (fabs(GetPosAlt() - WaypointAlt(WP__BASELEG)) @LT 1.0)" wp="_BASELEG"/>
    </block>

    <!-- Final Approach State: Rangefinder monitoring, predictive crow braking, and safety gating -->
    <block name="final" on_enter="precision_landing_setup(WP_AF, WP_TD, brake_agl, aim_before_td)" on_exit="precision_landing_stop()">
      <set value="landing_airspeed" var="v_ctl_auto_airspeed_setpoint"/>
      <!-- Safety Exceptions: GNSS loss above commit height or predictive abort trigger go-around -->
      <exception cond="!GpsFixValid() @AND precision_landing_should_commit(GetPosAlt()-WaypointAlt(WP_TD), 2.5)" deroute="flare"/>
      <exception cond="!GpsFixValid()" deroute="go-around"/>
      <exception cond="precision_landing_abort" deroute="go-around"/>
      <exception cond="precision_landing_commit_flare" deroute="flare"/>
      <exception cond="precision_landing_agl_fresh @AND (flare_agl @GT agl_dist_value_filtered)" deroute="flare"/>
      <!-- Execute geometric glide slope along AF-to-TD route; pre_call runs prediction/braking, post_call updates glide slope altitude -->
      <go approaching_time="0" from="AF" hmode="route" vmode="glide" wp="TD" pre_call="precision_landing_run()" post_call="precision_landing_glide()"/>
      <deroute block="go-around"/>
    </block>

    <!-- Flare State: Throttle disarmed, pitch held at touchdown_pitch, fixed flare brake applied -->
    <block name="flare" pre_call="precision_landing_flare(flare_brake)" on_exit="precision_landing_stop()">
      <set value="1" var="autopilot.kill_throttle"/>
      <go approaching_time="0" from="AF" hmode="route" pitch="touchdown_pitch" throttle="0.0" vmode="throttle" wp="TD"/>
      <attitude pitch="touchdown_pitch" roll="0.0" throttle="0.0" until="FALSE" vmode="throttle"/>
    </block>

    <!-- Go-Around State: Straight climb-out on runway heading, retracts brakes, climbs to 25m AGL before re-entering baseleg -->
    <block name="go-around">
      <call_once fun="precision_landing_stop()"/>
      <set value="0" var="autopilot.kill_throttle"/>
      <set value="NOMINAL_AIRSPEED" var="v_ctl_auto_airspeed_setpoint"/>
      <heading course="DegOfRad(atan2(WaypointX(WP_TD)-WaypointX(WP_AF), WaypointY(WP_TD)-WaypointY(WP_AF)))" pitch="DegOfRad(TAKEOFF_PITCH_ANGLE)" throttle="1.0" vmode="throttle" until="GetPosAlt() @GT GetAltRef()+25"/>
      <go from="TD" hmode="route" wp="AF" alt="GetAltRef()+25"/>
      <set value="landing_retry_count + 1" var="landing_retry_count"/>
      <deroute block="retry decision"/>
    </block>

    <!-- Retry Decision: Limits go-arounds to landing_max_retries before returning to Standby loiter -->
    <block name="retry decision">
      <exception cond="!(landing_retry_count @GT landing_max_retries)" deroute="land"/>
      <deroute block="Standby"/>
    </block>
  </blocks>
</flight_plan>
