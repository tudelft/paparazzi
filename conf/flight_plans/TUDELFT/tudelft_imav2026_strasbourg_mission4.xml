<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<!-- This is the Flightplan of team TU Delft MAVlab for use in the
     IMAV2026 Outdoor Challenge of 2026 in Strasbourg

     MISSION 4 ONLY (Easystar_3), standalone: Common's blocks inlined + the Mission 4 orbit (EARcam search,
     nav_drop low release). Same site, waypoints, sectors and safety as
     tudelft_imav2026_strasbourg.xml (Adam, Missions 1 and 2); keep the two in step.

     Read about this challenge here: https://2026.imavs.org/

-->
<flight_plan alt="193" ground_alt="143" lat0="48.806567" lon0="7.852134" max_dist_from_home="900" name="IMAV2026_M4" security_height="35" home_mode_height="50" qfu="12">

<!-- ******************************* WAYPOINTS ***************************** -->
  <waypoints>
    <!-- Launch / land infrastructure. AF is where the final glide STARTS,
         TD where it touches down. TD is the centre of the official
         "Precision landing Fixedwing zone" (5 x 20 m box, long axis
         353/173 deg); the final is flown SOUTHBOUND (~177 deg): AF 237 m
         north of TD at 30 m AGL (~7.2 deg glide). AF sits east of the
         M4_OW trees and south of M4_OE, so the final and the baseleg circle
         clear the tree sectors. Land AF-TD uses a NEGATIVE radius (baseleg
         circle east of AF). For wind, drag AF round TD in the GCS. -->
    <waypoint name="CLIMB" x="-13.193" y="276.124"/>
    <!-- height, not alt: 30 m above the main plan's ground_alt. -->
    <waypoint name="AF" x="-22.0" y="330.0" height="30."/>
    <waypoint name="_BASELEG" x="-4.723" y="295.562"/>
    <!-- height="0": on the ground, otherwise final climbs from AF to TD. -->
    <waypoint name="TD" x="-10.839" y="93.428" height="0"/>
    <waypoint name="STDBY" x="63.237" y="381.329"/>
  
    <!-- ALL waypoints for SECTORS are defined in the SW, NW, NE, SE -->

    <!-- Fixed-wing launch point (48.8086670N 7.8517466E, origin of the MS plans), inside Takeoff_Landing_zone_Fixedwing.
         Defined here only: included procedures must not define HOME. -->
    <waypoint name="HOME" x="-24.0" y="233.0"/>

    <!-- Default takeoff start (~48.806567N 7.851807E), ~28 m inside the south fence.
         The Mission 4 takeoff block snaps it to the actual launch spot and
         climbs along TAKEOFF_POINT -> CLIMB. -->
    <waypoint name="TAKEOFF_POINT" x="-24.0" y="0.0"/>

