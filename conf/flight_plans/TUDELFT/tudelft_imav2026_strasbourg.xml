-->
<flight_plan alt="193" ground_alt="143" lat0="48.806567" lon0="7.852134" max_dist_from_home="900" name="IMAV2026" security_height="35" home_mode_height="50" qfu="12">

<!-- ******************************* WAYPOINTS ***************************** -->
  <waypoints>
    <!-- Launch / land infrastructure. AF is where the final glide STARTS,
         TD where it touches down. TD is the centre of the official
         "Precision landing Fixedwing zone" (5 x 20 m box, long axis
         353/173 deg); the final is flown SOUTHBOUND (173 deg): AF 200 m
         north of TD at 20 m AGL (~5.7 deg glide). AF is 15 m inside the west
         fence, so Land AF-TD uses a NEGATIVE radius (baseleg circle east of
         AF). For wind, drag AF round TD in the GCS. -->
    <waypoint name="CLIMB" x="-13.193" y="276.124"/>
    <!-- height, not alt: 20 m above the main plan's ground_alt. -->
    <!-- <waypoint name="AF" x="-34.464" y="292.028" height="30."/> -->
    <waypoint name="AF" lat="48.8098402" lon="7.8518795" height="30."/>
    <waypoint name="_BASELEG" x="-4.723" y="295.562"/>
    <!-- height="0": on the ground, otherwise final climbs from AF to TD. -->
    <waypoint name="TD" x="-10.839" y="93.428" height="0"/>
    <waypoint name="STDBY" x="63.237" y="381.329"/>
  
    <!-- ALL waypoints for SECTORS are defined in the SW, NW, NE, SE -->

    <!-- Fixed-wing launch point (48.8086670N 7.8517466E, origin of the MS plans), inside Takeoff_Landing_zone_Fixedwing.
         Defined here only: included procedures must not define HOME. -->
    <waypoint name="HOME" x="-24.0" y="233.0"/>

    <!-- Default takeoff start (~48.806567N 7.851807E), ~28 m inside the south fence.
         The Mission 1/2/4 takeoff blocks snap it to the actual launch spot and
         climb along TAKEOFF_POINT -> CLIMB. -->
    <waypoint name="TAKEOFF_POINT" x="-24.0" y="0.0"/>

    <!-- Used for out of missionboundary tests -->
    <waypoint name="TESTTOOFAR" x="-48." y="537."/>

    <!-- ORGANIZATION Landing Fixedwing zone -->   
    <!-- Landing Fixedwing zone : 48.807761°N 7.851868°E -->
    <!-- Landing Fixedwing zone : 48.807767°N 7.851934°E -->
    <waypoint name="XAF" lat="48.807761" lon="7.851868" alt="158.0"/>
    <waypoint name="XTD" lat="48.807767" lon="7.851934" alt="139.0"/>

