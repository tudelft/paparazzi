<!DOCTYPE procedure SYSTEM "../flight_plan.dtd">
<!--
  IMAV 2026 Mission 4 (orbit) - dead man search and first-aid kit drop, on EARcam.
  Included from tudelft_imav2026_strasbourg_mission4.xml:

    <include name="Mission4" procedure="tudelft_include_imav2026_mission4_orbit.xml">
      <with from="Land_AF_TD" to="Land_AF_TD"/>
    </include>

  Landing (Land_AF_TD) is in the main plan; the procedure reaches it through that reroute.

  Search: low-throttle listening arcs on an orbit round SEARCH_CENTER. EARcam
  (CATIA on MORA) samples only on those arcs (earcam_listen) and returns the
  loudest spot, which becomes DROP_POINT. Drop: the EARcam + nav_drop low
  release of tudelft_include_imav2026_mission4.xml (run-in lane clear of the
  tree sectors, level on the rangefinder, release gate at 2 m).

  In NPS run CATIA with its earcam-sim option (LAT,LON) at TRUE_SOUND_SOURCE; that
  waypoint and _IMPACT are only there to compare against in the simulator.
  The waypoint names START and RELEASE are required by nav_drop.
-->
<procedure>
  <waypoints>
    <waypoint name="SEARCH_CENTER" lat="48.810232" lon="7.851804" height="45."/>
    <!-- Simulator reference only: put the CATIA earcam-sim source at this position. -->
    <waypoint name="TRUE_SOUND_SOURCE" x="-25.123" y="416.162" height="0."/>
    <!-- Release geometry, laid out in Drop_Setup / Drop_Approach:
           DROP_POINT = EARcam result at GROUND level (height 0 = ground reference for the fall height).
           START      = ORBIT_DROP_RUN_IN_M before DROP_POINT on the run-in course; the glide starts at approach_height.
           _LEVEL     = level-off point level_distance before RELEASE at the release height.
           RELEASE    = where the hatch opens, computed by nav_drop every cycle.
           _DROPTURN  = base turn circle centre beside START.
           _CLIMBOUT  = end of the straight climb-out past DROP_POINT (fence limited).
           _EXIT      = centre of the climbing exit circle beside _CLIMBOUT.
           _IMPACT    = where nav_drop expects the kit to land (diagnostic). -->
    <waypoint name="DROP_POINT" x="-24.923" y="233.862" height="0."/>
    <waypoint name="START" x="-24.923" y="233.862" height="15."/>
    <waypoint name="_LEVEL" x="-24.923" y="233.862" height="1.5"/>
    <waypoint name="RELEASE" x="-24.923" y="233.862" height="15."/>
    <waypoint name="_DROPTURN" x="-24.923" y="233.862" height="15."/>
    <waypoint name="_CLIMBOUT" x="-24.923" y="233.862" height="35."/>
    <waypoint name="_EXIT" x="-24.923" y="233.862" height="45."/>
    <waypoint name="_IMPACT" x="-24.923" y="233.862" height="0."/>
    <!-- Tree sectors, simplified from the IGN LiDAR outlines of tudelft_include_imav2026_mission4.xml:
         every corner reuses an original latitude/longitude and each outline contains the original,
         so the obstacle areas only grew (a little, away from the target area). -->
    <waypoint name="_OW1" lat="48.807572" lon="7.848972"/>
    <waypoint name="_OW2" lat="48.807572" lon="7.851632"/>
    <waypoint name="_OW3" lat="48.809713" lon="7.851632"/>
    <waypoint name="_OW4" lat="48.809713" lon="7.851495"/>
    <waypoint name="_OW5" lat="48.810180" lon="7.851495"/>
    <waypoint name="_OW6" lat="48.810180" lon="7.851359"/>
    <waypoint name="_OW7" lat="48.810828" lon="7.851359"/>
    <waypoint name="_OW8" lat="48.811169" lon="7.851223"/>
    <waypoint name="_OW9" lat="48.811934" lon="7.850950"/>
    <waypoint name="_OW10" lat="48.813148" lon="7.850950"/>
    <waypoint name="_OW11" lat="48.813148" lon="7.848972"/>
    <waypoint name="_OE1" lat="48.809928" lon="7.852314"/>
    <waypoint name="_OE2" lat="48.810072" lon="7.852041"/>
    <waypoint name="_OE3" lat="48.810855" lon="7.852041"/>
    <waypoint name="_OE4" lat="48.810855" lon="7.851905"/>
    <waypoint name="_OE5" lat="48.811124" lon="7.851905"/>
    <waypoint name="_OE6" lat="48.811124" lon="7.851768"/>
    <waypoint name="_OE7" lat="48.811664" lon="7.851768"/>
    <waypoint name="_OE8" lat="48.811799" lon="7.853541"/>
    <waypoint name="_OE9" lat="48.811799" lon="7.854087"/>
    <waypoint name="_OE10" lat="48.811529" lon="7.854087"/>
    <waypoint name="_OE11" lat="48.811304" lon="7.853405"/>
    <waypoint name="_OE12" lat="48.810630" lon="7.853200"/>
    <waypoint name="_OE13" lat="48.809928" lon="7.852450"/>
    <waypoint name="_ON1" lat="48.811979" lon="7.851291"/>
    <waypoint name="_ON2" lat="48.811979" lon="7.852791"/>
    <waypoint name="_ON3" lat="48.813418" lon="7.852791"/>
    <waypoint name="_ON4" lat="48.813418" lon="7.851291"/>
  </waypoints>

  <sectors>
    <sector name="M4_OW" color="red">
      <corner name="_OW1"/><corner name="_OW2"/><corner name="_OW3"/><corner name="_OW4"/><corner name="_OW5"/><corner name="_OW6"/><corner name="_OW7"/><corner name="_OW8"/><corner name="_OW9"/><corner name="_OW10"/><corner name="_OW11"/>
    </sector>
    <sector name="M4_OE" color="red">
      <corner name="_OE1"/><corner name="_OE2"/><corner name="_OE3"/><corner name="_OE4"/><corner name="_OE5"/><corner name="_OE6"/><corner name="_OE7"/><corner name="_OE8"/><corner name="_OE9"/><corner name="_OE10"/><corner name="_OE11"/><corner name="_OE12"/><corner name="_OE13"/>
    </sector>
    <sector name="M4_ON" color="red">
      <corner name="_ON1"/><corner name="_ON2"/><corner name="_ON3"/><corner name="_ON4"/>
    </sector>
  </sectors>

  <variables>
    <variable init="45." var="orbit_height" min="30." max="70." step="1."/>
    <variable init="30." var="orbit_floor" min="25." max="60." step="1."/>
    <!-- Listening arcs before EARcam is asked for the result (8 = about 150 s). -->
    <variable init="8" type="uint8_t" var="orbit_arcs" min="1" max="20" step="1"/>
    <!-- Throttle on the listening arcs: propeller slow, not stopped. -->
    <variable init="0.05" var="listen_throttle" min="0.03" max="0.10" step="0.01"/>

    <variable init="15." var="approach_height" min="8." max="25." step="0.5"/>
    <variable init="50." var="level_distance" min="20." max="120." step="5."/>

    <variable init="0" type="bool" var="sound_detected"/>
    <variable init="0" type="uint8_t" var="drop_approaches"/>
    <!-- TRUE once Drop_Approach has placed _CLIMBOUT/_EXIT; before that a go-around climbs over SEARCH_CENTER. -->
    <variable init="0" type="bool" var="drop_laid_out"/>
  </variables>

  <exceptions>
    <!-- Low inside a tree sector: climb away. Only in this plan's own blocks (Start_Mission4_Orbit
         to Drop_Decide), so never during the main plan's landing, and not in the go-around/exit themselves. -->
    <exception cond="orbit_drop_obstacle(GetPosX(), GetPosY()) @AND (ORBIT_DROP_ESCAPE_HEIGHT_M @GT GetPosHeight()) @AND (nav_block @GEQ IndexOfBlock('Start_Mission4_Orbit')) @AND (IndexOfBlock('Drop_Decide') @GEQ nav_block) @AND !(nav_block == IndexOfBlock('Drop_Go_Around')) @AND !(nav_block == IndexOfBlock('Drop_Exit')) @AND !(nav_block == IndexOfBlock('Climb_Over_Search'))" deroute="Drop_Go_Around"/>
    <!-- Always false: runs the listening and EARcam safety nets every cycle, so the deroute is never taken. -->
    <exception cond="quiet_listen_guard()" deroute="Land_AF_TD"/>
  </exceptions>

  <blocks>
    <!-- TAKEOFF_POINT is snapped to the launch spot (plane still in hand), then the
         climb holds the fixed line TAKEOFF_POINT -> CLIMB. -->
    <block key="t" name="Takeoff Mission4" strip_button="Takeoff M4" strip_icon="takeoff.png" group="home">
      <exception cond="GetPosAlt() @GT GetAltRef() + 25" deroute="Start_Mission4_Orbit"/>
      <call_once fun="NavSetWaypointHere(WP_TAKEOFF_POINT)"/>
      <set value="0" var="autopilot.kill_throttle"/>
      <set value="1" var="autopilot.launch"/>
      <set value="0" var="autopilot.flight_time"/>
      <go from="TAKEOFF_POINT" hmode="route" wp="CLIMB" throttle="1.0" vmode="throttle" pitch="15" until="GetPosAlt() @GT GetAltRef() + 25"/>
      <deroute block="Start_Mission4_Orbit"/>
    </block>

    <block name="Start_Mission4_Orbit" strip_button="Start Mission4 Orbit" strip_icon="survey.png" group="home">
      <set var="sound_detected" value="FALSE"/>
      <set var="drop_approaches" value="0"/>
      <set var="drop_laid_out" value="FALSE"/>
      <deroute block="Climb_to_Orbit_Height"/>
    </block>

    <block name="Climb_to_Orbit_Height" group="mission">
      <set var="v_ctl_auto_throttle_nominal_cruise_throttle" value="ORBIT_SEARCH_CRUISE_THR"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="ORBIT_SEARCH_AIRSPEED"/>
      <exception cond="GetPosAlt() @GT GetAltRef() + orbit_height - 2.0" deroute="Orbit_Begin"/>
      <circle climb="2.0" radius="DEFAULT_CIRCLE_RADIUS" vmode="climb" wp="SEARCH_CENTER"/>
    </block>

    <block name="Orbit_Begin" group="mission">
      <call_once fun="orbit_drop_hatch_close()"/>
      <call_once fun="DownlinkSendWpNr(WP_TRUE_SOUND_SOURCE)"/>
      <call_once fun="orbit_search_reset(WP_SEARCH_CENTER, WP_DROP_POINT)"/>
      <!-- EARcam samples only on the listening arcs (earcam_listen), after earcam_quiet_delay_s -->
      <set var="earcam_quiet_only" value="FALSE"/>
      <set var="earcam_listen" value="FALSE"/>
      <call_once fun="earcam_start()"/>
      <deroute block="Orbit_Search"/>
    </block>

    <block name="Orbit_Search" group="mission" pre_call="orbit_search_update(orbit_arcs, orbit_height, orbit_floor, listen_throttle)">
      <exception cond="sound_detected" deroute="Drop_Setup"/>
      <exception cond="orbit_search_done" deroute="Orbit_Finish"/>
      <circle radius="ORBIT_SEARCH_RADIUS" vmode="alt" alt="orbit_search_alt(orbit_height, orbit_floor)" wp="SEARCH_CENTER"/>
    </block>

    <!-- Final EARcam result: MORA fuses all samples. Block exceptions are evaluated
         before the block body, so a block that requests the result must not test the
         reply flag itself: request here, wait in the next block. -->
    <block name="Orbit_Finish" group="mission">
      <set var="earcam_result_fresh" value="FALSE"/>
      <call_once fun="quiet_listen_session_stop()"/>
      <deroute block="Orbit_Wait"/>
    </block>

    <block name="Orbit_Wait" group="mission">
      <exception cond="earcam_result_fresh" deroute="Orbit_Decide"/>
      <exception cond="NavBlockTime() @GT 5" deroute="Orbit_Decide"/>
      <circle radius="ORBIT_SEARCH_RADIUS" vmode="alt" alt="GetAltRef() + orbit_height" wp="SEARCH_CENTER"/>
    </block>

    <!-- EARcam gave a result: DROP_POINT = the loudest spot, moved into the 25 m circle
         round SEARCH_CENTER if it lies outside (the nearest circle point, which is also the
         loudest point inside it), then the drop. No result at all: nothing to drop on, land. -->
    <block name="Orbit_Decide" group="mission">
      <exception cond="!earcam_result_valid" deroute="Land_AF_TD"/>
      <exception cond="earcam_result_to_waypoint_in_circle(WP_DROP_POINT, WP_SEARCH_CENTER, 25)" deroute="Land_AF_TD"/>
      <call_once fun="DownlinkSendWpNr(WP_DROP_POINT)"/>
      <set var="sound_detected" value="TRUE"/>
      <deroute block="Drop_Setup"/>
    </block>

    <block name="Start_Drop_Mission4" strip_button="Start Drop Mission4" strip_icon="down.png" group="mission">
      <deroute block="Drop_Setup"/>
    </block>


    <!-- Run-in lane (EARcam): START ORBIT_DROP_RUN_IN_M before DROP_POINT on the lane course,
         tilted up to ORBIT_DROP_LANE_MAX_TILT_DEG while a corridor ORBIT_DROP_LANE_MARGIN_M either side is
         clear of the tree sectors and inside the fence; ties go towards the wind. -->
    <block name="Drop_Setup" group="mission">
      <set var="drop_approaches" value="drop_approaches + 1"/>
      <set var="v_ctl_auto_throttle_nominal_cruise_throttle" value="0.16"/>
      <call_once fun="orbit_drop_hatch_close()"/>
      <call_once fun="earcam_place_run_in_lane(WP_START, WP_DROP_POINT, ORBIT_DROP_RUN_IN_M, ORBIT_DROP_CLIMBOUT_MAX_M, ORBIT_DROP_LANE_MARGIN_M, ORBIT_DROP_LANE_COURSE_DEG, ORBIT_DROP_LANE_MAX_TILT_DEG, ORBIT_DROP_LANE_TILT_STEP_DEG, wind_circle_upwind_course(), orbit_drop_obstacle)"/>
      <deroute block="Drop_Approach"/>
    </block>

    <!-- Separate block: exceptions are tested before the body, so the corridor verdict
         of Drop_Setup can only be acted on here. nav_drop lays out RELEASE and the base
         turn, EARcam the fence-limited climb-out and the level-off point. -->
    <block name="Drop_Approach" group="mission">
      <exception cond="!earcam_run_in_clear" deroute="Drop_No_Corridor"/>
      <call_once fun="nav_move_waypoint_enu(WP_START, WaypointX(WP_START), WaypointY(WP_START), WaypointAlt(WP_DROP_POINT) + approach_height)"/>
      <call_once fun="nav_drop_compute_approach(WP_DROP_POINT, WP_START, WP__DROPTURN, WP__CLIMBOUT, ORBIT_DROP_DROPTURN_SIDE * fabsf(nav_radius))"/>
      <call_once fun="earcam_place_climbout(WP_START, WP_DROP_POINT, WP__CLIMBOUT, WP__EXIT, ORBIT_DROP_CLIMBOUT_MAX_M, ORBIT_DROP_CLIMBOUT_MIN_M, ORBIT_DROP_EXIT_TURN_RADIUS_M, ORBIT_DROP_FENCE_MARGIN_M, ORBIT_DROP_DROPTURN_SIDE, WaypointAlt(WP_DROP_POINT) + ORBIT_DROP_SAFE_HEIGHT_M, orbit_drop_outside_fence)"/>
      <call_once fun="earcam_drop_level_point(WP_START, WP_RELEASE, WP_DROP_POINT, WP__LEVEL, level_distance)"/>
      <set var="drop_laid_out" value="TRUE"/>
      <call_once fun="DownlinkSendWpNr(WP_START)"/>
      <call_once fun="DownlinkSendWpNr(WP__CLIMBOUT)"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="12."/>
      <circle radius="ORBIT_DROP_DROPTURN_SIDE * fabsf(nav_radius)" until="NavQdrCloseTo(DegOfRad(nav_drop_start_qdr)-15) @AND (5 @GT fabsf(GetPosAlt() - WaypointAlt(WP_START)))" wp="_DROPTURN"/>
      <deroute block="Drop_Glide"/>
    </block>

    <!-- Glide START to _LEVEL; RELEASE is re-computed every cycle (nav_drop returns true
         only on an internal error). Rangefinder too low: go around. -->
    <block name="Drop_Glide" group="mission">
      <exception cond="earcam_drop_too_low(WP_DROP_POINT)" deroute="Drop_Go_Around"/>
      <exception cond="nav_drop_update_release(WP_DROP_POINT)" deroute="Land_AF_TD"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="10."/>
      <go approaching_time="1" from="START" hmode="route" vmode="glide" wp="_LEVEL"/>
      <deroute block="Drop_Final"/>
    </block>

    <!-- Level on the rangefinder (earcam_drop_altitude). Crossing RELEASE: earcam_drop_shoot
         opens the hatch through nav_drop_shoot() only at or below earcam_drop_max_agl_m (2 m);
         too high, the go finishes and it is a miss. -->
    <block name="Drop_Final" group="mission">
      <exception cond="earcam_drop_too_low(WP_DROP_POINT)" deroute="Drop_Go_Around"/>
      <exception cond="nav_drop_update_release(WP_DROP_POINT)" deroute="Land_AF_TD"/>
      <exception cond="NavApproachingFrom(WP_RELEASE, WP__LEVEL, 0) @AND (earcam_drop_shoot(WP_DROP_POINT) == 0)" deroute="Drop_Release"/>
      <go approaching_time="0" from="_LEVEL" hmode="route" wp="RELEASE" vmode="alt" alt="earcam_drop_altitude(WP_DROP_POINT)"/>
      <deroute block="Drop_Missed"/>
    </block>

    <block name="Drop_Release" group="mission">
      <call_once fun="earcam_drop_mark_impact(WP_DROP_POINT, WP_RELEASE, WP__IMPACT)"/>
      <call_once fun="DownlinkSendWpNr(WP__IMPACT)"/>
      <call_once fun="DownlinkSendWpNr(WP_RELEASE)"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="ORBIT_DROP_CLIMBOUT_AIRSPEED_MPS"/>
      <set var="v_ctl_max_climb" value="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <go approaching_time="0" from="RELEASE" hmode="route" wp="_CLIMBOUT" vmode="climb" climb="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <deroute block="Drop_Exit"/>
    </block>

    <block name="Drop_Missed" group="mission">
      <set var="v_ctl_auto_airspeed_setpoint" value="ORBIT_DROP_CLIMBOUT_AIRSPEED_MPS"/>
      <set var="v_ctl_max_climb" value="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <go approaching_time="0" from="RELEASE" hmode="route" wp="_CLIMBOUT" vmode="climb" climb="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <deroute block="Drop_Exit"/>
    </block>

    <block name="Drop_Go_Around" group="mission">
      <exception cond="!drop_laid_out" deroute="Climb_Over_Search"/>
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <set var="v_ctl_auto_throttle_nominal_cruise_throttle" value="0.16"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="ORBIT_DROP_CLIMBOUT_AIRSPEED_MPS"/>
      <set var="v_ctl_max_climb" value="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <go approaching_time="0" wp="_CLIMBOUT" vmode="climb" climb="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <deroute block="Drop_Exit"/>
    </block>

    <!-- Go-around before the drop was laid out (_CLIMBOUT still unset): motor on, climb
         over SEARCH_CENTER to the safe height, then land. -->
    <block name="Climb_Over_Search" group="mission">
      <call_once fun="autopilot_set_kill_throttle(false)"/>
      <set var="v_ctl_auto_throttle_nominal_cruise_throttle" value="0.16"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="ORBIT_DROP_CLIMBOUT_AIRSPEED_MPS"/>
      <set var="v_ctl_max_climb" value="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <circle radius="DEFAULT_CIRCLE_RADIUS" until="GetPosHeight() @GT ORBIT_DROP_SAFE_HEIGHT_M - 5" vmode="climb" climb="ORBIT_DROP_CLIMBOUT_RATE_MPS" wp="SEARCH_CENTER"/>
      <set var="v_ctl_max_climb" value="V_CTL_ALTITUDE_MAX_CLIMB"/>
      <deroute block="Land_AF_TD"/>
    </block>

    <block name="Drop_Exit" group="mission">
      <call_once fun="orbit_drop_hatch_close()"/>
      <set var="v_ctl_max_climb" value="ORBIT_DROP_CLIMBOUT_RATE_MPS"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="ORBIT_DROP_CLIMBOUT_AIRSPEED_MPS"/>
      <circle radius="ORBIT_DROP_DROPTURN_SIDE * ORBIT_DROP_EXIT_TURN_RADIUS_M"
              until="GetPosHeight() @GT ORBIT_DROP_SAFE_HEIGHT_M - 5" vmode="climb" climb="ORBIT_DROP_CLIMBOUT_RATE_MPS" wp="_EXIT"/>
      <set var="v_ctl_max_climb" value="V_CTL_ALTITUDE_MAX_CLIMB"/>
      <deroute block="Drop_Decide"/>
    </block>

    <block name="Drop_No_Corridor" group="mission">
      <set var="v_ctl_auto_throttle_nominal_cruise_throttle" value="0.16"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="12."/>
      <exception cond="NavCircleCount() @GT 1.0" deroute="Land_AF_TD"/>
      <circle radius="DEFAULT_CIRCLE_RADIUS" vmode="alt" alt="GetAltRef()+ORBIT_DROP_SAFE_HEIGHT_M" wp="SEARCH_CENTER"/>
    </block>

    <block name="Drop_Decide" group="mission">
      <exception cond="earcam_drop_released" deroute="Land_AF_TD"/>
      <deroute block="Land_AF_TD"/>
    </block>
  </blocks>
</procedure>
