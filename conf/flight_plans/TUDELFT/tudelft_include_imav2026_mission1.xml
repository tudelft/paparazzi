<!DOCTYPE procedure SYSTEM "../flight_plan.dtd">
<!--
  IMAV 2026 Mission 1 (Strasbourg) - single-aircraft 2D mapping of BOTH areas.
  Included from tudelft_imav2026_strasbourg.xml:

    <include name="Mission" procedure="tudelft_include_imav2026_mission1.xml"/>

  All block names get the include name as prefix (e.g. "Mission.Takeoff");
  deroutes and IndexOfBlock() inside this file are prefixed automatically.

  ONE Talon flies both areas, back to back, west to east:

    Takeoff -> Survey Area 1 (_MA1.._MA4) -> Survey Area 2 (_MX1.._MX4) -> land at TD.

  The area corners, the Geofence sector and HOME come from the main plan.
  The geofence is the main plan's built-in geofence_sector (HOME mode when
  outside), so there is no geofence exception here.

  SURVEY: stock nav_survey_poly_osam module, back-and-forth (lawnmower)
  lines mapping_sweep metres apart, parallel to the edge from the first
  corner towards the given second corner (setup_towards). U-turn radius is
  half a sweep, at least POLY_OSAM_MIN_RADIUS (30 m in the Talon airframe,
  ~19 deg bank at 10 m/s). The survey altitude is the first corner's
  altitude, set in the setup block. An area is done when the module starts
  to sweep back (PolySurveySweepBackNum > 0). Setup and run are separate
  blocks because a block's exceptions are checked before its first stage,
  so Area 1's sweep-back count would bounce straight out of Area 2 before
  its setup.

  CAMERA: distance-triggered every mapping_shot_interval metres, only while
  the aircraft is inside the area being surveyed (the main plan's
  Mapping_area_1 / Mapping_area_2 sectors). The setup block arms the
  camera and disarms it; the run block's pre_call switches dc_autoshoot on
  inside the sector and off outside it. No shots on the transit or on the
  part of each U-turn outside the area; the part of a U-turn that is still
  inside the edge is photographed.

  CAMERA: Raspberry Pi AI Camera over digital_cam_uart, 66 deg axis across
  the wings. Line spacing = (1 - sidelap) * 2 * height * tan(33 deg):
  0.7 * 2 * 60 * 0.649 = 54.5 m at 60 m AGL with 30 % sidelap.

  PER-AREA PHOTO TAG: Area 1 photos 1001..1999, Area 2 photos 2001..2999
  (dc_photo_nr is the number of the LAST shot and is incremented before
  sending, so setting it to 1000 makes the first frame 1001).
-->
<procedure>
  <header>
#include "autopilot.h"
#include "firmwares/fixedwing/guidance/energy_ctrl.h"
#include "modules/digital_cam/dc.h"
#include "modules/digital_cam/uart_cam_ctrl.h"
#include "modules/nav/nav_survey_poly_osam.h"
  </header>


  <variables>
    <!-- Survey height above ground, m. -->
    <variable init="60." var="mapping_height" min="10." max="120." step="1."/>
    <!-- Survey airspeed, m/s. The Talon 250g cannot hold 12 m/s and climb. -->
    <variable init="10." var="mapping_airspeed" min="8." max="16." step="0.5"/>
    <!-- Distance between survey lines, m (54 m = 30 % sidelap at 60 m AGL).
         Read when an area's survey is set up. -->
    <variable init="54." var="mapping_sweep" min="10." max="150." step="1."/>
    <!-- Metres of ground track between shots. 9 m: ~85 % forward overlap at
         60 m (59 m along-track footprint). -->
    <variable init="9." var="mapping_shot_interval" min="2." max="50." step="1."/>
    <variable init="5." var="holding_delay" min="0." max="60." step="1."/>
  </variables>

  <blocks>
    
    <!-- Bench check of the FC -> CATIA -> rpicam-still chain: one AI camera
         shot per click, then hold. Expect a new /home/air/Pictures/aNNNNNN.jpg
         on MORA. Not part of the mission sequence. -->
    <block name="Test_AIcam_Shot" strip_button="Test AIcam shot" strip_icon="survey.png" group="mission">
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_AICAM)"/>
      <call_once fun="dc_send_command(DC_SHOOT)"/>
      <!-- Hold with the motor killed; do not return to Holding_point, whose
           timeout deroutes to Takeoff. -->
      <set value="1" var="autopilot.kill_throttle"/>
      <attitude roll="0" throttle="0" vmode="throttle" until="FALSE"/>
    </block>

    <!-- ── Launch ───────────────────────────────────────────────────────── -->
    <block key="t" name="Takeoff Mission1" strip_button="Takeoff M1" strip_icon="takeoff.png" group="home">
      <exception cond="GetPosAlt() @GT GetAltRef() + 25" deroute="Survey_Area1_Left"/>
      <set value="0" var="autopilot.kill_throttle"/>
      <set value="1" var="autopilot.launch"/>
      <set value="0" var="autopilot.flight_time"/>
      <attitude roll="0" throttle="0.99" pitch="25" vmode="throttle" until="GetPosAlt() @GT GetAltRef() + 25"/>
      <deroute block="Survey_Area1_Left"/>
    </block>

    <!-- ── Area 1: Left (_MA1.._MA4), photos 1001.. ─────────────────────── -->
    <!-- Lines parallel to the west edge _MA1 (SW) -> _MA2 (NW). -->
    <block name="Survey_Area1_Left" strip_button="Map Area 1 (Left)" strip_icon="survey.png" group="mission">
      <set var="v_ctl_auto_airspeed_setpoint" value="mapping_airspeed"/>
      <set var="waypoints[WP__MA1].a" value="GetAltRef() + mapping_height"/>
      <call_once fun="nav_survey_poly_osam_setup_towards(WP__MA1, 4, mapping_sweep, WP__MA2)"/>
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_AICAM)"/>
      <set var="dc_photo_nr" value="1000"/>
      <call_once fun="dc_distance(mapping_shot_interval)"/>
      <!-- Disarm: Run_Area1's pre_call switches it on inside the area. -->
      <set var="dc_autoshoot" value="DC_AUTOSHOOT_STOP"/>
      <deroute block="Run_Area1"/>
    </block>
    <block name="Run_Area1" group="mission" pre_call="dc_autoshoot = (InsideMapping_area_1(GetPosX(), GetPosY()) && GetPosAlt() > GetAltRef() + mapping_height - 5 ? DC_AUTOSHOOT_DISTANCE : DC_AUTOSHOOT_STOP)">
      <exception cond="PolySurveySweepBackNum @GT 0" deroute="Survey_Area2_Right"/>
      <call fun="nav_survey_poly_osam_run()"/>
    </block>

    <!-- ── Area 2: Right (_MX1.._MX4), photos 2001.. ────────────────────── -->
    <!-- Lines parallel to the shared edge _MX1 (SW) -> _MX2 (NW). -->
    <block name="Survey_Area2_Right" strip_button="Map Area 2 (Right)" strip_icon="survey.png" group="mission">
      <call_once fun="dc_stop()"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="mapping_airspeed"/>
      <set var="waypoints[WP__MX1].a" value="GetAltRef() + mapping_height"/>
      <call_once fun="nav_survey_poly_osam_setup_towards(WP__MX1, 4, mapping_sweep, WP__MX2)"/>
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_AICAM)"/>
      <set var="dc_photo_nr" value="2000"/>
      <call_once fun="dc_distance(mapping_shot_interval)"/>
      <!-- Disarm: Run_Area2's pre_call switches it on inside the area. -->
      <set var="dc_autoshoot" value="DC_AUTOSHOOT_STOP"/>
      <deroute block="Run_Area2"/>
    </block>
    <block name="Run_Area2" group="mission" pre_call="dc_autoshoot = (InsideMapping_area_2(GetPosX(), GetPosY()) && GetPosAlt() > GetAltRef() + mapping_height - 5 ? DC_AUTOSHOOT_DISTANCE : DC_AUTOSHOOT_STOP)">
      <exception cond="PolySurveySweepBackNum @GT 0" deroute="Mapping_Done"/>
      <call fun="nav_survey_poly_osam_run()"/>
    </block>

    <block name="Mapping_Done" group="mission">
      <call_once fun="dc_stop()"/>
     <deroute block="Common.Land_AF_TD"/>
    </block>


    <!-- ── Safety hold / abort ──────────────────────────────────────────── -->
    <!-- Resume with the "Map Area 1/2" strip buttons - re-entering an area
         restarts its survey AND its photo numbering from x001. -->
    <!-- <block key="Ctrl+a" name="Standby" strip_button="Standby" strip_icon="home.png" group="home">
      <call_once fun="dc_stop()"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="mapping_airspeed"/>
      <circle radius="DEFAULT_CIRCLE_RADIUS" vmode="alt" alt="GetAltRef()+mapping_height" wp="STDBY"/>
    </block> -->

   
  </blocks>
</procedure>
