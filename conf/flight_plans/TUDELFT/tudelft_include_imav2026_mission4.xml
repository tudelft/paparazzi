/* Obstacles at the site (see the header comment). The sectors below generate the
   Inside* tests further down in this file; they are declared here so the blocks can
   use one combined test. Coordinates are flight plan x/y (m east/north of HOME). */
#ifndef FBW
static inline bool InsideM4_OW(float _x, float _y);
static inline bool InsideM4_OE(float _x, float _y);
static inline bool InsideM4_ON(float _x, float _y);
static inline bool InsideM4_FENCE(float _x, float _y);
/* Trees, or outside the geofence: both are places the run-in corridor may not touch. */
static bool m4_obstacle(float x, float y) __attribute__((unused));
static bool m4_obstacle(float x, float y)
{
  return InsideM4_OW(x, y) || InsideM4_OE(x, y) || InsideM4_ON(x, y) || !InsideM4_FENCE(x, y);
}
static bool m4_outside_fence(float x, float y) __attribute__((unused));
static bool m4_outside_fence(float x, float y)
{
  return !InsideM4_FENCE(x, y);
}
#endif
/* Run-in lane: course flown over the target (deg, from north), max tilt tried, corridor
   half width kept clear of the sectors, and the side (+1 right) of the base turn circle. */
#define M4_LANE_COURSE_DEG 0.f
#define M4_RUN_IN_M 300.f
#define M4_LANE_MAX_TILT_DEG 20.f
#define M4_LANE_MARGIN_M 8.f
#define M4_DROPTURN_SIDE 1.f
/* Climb-out: straight ahead at most this far past the target, then the exit circle. */
#define M4_CLIMBOUT_MAX_M 120.f
#define M4_CLIMBOUT_MIN_M 40.f
#define M4_CLIMBOUT_RATE_MPS 3.0f
#define M4_CLIMBOUT_AIRSPEED_MPS 11.f
#define M4_EXIT_TURN_RADIUS_M 30.f
/* The exit circle stays this far inside the geofence: NPS showed 12 m turn-entry overshoot
   at 12 m/s plus tailwind, GPS error and the fence's own accuracy come on top. */
#define M4_FENCE_MARGIN_M 40.f
/* Above this height (m above ground_alt) nothing at the site can be hit. */
#define M4_SAFE_HEIGHT_M 45.f
/* Aircraft below this height inside an obstacle sector = emergency climb. */
#define M4_ESCAPE_HEIGHT_M 25.f
