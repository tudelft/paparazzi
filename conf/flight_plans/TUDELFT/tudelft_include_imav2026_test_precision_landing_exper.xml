<procedure>
  <header>
#include "modules/datalink/datalink.h"
#include "modules/digital_cam/uart_cam_ctrl.h"
#include "modules/sonar/agl_dist.h"
  </header>

  <!-- Waypoint Definitions (ENU coordinates in meters relative to lat0/lon0 reference) -->
  <waypoints>
    <waypoint name="HOME" x="0" y="0"/>
    <waypoint name="STDBY" x="49.5" y="100.1"/>
    <waypoint name="WAIT360" x="60.0" y="90.0"/>
    <waypoint name="1" x="10.1" y="189.9"/>
    <waypoint name="2" x="132.3" y="139.1"/>
    <waypoint name="MOB" x="137.0" y="-11.6"/>
    <waypoint name="S1" x="-119.2" y="69.6"/>
    <waypoint name="S2" x="274.4" y="209.5"/>
    <waypoint name="_BASELEG" x="168.8" y="-13.8"/>
    <waypoint name="CLIMB" x="-114.5" y="162.3"/>
    <!-- Tanguy With MotionSCOUT acoustic target location -->
    <waypoint name="TANGUY" x="-54.0" y="62.0"/>
    <!-- Precision Landing Runway Waypoints -->
    <waypoint height="20.0" name="AF" x="-13.1" y="52.3"/> <!-- ~149m upstream on the sector centerline -->
    <waypoint height="0.0" name="TD" x="-22.0" y="201.0"/> <!-- Fixed-wing landing-sector center -->
  </waypoints>

  <!-- <exceptions>-->
    <!-- Global exceptions can be defined here -->
  <!--</exceptions> -->

  <blocks>
    <!-- Block 0: Wait for 3D GNSS lock before disarming disarm checks -->
    <block name="Wait GPS" on_enter="precision_landing_stop()">
      <set value="1" var="autopilot.kill_throttle"/>
      <while cond="!GpsFixValid()"/>
    </block>

    <!-- Preserve the surveyed origin and waypoint elevations. -->
    <block name="Geo init" on_enter="precision_landing_stop()">
      <while cond="LessThan(NavBlockTime(), 10)"/>
    </block>

    <!-- Block 2: Ground holding point (safety disarm) -->
    <block name="Holding point" on_enter="precision_landing_stop()">
      <call_once fun="precision_landing_stop()"/>
      <set value="1" var="autopilot.kill_throttle"/>
      <attitude roll="0" throttle="0" vmode="throttle"/>
    </block>

    <!-- Block 3: Pre-flight bench inspection for crow airbrakes -->
    <!-- <block name="Crow brake bench test" strip_button="Crow bench test" group="land" on_enter="precision_landing_bench_start()" on_exit="precision_landing_stop()">
      <exception cond="!precision_landing_bench_run()" deroute="Standby"/>
      <attitude pitch="0" roll="0" throttle="0" until="stage_time @GT 3" vmode="throttle"/>
      <deroute block="Holding point"/>
    </block> -->

    <!-- Block 4: Hand-launch Takeoff sequence -->
    <block key="t" name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png" group="home" on_enter="precision_landing_stop()">
      <exception cond="GetPosAlt() @GT GetAltRef()+25" deroute="Standby"/>
      <call_once fun="precision_landing_stop()"/>
      <set value="0" var="autopilot.kill_throttle"/>
      <set value="0" var="autopilot.flight_time"/>
      <attitude roll="0" throttle="1.0" vmode="throttle" pitch="DegOfRad(TAKEOFF_PITCH_ANGLE)" until="GetPosAlt() @GT GetAltRef()+25"/>
    </block>

    <!-- Block 5: Standby loiter circle -->
    <block key="Ctrl+a" name="Standby" strip_button="Standby" strip_icon="home.png" group="home" on_enter="precision_landing_stop()">
      <call_once fun="precision_landing_stop()"/>
      <set value="NOMINAL_AIRSPEED" var="v_ctl_auto_airspeed_setpoint"/>
      <set value="DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>

    <!-- Mission Pattern Blocks -->
    <!-- <block name="Oval 1-2" strip_button="Oval (wp 1-2)" strip_icon="oval.png" group="base_pattern" on_enter="precision_landing_stop()">
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_AICAM)"/>
      <call_once fun="dc_send_command(DC_SHOOT)"/>
      <set value="DC_AUTOSHOOT_PERIODIC" var="dc_autoshoot"/>
      <oval p1="1" p2="2" radius="nav_radius"/>
    </block>

    <block name="XOval 1-2" strip_button="XOval (wp 1-2)" strip_icon="lookdown.png" group="base_pattern" on_enter="precision_landing_stop()">
      <call_once fun="uart_cam_ctrl_set_camera_mask(CATIA_CAMERA_MASK_LWIR)"/>
      <call_once fun="dc_send_command(DC_SHOOT)"/>
      <set value="DC_AUTOSHOOT_PERIODIC" var="dc_autoshoot"/>
      <oval p1="1" p2="2" radius="nav_radius"/>
    </block> -->

    <!-- <block name="Survey S1-S2" strip_button="Survey (wp S1-S2)" strip_icon="survey.png" group="extra_pattern" on_enter="precision_landing_stop()">
      <survey_rectangle grid="150" wp1="S1" wp2="S2"/>
    </block> -->

    <!-- Landing Entry Blocks: Initiate landing sequence with Right or Left baseleg pattern -->
    <block name="Land Right AF-TD" strip_button="Land right (wp AF-TD)" strip_icon="land-right.png" group="land" on_enter="precision_landing_start()">
      <exception cond="!precision_landing_parameters_valid() @OR !precision_landing_entry_valid(WP_AF, WP_TD, DEFAULT_CIRCLE_RADIUS)" deroute="Standby"/>
      <call_once fun="precision_landing_reset_retries()"/>
      <set value="WaypointAlt(WP_TD) + precision_landing_final_height" var="WaypointAlt(WP_AF)"/>
      <set value="DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <block name="Land Left AF-TD" strip_button="Land left (wp AF-TD)" strip_icon="land-left.png" group="land" on_enter="precision_landing_start()">
      <exception cond="!precision_landing_parameters_valid() @OR !precision_landing_entry_valid(WP_AF, WP_TD, DEFAULT_CIRCLE_RADIUS)" deroute="Standby"/>
      <call_once fun="precision_landing_reset_retries()"/>
      <set value="WaypointAlt(WP_TD) + precision_landing_final_height" var="WaypointAlt(WP_AF)"/>
      <set value="-DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <!-- Baseleg Navigation & Runway Alignment -->
    <block name="land">
      <exception cond="!precision_landing_is_active()" deroute="Standby"/>
      <exception cond="!precision_landing_parameters_valid() @OR !precision_landing_entry_valid(WP_AF, WP_TD, nav_radius)" deroute="Standby"/>
      <exception cond="NavBlockTime() @GT 90" deroute="Standby"/>
      <set value="precision_landing_approach_airspeed" var="v_ctl_auto_airspeed_setpoint"/>
      <call_once fun="nav_compute_baseleg(WP_AF, WP_TD, WP__BASELEG, nav_radius)"/>
      <circle radius="nav_radius" until="NavCircleCount() @GT 0.5" wp="_BASELEG"/>
      <circle climb="-0.8" radius="nav_radius" until="2 @GT fabs(GetPosAlt() - WaypointAlt(WP__BASELEG))" vmode="climb" wp="_BASELEG"/>
      <circle radius="nav_radius" until="NavQdrCloseTo(DegOfRad(baseleg_out_qdr)-(nav_radius/fabs(nav_radius))*10)" wp="_BASELEG"/>
    </block>

    <!-- Block pre_call evaluates decisions before generated exceptions. -->
    <block name="final" on_enter="precision_landing_setup_zone(WP_AF, WP_TD, WP__PLFW1, WP__PLFW2, WP__PLFW3, WP__PLFW4)" pre_call="precision_landing_run()" on_exit="precision_landing_release()">
      <set value="precision_landing_approach_airspeed" var="v_ctl_auto_airspeed_setpoint"/>
      <!-- Commitment takes precedence over powered abort. -->
      <exception cond="precision_landing_cancelled" deroute="Standby"/>
      <exception cond="precision_landing_commit_flare" deroute="flare"/>
      <exception cond="precision_landing_abort @OR !precision_landing_parameters_valid()" deroute="go_around"/>
      <exception cond="precision_landing_agl_fresh @AND (precision_landing_flare_agl @GT agl_dist_value_filtered)" deroute="flare"/>
      <!-- Execute geometric glide slope along AF-to-TD route; pre_call runs prediction/braking, post_call updates glide slope altitude -->
      <go approaching_time="0" from="AF" hmode="route" vmode="glide" wp="TD" post_call="precision_landing_glide()"/>
      <deroute block="go_around"/>
    </block>

    <!-- Zero throttle is local to flare; global kill remains owned by the pilot/failsafes. -->
    <block name="flare" on_enter="precision_landing_flare_run()" pre_call="precision_landing_flare_run()" on_exit="precision_landing_stop()">
      <exception cond="precision_landing_cancelled" deroute="Standby"/>
      <while cond="TRUE"/>
    </block>

    <!-- Go-Around State: Straight climb-out on runway heading, retracts brakes, climbs to 25m AGL before re-entering baseleg -->
    <block name="go_around" on_enter="precision_landing_check_abort()" pre_call="precision_landing_check_abort()">
      <exception cond="precision_landing_cancelled" deroute="Standby"/>
      <exception cond="precision_landing_commit_flare" deroute="flare"/>
      <call_once fun="precision_landing_release()"/>
      <set value="NOMINAL_AIRSPEED" var="v_ctl_auto_airspeed_setpoint"/>
      <heading course="DegOfRad(atan2(WaypointX(WP_TD)-WaypointX(WP_AF), WaypointY(WP_TD)-WaypointY(WP_AF)))" pitch="DegOfRad(TAKEOFF_PITCH_ANGLE)" throttle="1.0" vmode="throttle" until="GetPosAlt() @GT GetAltRef()+25"/>
      <go from="TD" hmode="route" wp="AF" alt="GetAltRef()+25"/>
      <call_once fun="precision_landing_record_retry()"/>
      <deroute block="retry decision"/>
    </block>

    <!-- Retry Decision: default zero retries returns to Standby after the first safety abort. -->
    <block name="retry decision">
      <exception cond="!precision_landing_is_active()" deroute="Wait360"/>
      <exception cond="!precision_landing_parameters_valid()" deroute="Standby"/>
      <exception cond="precision_landing_retry_allowed()" deroute="land"/>
      <deroute block="Standby"/>
    </block>

    <block key="Ctrl+w" name="Wait360" on_enter="precision_landing_stop()">
      <call_once fun="precision_landing_stop()"/>
      <set value="NOMINAL_AIRSPEED" var="v_ctl_auto_airspeed_setpoint"/>
      <set value="DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <circle radius="nav_radius" wp="WAIT360"/>
    </block>

  </blocks>
</procedure>
