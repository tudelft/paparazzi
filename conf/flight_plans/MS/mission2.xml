  <variables>
    <!-- 50 m, raised from 40 m to widen the line spacing: fewer lines means
         fewer turns, and every turn here is a ~190 m omega loop. Swath 36.4 m,
         GSD 14.0 cm, so 2.2 px on a 0.3 m plate and 4.3 px on a 0.6 m one -
         under the usual 3 px rule for the small case, leaning on the
         near-saturated hot spot against cold vegetation (see the file
         header). Drop back to ~36-40 m if the hot spots are confirmed small.
         Line spacing and count follow automatically (survey_sidelap). -->
    <variable init="50." var="survey_height" min="25." max="80." step="1."/>

    <!-- MINIMUM sidelap between adjacent lines. Nothing to recompute by hand:
         the maximum line spacing is (1 - sidelap) * swath, with
         swath = 2 * survey_height * tan(HFOV/2), and Start Survey then picks
         the fewest lines that fit the zone at no more than that spacing
         (mission2_survey_along_longest_edge). The ACTUAL spacing is
         width / lines, so the real sidelap is this or more.

         At 50 m: swath 36.4 m, maximum spacing 27.3 m. The current zone is
         54.3 m wide, so 2 lines at 27.15 m - 9.3 m of overlap between them
         and 4.6 m of footprint past each long edge. A zone just 0.3 m wider
         becomes 3 lines at 18.2 m.

         Low sidelap ONLY HOLDS WITH THE LINES FLOWN ALONG THE WIND. The
         camera is bolted to the airframe, so crabbing into a crosswind
         rotates the footprint and the guaranteed strip becomes the inscribed
         width, w*cos(c) - h_along*sin(c), not the swath. At 12 m/s a 5 m/s
         crosswind is 24.6 deg of crab, which cuts the guaranteed strip at
         50 m from 36.4 m to 22.0 m - 27 m spacing would then leave 5 m
         gaps. Flying pure headwind/tailwind makes the crab zero on the legs;
         it only appears in the turns, where frames are discarded anyway.
         If the lines cannot be put along the wind, use 0.5 (18.2 m maximum
         spacing at 50 m).

         Turns: anything under 2 x POLY_OSAM_MIN_RADIUS (60 m) is flown as an
         omega turn outside the polygon, ~190 m of track each - which is why
         fewer, wider lines pay off. -->
    <variable init="0.25" var="survey_sidelap" min="0." max="0.8" step="0.05"/>

    <!-- Metres of ground track between shots. Sets forward overlap and,
         more importantly, how many times each hot spot is seen - which is
         what averages the random half of the error budget away.

         SCALES WITH ALTITUDE. At 50 m the along-track footprint is 26.8 m,
         so 3 m (3.4-3.6 m actual, see below) gives about 8 sightings per
         spot per pass and ~15 in the strip both lines see - 87% forward
         overlap.

         Far more than coverage needs (anything under 26.8 m covers), and
         more than accuracy needs (GPS bias dominates; 4 sightings is almost
         as good as 8). The overlap is for DETECTION: a real hot spot
         repeats in consecutive frames at one ground position while noise
         and glints do not, a ~2 px target gets several pixel alignments,
         and a 2 s FFC blank (~24 m of track) still leaves most points seen.
         Costs about 70 frames over the two lines - trivial.

         At 12 m/s, 3 m is 4 Hz. dc_periodic runs at 10 Hz (digital_cam_uart)
         so the interval quantises in ~1.2 m steps - fine here, but do not
         set this much below 2 m or the quantisation dominates. -->
    <variable init="3." var="survey_shot_interval" min="2." max="40." step="0.5"/>

    <!-- Survey airspeed. Time AND energy are both scored and they pull in
         opposite directions: minimum energy per unit distance is near best
         L/D (GLIDE_AIRSPEED, 7.5 m/s on this airframe), minimum time is as
         fast as the aircraft will go. 10 m/s is chosen as the balance (this
         repo's Talon 250g, NOMINAL_AIRSPEED 9.4, sinks when held at 12) and because motion smear and the sync error term both
         scale with it. Worth revisiting once the scoring weights are known. -->
    <variable init="10." var="survey_airspeed" min="8." max="16." step="0.5"/>

    <!-- Seconds held wings-level before the launch sequence starts. -->
    <variable init="5." var="holding_delay" min="0." max="60." step="1."/>

    <!-- Camera is inhibited above this bank angle, so frames come only from
         the straight legs. 10 deg comfortably excludes the survey turns
         (the Talon banks to ~46 deg in them) while letting a leg resume
         shooting as soon as it has rolled out.

         Raise it if legs start late and lose coverage at the polygon edge;
         lower it if turn frames still get through. Setting it very high
         defeats the gate; near zero will suppress legs flown with a small
         steady bank in wind. -->
    <!-- 5 deg, not 10. A gate only rejects turns TIGHTER than
         v^2/(g*tan(gate)): at 12 m/s that is 83 m radius at 10 deg but
         168 m at 5 deg. Shots were visibly landing on gentle curves near
         the polygon edge because an 83 m-radius roll-out passes a 10 deg
         gate. Do not push below about 3 deg (280 m) - a leg flown with a
         small steady bank correction in wind would start being suppressed. -->
    <!-- Unused now: roll no longer gates shots (see shoot function). -->
    <variable init="5." var="survey_max_roll" min="3." max="45." step="1."/>

    <!-- Seconds the camera gate looks ahead along the ground track: a shot
         is only allowed if the aircraft is inside the fire zone F1..F4 now
         AND will still be inside this much later. 0.1 s is two navigation
         periods - 1.2 m of track at 12 m/s, 1.7 m at 17 m/s downwind -
         covering the up-to-one-period lag between the gate and dc_periodic.
         Checked on six zone shapes: no shot outside, 100% coverage. -->
    <variable init="0.1" var="survey_gate_lookahead" min="0." max="1." step="0.05"/>

    <!-- How far the survey lines are extended PAST the fire zone at each
         end, so turns and roll-outs happen outside it. Costs 2*overrun per
         line and adds no lines.

         15 m: the survey turns now finish exactly on the next line, already
         heading along it, so the overrun only has to cover the settle onto
         the line - the old 30 m was sized for circle turns that handed over
         crooked.

         The omega turns reach ~72 m past the end of each line at 25.5 m
         spacing, so the furthest point of a turn is overrun + 72 m from the
         fire zone. On the Valkenburg stand-in zone the turn apexes clear
         the FZ1-FZ7 flyzone by 133 m. RE-CHECK THE FIT whenever F1..F4, survey_sidelap or this
         change. -->
    <variable init="15." var="survey_overrun" min="0." max="60." step="5."/>
  </variables>

  <exceptions>
    <!-- Buffered geofence, identical to mission4.xml: inside the FZ1-FZ7
         Valkenburg flyzone, or within MISSION4_GEOFENCE_BUFFER (60 m) outside
         it.

         Deliberately NOT geofence_sector, a hard autopilot fence on the raw
         polygon: HOME is ~31 m OUTSIDE this flyzone, so it would trip during
         the takeoff and the aircraft would orbit the launch point in HOME
         mode for the whole flight. The launch blocks are exempt below for
         the same reason. -->
    <exception cond="!mission4_in_valkenburg_safe(GetPosX(), GetPosY()) @AND !(nav_block == IndexOfBlock('Wait GPS')) @AND !(nav_block == IndexOfBlock('Geo init')) @AND !(nav_block == IndexOfBlock('Holding point')) @AND !(nav_block == IndexOfBlock('Takeoff'))" deroute="Standby"/>
  </exceptions>

  <blocks>
    <!-- ── Pre-flight ───────────────────────────────────────────────────── -->
    <block name="Wait GPS">
      <set value="1" var="autopilot.kill_throttle"/>
      <while cond="!GpsFixValid()"/>
    </block>

    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 10)"/>
      <call_once fun="NavSetGroundReferenceHere()"/>
    </block>

    <!-- Auto-sequences into Takeoff after a short settle, same as the other
         MS plans. The flight is TIMED, so the plan must not sit here waiting
         for a GCS click - and it also has to be able to run unattended in
         SITL. Raise holding_delay if the launch crew needs longer. -->
    <block name="Holding point">
      <set value="1" var="autopilot.kill_throttle"/>
      <exception cond="NavBlockTime() @GT holding_delay" deroute="Takeoff"/>
      <attitude roll="0" throttle="0" vmode="throttle" until="FALSE"/>
    </block>

    <!-- ── Launch ───────────────────────────────────────────────────────── -->
    <block key="t" name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png" group="home">
      <exception cond="GetPosAlt() @GT GetAltRef() + 25" deroute="Climb to Survey Height"/>
      <set value="0" var="autopilot.kill_throttle"/>
      <set value="1" var="autopilot.launch"/>
      <set value="0" var="autopilot.flight_time"/>
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <!-- vmode="climb" rather than a fixed pitch: on this airframe an
           open-loop attitude climb could not get past ~8 m AGL because
           excess thrust leaked into airspeed instead of altitude. See
           mission4_strasbourg.xml for the full telemetry account. -->
      <go climb="2.0" from="_HERE" hmode="route" vmode="climb" wp="CLIMB"/>
      <circle climb="2.0" radius="DEFAULT_CIRCLE_RADIUS" until="GetPosAlt() @GT GetAltRef()+25" vmode="climb" wp="CLIMB"/>
      <deroute block="Climb to Survey Height"/>
    </block>

    <!-- Climb EN ROUTE to the survey area, not by orbiting.

         Circling to altitude first was pure dead time: takeoff hands over at
         25 m, the survey runs at 80 m, and 55 m at 2 m/s is 27.5 s of
         orbiting that covers no ground and buys nothing. The transit to F1
         is about 200 m, which at 12 m/s is roughly the same 17 s - so the
         climb and the transit are the same manoeuvre and one of them is
         free. Time and energy are both scored; this is the cheapest second
         to save in the whole plan.

         The circle below is only a fallback for arriving low (headwind, or a
         survey height raised well above 80 m). In the normal case the
         exception fires during the go and the circle never runs. -->
    <block name="Climb to Survey Height" group="mission">
      <set var="v_ctl_auto_airspeed_setpoint" value="survey_airspeed"/>
      <exception cond="GetPosAlt() @GT GetAltRef() + survey_height - 2.0" deroute="Start Survey"/>
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <go climb="2.0" from="_HERE" hmode="route" vmode="climb" wp="F1"/>
      <circle climb="2.0" radius="DEFAULT_CIRCLE_RADIUS" vmode="climb" wp="F1"/>
    </block>

    <!-- ── Survey ───────────────────────────────────────────────────────── -->

    <!-- Lay out the lawnmower over F1..F4 and start the camera.

         _setup_towards(F1, 4, sweep, F2) rather than the fixed-angle
         _setup(): the orientation is then defined by two corners of the
         polygon itself, so it follows the zone automatically when the real
         coordinates replace the placeholders. mission1_strasbourg.xml uses
         the angle form with a magic -87.46, which has to be recomputed by
         hand every time its polygon moves. Point it at F4 instead if the
         real zone turns out to be wider than it is tall.

         The survey altitude is stamped onto F1 because
         nav_survey_poly_osam flies at the altitude of its first waypoint. -->
    <block name="Start Survey" strip_button="Start Survey" strip_icon="survey.png" group="mission">
      <set var="v_ctl_auto_airspeed_setpoint" value="survey_airspeed"/>
      <set var="WaypointAlt(WP_F1)" value="GetAltRef()+survey_height"/>
      <!-- No half-sweep line: the spacing is computed so the lines fit the
           zone exactly (see mission2_survey_along_longest_edge), so the last
           line already sits half a spacing from the far edge. A half line
           would only add an extra omega turn. -->
      <set var="Half_Sweep_Enabled" value="FALSE"/>
      <call_once fun="mission2_expand_along_sweep(WP_F1, 4, WP__G1, survey_overrun)"/>
      <call_once fun="mission2_survey_along_longest_edge(WP__G1, 4, (1. - survey_sidelap) * 2. * survey_height * MISSION2_TAN_HALF_HFOV)"/>
      <!-- dc_distance(), NOT dc_Survey(), despite the name.

           DC_AUTOSHOOT_SURVEY measures distance from a FIXED reference point
           captured when it starts, and fires on expanding concentric rings
           around it (dc.c: dist from dc_gps_x/y vs dc_gps_next_dist, which
           only ever increases). On a boustrophedon that is wrong: the
           distance from a fixed point grows on the outbound half of a line
           and shrinks on the way back, so the camera shoots on some legs and
           goes silent on others. Measured here before the change - 29 frames
           over 50 s of survey, unevenly spaced, where uniform 6 m spacing at
           12 m/s should give about 100.

           DC_AUTOSHOOT_DISTANCE measures from the LAST SHOT POSITION, which
           is true along-track spacing and is what a lawnmower needs. It is
           also wind-immune for the same reason: metres of ground track, not
           seconds, so overlap stays uniform when ground speed changes
           between the upwind and downwind legs.

           dc_periodic runs at 10 Hz (digital_cam_uart), so at 12 m/s the
           interval quantises in ~1.2 m steps - fine at 6 m, worth knowing if
           anyone sets it much lower.

           DC_SHOT is downlinked per frame by default (DC_SHOT_SYNC_SEND),
           carrying photo_nr, lat, lon, alt, phi, theta, psi and itow - the
           entire input the post-flight georeferencing needs. -->
      <call_once fun="dc_distance(survey_shot_interval)"/>
      <!-- dc_distance() leaves the camera ARMED with last_shot_pos at the
           origin, so the next dc_periodic would shoot at once - out here at
           the entry circle, before Run Survey's zone gate has run. Disarm it
           and let the gate open it inside the zone. The interval set above
           is kept. -->
      <set var="dc_autoshoot" value="DC_AUTOSHOOT_STOP"/>
      <deroute block="Run Survey"/>
    </block>

    <!-- pre_call runs every navigation cycle and gates the camera: shots
         only inside the fire zone F1..F4 (not the stretched _G1.._G4) and
         only with the wings near level. -->
    <block name="Run Survey" group="mission" pre_call="mission2_shoot_in_zone(survey_max_roll, WP_F1, 4, survey_gate_lookahead)">
      <!-- PolySurveySweepBackNum >= 1 means the pattern has covered the
           polygon and started back over ground it has already flown. -->
      <exception cond="PolySurveySweepBackNum @GT 0" deroute="Survey Done"/>
      <call fun="nav_survey_poly_osam_run()"/>
    </block>

    <!-- Camera off the moment coverage is complete: every extra frame is
         data to sift through in a five minute window. -->
    <block name="Survey Done" group="mission">
      <call_once fun="dc_stop()"/>
      <deroute block="Land AF-TD"/>
    </block>

    <!-- ── Safety hold ──────────────────────────────────────────────────── -->
    <!-- Where the geofence and any abort lands. Stops the camera too, so an
         aborted flight does not keep filling the buffer. -->
    <block key="Ctrl+a" name="Standby" strip_button="Standby" strip_icon="home.png" group="home">
      <call_once fun="dc_stop()"/>
      <set var="v_ctl_auto_airspeed_setpoint" value="survey_airspeed"/>
      <circle radius="DEFAULT_CIRCLE_RADIUS" vmode="alt" alt="GetAltRef()+survey_height" wp="_STDBY"/>
    </block>

    <!-- ── Landing ──────────────────────────────────────────────────────── -->
    <block name="Land AF-TD" strip_button="Land (wp AF-TD)" strip_icon="land-right.png" group="land">
      <call_once fun="dc_stop()"/>
      <set value="DEFAULT_CIRCLE_RADIUS" var="nav_radius"/>
      <deroute block="land"/>
    </block>

    <block name="land">
      <call_once fun="nav_compute_baseleg(WP_AF, WP_TD, WP__BASELEG, nav_radius)"/>
      <circle radius="nav_radius" until="NavCircleCount() @GT 0.5" wp="_BASELEG"/>
      <circle radius="nav_radius" until="NavQdrCloseTo(DegOfRad(baseleg_out_qdr)-(nav_radius/fabs(nav_radius))*10)                      @AND (fabs(GetPosAlt() - WaypointAlt(WP__BASELEG)) @LT 10)" wp="_BASELEG"/>
      <deroute block="final"/>
    </block>

    <block name="final">
      <!-- Glide AF -> TD; below 10 m AGL go to flare (motor killed).
           Plain go, no exceeding_time: with AF 200 m out it would carry the
           route ~300 m past TD, out of the flyzone. -->
      <exception cond="GetAltRef() + 10 @GT GetPosAlt()" deroute="flare"/>
      <go from="AF" hmode="route" vmode="glide" wp="TD"/>
    </block>

    <block name="flare">
      <set value="1" var="autopilot.kill_throttle"/>
      <go approaching_time="0" from="AF" hmode="route" throttle="0.0" vmode="throttle" wp="TD"/>
      <attitude roll="0.0" throttle="0.0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
