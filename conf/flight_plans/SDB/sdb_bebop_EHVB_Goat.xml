  <exceptions>
    <exception cond="(!InsideFlyzone(GetPosX(), GetPosY()) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>

    <exception cond="(!InsideSoftGeofence(GetPosX(), GetPosY()) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="Return Safe"/>

    <exception cond="((datalink_time @GT 5) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>

    <exception cond="((GetPosAlt() @GT 150.0) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>

    <exception cond="(electrical.bat_low @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
      
    <exception cond="(electrical.bat_critical @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
  </exceptions>

  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 10)"/>
      <call_once fun="NavSetAltitudeReferenceHere()"/>
    </block>
    
    <block name="Holding point">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    
    <block key="r" name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    
    <block key="t" name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png">
      <exception cond="GetPosAlt() @GT 2.0" deroute="Standby"/>
      <call_once fun="NavSetWaypointHere(WP_CLIMB)"/>
      <call_once fun="autopilot_set_in_flight(true)"/>
      <stay climb="nav.climb_vspeed" vmode="climb" wp="CLIMB"/>
    </block>
        
    <block key="s" name="Standby" strip_button="Standby" strip_icon="home.png">
      <call_once fun="guidance_h_SetMaxSpeed(8.0)"/>
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <stay wp="STDBY"/>
    </block>

    <block key="g" name="START" strip_button="Go Guided" strip_icon="lookfore.png">
      <call_once fun="setGuided()"/>
      <stay wp="STDBY"/>
    </block>
    
    <block name="STOP">
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <call_once fun="setNav()"/>
      <stay wp="STDBY"/>
    </block>

    <!-- <block name="Route Path" strip_button="Route Path" strip_icon="path.png">
      <call_once fun="setNav()"/>
      <go wp="p1"/>
      
      <go from="p1" hmode="route" wp="p2"/>
      <go from="p2" hmode="route" wp="p3"/>
      <go from="p3" hmode="route" wp="p4"/>
      <go from="p4" hmode="route" wp="p1"/>
      
      <deroute block="Route Path"/>
    </block> -->

    <block name="Route Path" strip_button="Route Path" strip_icon="path.png">
      <call_once fun="setNav()"/>
      
      <call_once fun="guidance_h_SetMaxSpeed(1.0)"/>

      <go wp="p1"/>
      
      <go from="p1" hmode="route" wp="p2"/>
      <go from="p2" hmode="route" wp="p3"/>
      <go from="p3" hmode="route" wp="p4"/>
      <go from="p4" hmode="route" wp="p1"/>
      
      <!-- <call_once fun="guidance_h_SetMaxSpeed(1.0)"/> -->
      
      <deroute block="Route Path"/>
    </block>

    <block name="Return Safe" strip_button="Return Safe" strip_icon="home.png">
      <call_once fun="guidance_h_SetMaxSpeed(8.0)"/>
      <call_once fun="setNav()"/>
      <stay wp="HOME"/>
    </block>
    
    <block key="l" name="land here" strip_button="Land Here" strip_icon="land-right.png">
      <call_once fun="setNav()"/>
      <call_once fun="NavSetWaypointHere(WP_TD)"/>
      <deroute block="Flare"/>
    </block>
    
    <block name="Land">
      <call_once fun="setNav()"/>
      <deroute block="Flare"/>
    </block>
    
    <block name="Flare">
      <!-- <exception cond="NavDetectGround()" deroute="Holding point"/> -->
      <exception cond="!nav_is_in_flight()" deroute="Landed"/>
      <exception cond="0.10 @GT GetPosAlt()" deroute="Landed"/>
      <!-- <call_once fun="NavStartDetectGround()"/> -->
      <stay climb="-0.8" vmode="climb" wp="TD"/>
    </block>
    
    <block name="Landed">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>