    <waypoint lat="52.1709731" lon="4.4187533" name="C9"/>

    <waypoint lat="52.1689778" lon="4.4120424" name="S1"/>
    <waypoint lat="52.1676834" lon="4.4128426" name="S2"/>
    <waypoint lat="52.1670734" lon="4.4131911" name="S3"/>
    <waypoint lat="52.1661943" lon="4.4137259" name="S4"/>
    <waypoint lat="52.1658967" lon="4.4147855" name="S5"/>
    <waypoint lat="52.1655207" lon="4.4159736" name="S6"/>
    <waypoint lat="52.1678818" lon="4.4205845" name="S7"/>
    <waypoint lat="52.1686448" lon="4.4200855" name="S8"/>
    <waypoint lat="52.1703410" lon="4.4180236" name="S9"/>
  </waypoints>

  <sectors>
    <sector color="red" name="Flyzone">
      <corner name="C1"/>
      <corner name="C2"/>
      <corner name="C3"/>
      <corner name="C4"/>
      <corner name="C5"/>
      <corner name="C6"/>
      <corner name="C7"/>
      <corner name="C8"/>
      <corner name="C9"/>
    </sector>
    <sector color="orange" name="SoftGeofence">
      <corner name="S1"/>
      <corner name="S2"/>
      <corner name="S3"/>
      <corner name="S4"/>
      <corner name="S5"/>
      <corner name="S6"/>
      <corner name="S7"/>
      <corner name="S8"/>
      <corner name="S9"/>
    </sector>
  </sectors>
