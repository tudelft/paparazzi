<!DOCTYPE flight_plan SYSTEM "flight_plan.dtd">

<flight_plan alt="50" ground_alt="0" lat0="52.168185" lon0="4.412758" max_dist_from_home="1500" name="FwdSweptValkenburg" security_height="25">
  <header>
#include "autopilot.h"
  </header>
  <waypoints>
    <waypoint name="HOME" x="0.0" y="0.0"/>
    <waypoint name="CLIMB" x="0.0" y="20" alt="20"/>
    <waypoint name="STDBY" x="106.0" y="-55.1" alt="30"/>
    <waypoint name="LAND1" x="106.0" y="-55.1" alt="4"/>  <!-- far in front of landing line -->
    <waypoint name="LAND2" x="106.0" y="-55.1" alt="4"/> <!-- behind landing line -->
    <waypoint name="p1" x="322.0" y="-254.3"/>
    <waypoint name="p2" x="696.0" y="-148.1"/>
    <waypoint name="p3" x="600.4" y="73.4"/>
    <waypoint name="p4" x="238.6" y="-48.5"/>
    <waypoint lat="52.169189" lon="4.410820" name="C1"/>
    <waypoint lat="52.168049" lon="4.406923" name="C2"/>
    <waypoint lat="52.166515" lon="4.408235" name="C3"/>
    <waypoint lat="52.163255" lon="4.407668" name="C4"/>
    <waypoint lat="52.161908" lon="4.410082" name="C5"/>
    <waypoint lat="52.162641" lon="4.416992" name="C6"/>
    <waypoint lat="52.164861" lon="4.427268" name="C7"/>
    <waypoint lat="52.170422" lon="4.427511" name="C8"/>
    <waypoint lat="52.172276" lon="4.424011" name="C9"/>
  </waypoints>
  <sectors>
    <sector color="red" name="Geofence">
      <corner name="C1"/>
      <corner name="C2"/>
      <corner name="C3"/>
      <corner name="C4"/>
      <corner name="C5"/>
      <corner name="C6"/>
      <corner name="C7"/>
      <corner name="C8"/>
      <corner name="C9"/>
    </sector>
  </sectors>
  <exceptions>
    <!-- Geofence violated, return home -->
<!--    <exception cond="!InsideGeofence(GetPosX(), GetPosY()), GetPosAlt() @GT GetAltRef() + 1500)"-->
<!--               deroute="ReturnHome"/>-->
    <!-- Datalink timeout → return -->
    <exception cond="datalink_time @GT 20"
               deroute="ReturnHome"/>
    <!-- RC lost → return -->
    <exception cond="radio_control.status == RC_REALLY_LOST"
               deroute="ReturnHome"/>
    <!-- Detect landing: low groundspeed -->
    <exception cond="(nav_block == IndexOfBlock('FinalApproach')) @AND
                     (flite.groundspeed @LT 1.0)"
               deroute="Landed"/>
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 10)"/>
      <call_once fun="NavSetGroundReferenceHere()"/>
      <!--<call_once fun="NavSetAltitudeReferenceHere()"/>-->
    </block>
    <block name="Holding point">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" vmode="throttle" until="FALSE"/>
    </block>
    <block name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" vmode="throttle" until="FALSE"/>
    </block>
    <block name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png">
      <exception cond="stateGetPositionEnu_f() @DEREF z @GT 2.0" deroute="Standby"/>
      <call_once fun="NavSetWaypointHere(WP_CLIMB)"/>
      <stay vmode="climb" climb="nav.climb_vspeed" wp="CLIMB"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <stay wp="STDBY"/>
    </block>
    <block name="stay_p1">
      <stay wp="p1"/>
    </block>
    <block name="go_p2">
      <call_once fun="nav_set_heading_deg(90)"/>
      <go wp="p2"/>
      <deroute block="stay_p1"/>
    </block>
    <block name="line_p1_p2">
      <go from="p1" hmode="route" wp="p2"/>
      <stay wp="p2" until="stage_time @GT 10"/>
      <go from="p2" hmode="route" wp="p1"/>
      <deroute block="stay_p1"/>
    </block>
    <block name="ReturnHome">
      <go wp="HOME"/>
      <circle wp="HOME" radius="80." alt="ground+50"/>
    </block>
    <block name="Oval">
      <oval p1="p1" p2="p2" radius="-1"/>
    </block>
    <block name="FinalApproach">
      <!-- Fly from WP1 to WP2 at 4 meters altitude -->
      <go wp="LAND1"/> <!-- insert here altitude hold vmode!!! -->
      <go wp="LAND2"/>
      <go from="LAND2" hmode="route" wp="STDBY"/>
      <deroute block="Standby"/>
    </block>
    <block name="Landed">
      <!-- All control surfaces neutral, throttle zero -->
      <attitude pitch="RadOfDeg(0)" roll="RadOfDeg(0)" throttle="0" vmode="throttle" until="FALSE"/>
    </block>
    <block name="FailsafeSpiralDown">
      <!-- Spiral down in place if this is reached. -->
      <set value="0.2" var="THROTTLE"/>           <!-- Low throttle -->
      <set value="RadOfDeg(-10)" var="PITCH"/>    <!-- Nose-down pitch -->
      <set value="RadOfDeg(30)" var="ROLL"/>      <!-- Bank right to spiral -->
    </block>
  </blocks>
</flight_plan>
