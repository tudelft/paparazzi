<?xml version="1.0"?>
<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="55" ground_alt="0" lat0="52.961947" lon0="4.792081" max_dist_from_home="1070" name="Rotating Wing Den Helder" security_height="2">
    <header>
      #include "autopilot.h"
      #include "modules/datalink/datalink.h"
      static inline bool delay_test_rc(bool test, int delay) {
        static int nb = 0;
          if (test) {
          nb++;
          if (nb == delay) {
            nb = 0;
            return true;
          }
          return false;
        } else {
          nb = 0;
          return false;
        }
      }
  </header>
