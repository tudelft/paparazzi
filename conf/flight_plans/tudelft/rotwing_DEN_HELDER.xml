      <call_once fun="rotwing_state_set(ROTWING_STATE_REQUEST_HOVER)"/>
      <stay alt="WaypointAlt(WP_APP)" pre_call="approach_moving_target_enable(WP_APP)" wp="APP"/>
    </block> -->
