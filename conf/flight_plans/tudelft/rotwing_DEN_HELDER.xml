    <!-- <block name="small_route" strip_button="Route" strip_icon="path.png">
      <call_once fun="rotwing_state_set(ROTWING_STATE_REQUEST_FW)"/>
      <go wp="p2"/>
      <go wp="p3"/>
      <go wp="p4"/>
      <go wp="p1"/>
      <deroute block="small_route"/>
