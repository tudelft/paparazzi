<!DOCTYPE module SYSTEM "module.dtd">

<module name="custom_detector" dir="computer_vision">
  <doc>
    <description>
      Detects orange and green obstacles from the camera image using OpenCV.
      The image is received in YUV422 format, converted to BGR, then to HSV,
      and thresholded in HSV.

      The module computes a risk score in three bottom image regions:
      left, center, and right.

      It publishes a CUSTOM_DETECTION ABI message with:
      left, middle, and right obstacle flags.
    </description>

    <define name="CUSTOM_DETECT_COLOR_OBJECT_CAMERA"
            value="front_camera|bottom_camera"
            description="Video device to use"/>

    <define name="CUSTOM_DETECT_COLOR_OBJECT_FPS"
            value="0"
            description="Desired FPS (0 = camera rate)"/>

    <define name="CUSTOM_DETECT_COLOR_OBJECT_ID"
            value="ABI_BROADCAST"
            description="Sender id for CUSTOM_DETECTION ABI message"/>
  </doc>
  <dep>
      <depends>video_thread</depends>
  </dep>
  <header>
    <file name="custom_detector.h"/>
  </header>

  <init fun="custom_detect_color_object_init()"/>
  <periodic fun="custom_detect_color_object_periodic()" freq="4"/>

  <makefile target="ap|nps">
    <file name="custom_detector.cpp"/>
    <flag name="CXXFLAGS" value="-std=c++11"/>
  </makefile>

  <makefile target="nps">
    <flag name="CXXFLAGS" value="I/usr/include/opencv4"/>
    <flag name="LDFLAGS" value="lopencv_core"/>
    <flag name="LDFLAGS" value="lopencv_imgproc"/>
    <flag name="LDFLAGS" value="lopencv_highgui"/>
    <flag name="LDFLAGS" value="lopencv_videoio"/>
    <flag name="LDFLAGS" value="lpthread"/>
  </makefile>

</module>