<!DOCTYPE module SYSTEM "module.dtd">

<module name="imu_parrot_minidrone" dir="imu" task="sensors">
  <doc>
    <description>
      Driver for IMU on the Parrot Minidrone like the Mambo or Swing.
      - Accelerometer/Gyroscope: MPU6000 via I2C0
    </description>
  </doc>
  <dep>
    <depends>i2c,imu_common</depends>
    <provides>imu</provides>
  </dep>
  <header>
    <file name="imu_parrot_minidrone.h"/>
  </header>
  <init fun="imu_parrot_minidrone_init()"/>
  <periodic fun="imu_parrot_minidrone_periodic()"/>
  <event fun="imu_parrot_minidrone_event()"/>
  <makefile target="!sim|nps|fbw">
    <define name="USE_I2C0"/>
    <define name="IMU_TYPE_H" value="modules/imu/imu_parrot_minidrone.h" type="string"/>
    <file name="mpu60x0.c" dir="peripherals"/>
    <file name="mpu60x0_i2c.c" dir="peripherals"/>
    <file name="imu_parrot_minidrone.c"/>
    <test>
      <define name="IMU_TYPE_H" value="modules/imu/imu_parrot_minidrone.h" type="string"/>
      <define name="USE_I2C0"/>
      <define name="PERIODIC_FREQUENCY" value="500"/>
    </test>
  </makefile>
</module>
