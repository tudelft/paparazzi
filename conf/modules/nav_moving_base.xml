<!DOCTYPE module SYSTEM "module.dtd">

<module name="nav_moving_base" dir="nav" task="control">
  <doc>
    <description>
      Navigation functions for tracking and landing on a moving base.
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="nav_moving_base">
        <dl_setting var="nav_moving_base.stay" MIN="0" STEP="1" MAX="1" values="FALSE|TRUE" shortname="stay"/>
        <dl_setting var="nav_moving_base.pos_gain.x" MIN="0.0" STEP="0.01" MAX="10.0" shortname="pos_gain_x"/>
        <dl_setting var="nav_moving_base.pos_gain.y" MIN="0.0" STEP="0.01" MAX="10.0" shortname="pos_gain_y"/>
        <dl_setting var="nav_moving_base.pos_gain.z" MIN="0.0" STEP="0.01" MAX="10.0" shortname="pos_gain_z"/>
        <dl_setting var="nav_moving_base.speed_gain.x" MIN="0.0" STEP="0.01" MAX="10.0" shortname="speed_gain_x"/>
        <dl_setting var="nav_moving_base.speed_gain.y" MIN="0.0" STEP="0.01" MAX="10.0" shortname="speed_gain_y"/>
        <dl_setting var="nav_moving_base.speed_gain.z" MIN="0.0" STEP="0.01" MAX="10.0" shortname="speed_gain_z"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <dep>
    <depends>@navigation</depends>
  </dep>
  <header>
    <file name="nav_moving_base.h" dir="modules/nav"/>
  </header>
  <init fun="nav_moving_base_init()"/>
  <makefile>
    <file name="nav_moving_base.c" dir="modules/nav"/>
  </makefile>
</module>