<!DOCTYPE module SYSTEM "module.dtd">

<module name="target_pos" dir="ctrl">
  <doc>
    <description>
      Target position calculation
    </description>
    <section name="TARGET_POS" prefix="TARGET_">
      <define name="POS_TIMEOUT" value="5000" description="timeout of the ground target position message in msec"/>
      <define name="OFFSET_X" value="0." description="target offset heading in degrees"/>
      <define name="OFFSET_Y" value="0." description="target offset distance in meters"/>
      <define name="OFFSET_Z" value="0." description="target offset height in meters"/>
    </section>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="TargetPos">
        <dl_setting var="target.offset.x" min="-100." max="100." step="0.1" shortname="x_offset" unit="m"/>
        <dl_setting var="target.offset.y" min="-100." max="100." step="0.1" shortname="y_offset" unit="m"/>
        <dl_setting var="target.offset.z" min="-100.0" max="100." step="0.1" shortname="z_offset"/>
        <dl_setting var="target.target_pos_timeout" min="0" max="30000" step="100" shortname="target_pos_timeout"/>
        <dl_setting var="target.rtk_timeout" min="0" max="30000" step="100" shortname="rtk_timeout"/>
      </dl_settings>
      <dl_settings NAME="FalconSensor">
        <dl_setting var="falcon.manual" min="0" max="1" step="1" values="OFF|ON" shortname="manual_mode"/> <!-- Currently unused -->
        <dl_setting var="falcon.mode" min="0" max="2" step="1" values="OFF|SIXDOF|RELANGLE" shortname="mode" module="modules/ctrl/target_pos" handler="send_falcon_cmd"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="target_pos.h"/>
  </header>
  <init fun="target_pos_init()"/>
  <periodic fun="target_pos_periodic()" freq="50"/>
  <datalink message="TARGET_POS" fun="target_parse_target_pos(buf)"/>
  <datalink class="intermcu" message="IMCU_FALCON_SIXDOF" fun="target_pos_parse_falcon_sixdof(buf)"/>
  <datalink class="intermcu" message="IMCU_FALCON_RELANGLE" fun="target_pos_parse_falcon_relangle(buf)"/>
  <makefile>
    <file name="target_pos.c"/>
    <file name="simple_kinematic_kalman.c" dir="filters"/>
  </makefile>
</module>
