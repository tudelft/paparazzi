<!DOCTYPE module SYSTEM "module.dtd">

<module name="MAV_cv_detect_group12_cmjong" dir="computer_vision">
  <doc>
    <description>Cascading obstacle detector: color detection, (edge detection), optical flow.
    Cheapest checks run first; expensive OF only when nothing else detected.
    </description>
    <define name="COLOR_OBJECT_DETECTOR_CAMERA" value="front_camera" description="Video device to use"/>
    <define name="ORANGE_OBJECT_DETECTOR_FPS" value="0" description="Desired FPS (0: camera rate)"/>
    <define name="ORANGE_OBJECT_DETECTOR_LUM_MIN" value="0" description="Min luminance"/>
    <define name="ORANGE_OBJECT_DETECTOR_LUM_MAX" value="0" description="Max luminance"/>
    <define name="ORANGE_OBJECT_DETECTOR_CB_MIN" value="0" description="Min blue chroma"/>
    <define name="ORANGE_OBJECT_DETECTOR_CB_MAX" value="0" description="Max blue chroma"/>
    <define name="ORANGE_OBJECT_DETECTOR_CR_MIN" value="0" description="Min red chroma"/>
    <define name="ORANGE_OBJECT_DETECTOR_CR_MAX" value="0" description="Max red chroma"/>

    <define name="BLUE_OBJECT_DETECTOR_CAMERA" value="front_camera"/>
    <define name="BLUE_OBJECT_DETECTOR_FPS" value="0"/>
    <define name="BLUE_OBJECT_DETECTOR_LUM_MIN" value="0"/>
    <define name="BLUE_OBJECT_DETECTOR_LUM_MAX" value="0"/>
    <define name="BLUE_OBJECT_DETECTOR_CB_MIN" value="0"/>
    <define name="BLUE_OBJECT_DETECTOR_CB_MAX" value="0"/>
    <define name="BLUE_OBJECT_DETECTOR_CR_MIN" value="0"/>
    <define name="BLUE_OBJECT_DETECTOR_CR_MAX" value="0"/>

    <define name="GREEN_OBJECT_DETECTOR_CAMERA" value="front_camera"/>
    <define name="GREEN_OBJECT_DETECTOR_FPS" value="0"/>
    <define name="GREEN_OBJECT_DETECTOR_LUM_MIN" value="0"/>
    <define name="GREEN_OBJECT_DETECTOR_LUM_MAX" value="0"/>
    <define name="GREEN_OBJECT_DETECTOR_CB_MIN" value="0"/>
    <define name="GREEN_OBJECT_DETECTOR_CB_MAX" value="0"/>
    <define name="GREEN_OBJECT_DETECTOR_CR_MIN" value="0"/>
    <define name="GREEN_OBJECT_DETECTOR_CR_MAX" value="0"/>

    <define name="COLOR_OBJECT_DETECTOR_DRAW" value="FALSE|TRUE" description="Draw detection on image"/>
    <define name="GREEN_OBJECT_DETECTOR_DRAW" value="FALSE|TRUE" description="Force green mask drawing from plant detector"/>

    <define name="THRESHOLD_ORANGE_DETECTOR" value="0"/>
    <define name="THRESHOLD_BLUE_DETECTOR" value="0"/>
    <define name="THRESHOLD_GREEN_DETECTOR" value="0"/>

    <define name="LUKE_OF_VISUAL_DETECTION_ID" value="ABI_BROADCAST" description="VISUAL_DETECTION sender id for optical flow"/>
    <section name="OPTICFLOW" prefix="OPTICFLOW_">
      <define name="CAMERA" value="front_camera|bottom_camera" description="Video device used for optical-flow calculations"/>
      <define name="METHOD" value="0" description="Method used to calculate optical flow"/>
      <define name="CORNER_METHOD" value="0" description="Corner detector: exhaustive FAST (0) or ACT-FAST (1)"/>
      <define name="MAX_TRACK_CORNERS" value="100" description="Maximum number of tracked corners"/>
      <define name="FAST9_THRESHOLD" value="7" description="FAST9 detection threshold"/>
      <define name="FAST9_MIN_DISTANCE" value="5" description="Minimum pixel spacing between corners"/>
      <define name="FAST9_PADDING" value="20" description="Image border excluded from corner detection"/>
      <define name="FEATURE_MANAGEMENT" value="TRUE" description="Reuse tracked features across frames"/>
      <define name="FAST9_REGION_DETECT" value="TRUE" description="Balance FAST9 detections across image regions"/>
      <define name="FAST9_NUM_REGIONS" value="9" description="Number of detection regions when region balancing is enabled"/>
      <define name="PYRAMID_LEVEL" value="2" description="Number of Lucas-Kanade pyramid levels"/>
    </section>

  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="ColorObjectDetector">
         <dl_setting var="orange_lum_min" min="0" step="1" max="255" shortname="y_orange_min"/>
         <dl_setting var="orange_lum_max" min="0" step="1" max="255" shortname="y_orange_max"/>
         <dl_setting var="orange_cb_min"  min="0" step="1" max="255" shortname="u_orange_min"/>
         <dl_setting var="orange_cb_max"  min="0" step="1" max="255" shortname="u_orange_max"/>
         <dl_setting var="orange_cr_min"  min="0" step="1" max="255" shortname="v_orange_min"/>
         <dl_setting var="orange_cr_max"  min="0" step="1" max="255" shortname="v_orange_max"/>
         <dl_setting var="blue_lum_min" min="0" step="1" max="255" shortname="y_blue_min"/>
         <dl_setting var="blue_lum_max" min="0" step="1" max="255" shortname="y_blue_max"/>
         <dl_setting var="blue_cb_min"  min="0" step="1" max="255" shortname="u_blue_min"/>
         <dl_setting var="blue_cb_max"  min="0" step="1" max="255" shortname="u_blue_max"/>
         <dl_setting var="blue_cr_min"  min="0" step="1" max="255" shortname="v_blue_min"/>
         <dl_setting var="blue_cr_max"  min="0" step="1" max="255" shortname="v_blue_max"/>
         <dl_setting var="green_lum_min" min="0" step="1" max="255" shortname="y_green_min"/>
         <dl_setting var="green_lum_max" min="0" step="1" max="255" shortname="y_green_max"/>
         <dl_setting var="green_cb_min"  min="0" step="1" max="255" shortname="u_green_min"/>
         <dl_setting var="green_cb_max"  min="0" step="1" max="255" shortname="u_green_max"/>
         <dl_setting var="green_cr_min"  min="0" step="1" max="255" shortname="v_green_min"/>
         <dl_setting var="green_cr_max"  min="0" step="1" max="255" shortname="v_green_max"/>
         <dl_setting var="cod_draw"  min="0" step="1" max="1" values="False|True" shortname="draw 1" />

      </dl_settings>
    </dl_settings>
  </settings>

  <settings>
    <dl_settings>
      <dl_settings name="Threshold_of_detectors">
         <dl_setting var="threshold_orange_detector" min="0" step="1" max="5000" shortname="W_orange_d"/>
         <dl_setting var="threshold_blue_detector" min="0" step="1" max="5000" shortname="W_blue_d"/>
         <dl_setting var="threshold_green_detector" min="0" step="1" max="5000" shortname="W_green_d"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <settings>
    <dl_settings>
      <dl_settings name="CropSettings">
         <dl_setting var="crop_h_frac" min="0.2" step="0.05" max="1.0" shortname="crop_h"/>
         <dl_setting var="crop_w_frac" min="0.2" step="0.05" max="1.0" shortname="crop_w"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <settings>
    <dl_settings>
      <dl_settings name="LukeOpticalFlow">
        <dl_setting var="luke_of_divergence_threshold"
                    min="0.0" step="0.005" max="0.5"
                    shortname="div_thresh"/>
        <dl_setting var="luke_of_ema_alpha"
                    min="0.05" step="0.05" max="1.0"
                    shortname="ema_alpha"/>
        <dl_setting var="luke_of_derotation"
                    min="0" step="1" max="1"
                    values="FALSE|TRUE"
                    shortname="derot"/>
        <dl_setting var="luke_of_show_stream_overlay"
                    min="0" step="1" max="1"
                    values="FALSE|TRUE"
                    shortname="stream_dbg"/>
        <dl_setting var="luke_of_opticflow[0].method"
                    min="0" step="1" max="1"
                    values="LK_Fast9|EdgeFlow"
                    shortname="method"/>
        <dl_setting var="luke_of_opticflow[0].corner_method"
                    min="0" step="1" max="1"
                    values="Fast9|ACTFAST"
                    shortname="corner"/>
        <dl_setting var="luke_of_opticflow[0].max_track_corners"
                    min="1" step="1" max="500"
                    shortname="max_pts"/>
        <dl_setting var="luke_of_opticflow[0].fast9_threshold"
                    min="0" step="1" max="255"
                    shortname="fast_thr"/>
        <dl_setting var="luke_of_opticflow[0].fast9_min_distance"
                    min="0" step="1" max="500"
                    shortname="fast_dst"/>
        <dl_setting var="luke_of_opticflow[0].fast9_padding"
                    min="0" step="1" max="50"
                    shortname="pad"/>
        <dl_setting var="luke_of_opticflow[0].feature_management"
                    min="0" step="1" max="1"
                    values="FALSE|TRUE"
                    shortname="feat_mg"/>
        <dl_setting var="luke_of_opticflow[0].fast9_region_detect"
                    min="0" step="1" max="1"
                    values="FALSE|TRUE"
                    shortname="regions"/>
        <dl_setting var="luke_of_opticflow[0].fast9_num_regions"
                    min="1" step="1" max="25"
                    shortname="n_reg"/>
        <dl_setting var="luke_of_opticflow[0].pyramid_level"
                    min="0" step="1" max="10"
                    shortname="pyr"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread,agl_dist,pose_history</depends>
    <depends>video_thread,MAV_plant_avoider</depends>
  </dep>

  <header>
    <file name="MAV_cv_detect_group12_cmjong.h"/>
  </header>

  <init fun="MAV_cv_detect_group12_cmjong_init()"/>
  <periodic fun="MAV_cv_detect_group12_cmjong_periodic()" freq="50"/>
  <makefile target="ap|nps">
    <include name="modules/computer_vision"/>
    <file name="MAV_cv_detect_group12_cmjong.c"/>
    <file name="MAV_cv_color_group12_cmjong.c"/>
    <file name="opticflow_calculator.c" dir="modules/computer_vision/opticflow"/>
    <file name="size_divergence.c" dir="modules/computer_vision/opticflow"/>
    <file name="linear_flow_fit.c" dir="modules/computer_vision/opticflow"/>
    <file name="pprz_algebra_float.c" dir="math"/>
    <file name="pprz_matrix_decomp_float.c" dir="math"/>
    <file name="act_fast.c" dir="modules/computer_vision/lib/vision"/>
    <file name="fast_rosten.c" dir="modules/computer_vision/lib/vision"/>
    <file name="lucas_kanade.c" dir="modules/computer_vision/lib/vision"/>
    <file name="edge_flow.c" dir="modules/computer_vision/lib/vision"/>
    <file name="undistortion.c" dir="modules/computer_vision/lib/vision"/>
  </makefile>
</module>
