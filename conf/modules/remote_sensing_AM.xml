  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="RemoteSensing">
        <dl_setting var="falcon.auto_mode" min="0" max="1" step="1" values="FALSE|TRUE" shortname="auto_mode"/>
        <dl_setting var="falcon.mode" min="0" max="3" step="1" values="OFF|SIXDOF|RELANGLE|RELBEACON" shortname="falcon_mode" module="modules/sensors/remote_sensing_AM" handler="send_falcon_cmd"/>
        <dl_setting var="falcon.relangle.distance" min="0" max="20" step="0.01" shortname="relangle_dist"/>
        <dl_setting var="remote_sensing_kalman" min="0" max="0" values="INIT" shortname="kalman_reinit" module="modules/sensors/remote_sensing_AM" handler="kalman_filter_init" type="fun"/>
        <dl_setting var="track_aruco_id" min="0" max="50" step="1" shortname="track_id"/>
        <dl_setting var="use_sixdof" min="0" max="1" step="1" values="FALSE|TRUE" shortname="use_sixdof"/>
        <dl_setting var="use_relangle" min="0" max="1" step="1" values="FALSE|TRUE" shortname="use_relangle"/>
        <dl_setting var="use_relbeacon" min="0" max="1" step="1" values="FALSE|TRUE" shortname="use_relbeacon"/>
        <dl_setting var="use_rtk" min="0" max="1" step="1" values="FALSE|TRUE" shortname="use_rtk"/>
        <dl_setting var="use_aruco" min="0" max="1" step="1" values="FALSE|TRUE" shortname="use_aruco"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="remote_sensing_AM.h"/>
  </header>
  <init fun="remote_sensing_AM_init()"/>
  <periodic fun="remote_sensing_AM_periodic()" freq="50"/>
  <datalink message="TARGET_POS" fun="remote_sensing_parse_target_pos(buf)"/>
  <datalink class="intermcu" message="IMCU_FALCON_SIXDOF" fun="remote_sensing_parse_falcon_sixdof(buf)"/>
  <datalink class="intermcu" message="IMCU_FALCON_RELANGLE" fun="remote_sensing_parse_falcon_relangle(buf)"/>
  <datalink class="intermcu" message="IMCU_FALCON_RELBEACON" fun="remote_sensing_parse_falcon_relbeacon(buf)"/>
  <datalink class="intermcu" message="IMCU_OPENCV_ARUCO" fun="remote_sensing_parse_opencv_aruco(buf)"/>
  <datalink class="intermcu" message="IMCU_LANDING_ALGORITHM_OUTPUT" fun="receive_landing_algorithm_outputs(buf)"/>
  <makefile>
    <file name="remote_sensing_AM.c"/>
    <file name="target_pos_kalman.c" dir="filters"/>
    <file name="pprz_random.c" dir="math"/>
  </makefile>
</module>
