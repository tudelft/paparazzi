<!DOCTYPE module SYSTEM "module.dtd">

<module name="ship_landing_module_AM" dir="ship_landing">
  <doc>
    <description>Ship landing module Alessandro Mancinelli</description>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings NAME="ship approach module">
        <dl_setting var="approach_ship_engaged" min="0" step="1" max="1" shortname="approach_ship_engaged" values="FALSE|TRUE" persistent="true"/>
        <dl_setting var="approach_heading_ship_deg"  min="-90" step="1" max="90" shortname="approach_heading_ship_deg" persistent="true"/>
        <dl_setting var="diag_approach_speed_m_s_float"  min="0" step=".01" max="2" shortname="diag_approach_speed" persistent="true"/>
        <dl_setting var="dist_line_gain_float"  min="0" step=".01" max="10" shortname="dist_line_gain" persistent="true"/>
        <dl_setting var="max_line_gain_float"  min="0" step=".01" max="2" shortname="max_line_gain" persistent="true"/>
        <dl_setting var="Px_gain"  min="0" step=".01" max="5" shortname="Px_gain" persistent="true"/>
        <dl_setting var="Py_gain"  min="0" step=".01" max="5" shortname="Py_gain" persistent="true"/>
        <dl_setting var="Pz_gain"  min="0" step=".01" max="5" shortname="Pz_gain" persistent="true"/>
        <dl_setting var="flare_low_distance_m_float"  min="0" step=".1" max="10" shortname="flare_low_distance" persistent="true"/>
        <dl_setting var="v_speed_docking_m_s_float"  min="0" step=".01" max="2" shortname="v_speed_docking" persistent="true"/>
        <dl_setting var="pos_tracking_distance_m_float"  min="0" step=".1" max="10" shortname="pos_tracking_distance" persistent="true"/>
        <dl_setting var="Px_APP_point_offset"  min="-10" step=".1" max="10" shortname="Px_APP_point_offset" persistent="true"/>
        <dl_setting var="Py_APP_point_offset"  min="-10" step=".1" max="10" shortname="Py_APP_point_offset" persistent="true"/>
        <dl_setting var="Pz_APP_point_offset"  min="-10" step=".1" max="10" shortname="Pz_APP_point_offset" persistent="true"/>
        <dl_setting var="sliding_window_seconds"  min="0" step=".1" max="40" shortname="sliding_window_seconds" persistent="true"/>
        <dl_setting var="max_time_valid_prediction"  min="0" step=".1" max="10" shortname="time_prediction" persistent="true"/>

        <dl_setting var="Vx_max_control"  min="0" step=".1" max="20" shortname="Vx_max_control" persistent="true"/>
        <dl_setting var="Vx_min_control"  min="-20" step=".1" max="0" shortname="Vx_max_control" persistent="true"/>
        <dl_setting var="Vy_max_control"  min="0" step=".1" max="20" shortname="Vy_max_control" persistent="true"/>
        <dl_setting var="Vy_min_control"  min="-20" step=".1" max="0" shortname="Vy_max_control" persistent="true"/>
        <dl_setting var="Vz_max_control"  min="0" step=".1" max="10" shortname="Vz_max_control" persistent="true"/>
        <dl_setting var="Vz_min_control"  min="-10" step=".1" max="0" shortname="Vz_max_control" persistent="true"/>
        <dl_setting var="Ax_max_control"  min="0" step=".1" max="20" shortname="Ax_max_control" persistent="true"/>
        <dl_setting var="Ax_min_control"  min="-20" step=".1" max="0" shortname="Ax_max_control" persistent="true"/>
        <dl_setting var="Ay_max_control"  min="0" step=".1" max="20" shortname="Ay_max_control" persistent="true"/>
        <dl_setting var="Ay_min_control"  min="-20" step=".1" max="0" shortname="Ay_max_control" persistent="true"/>
        <dl_setting var="Az_max_control"  min="0" step=".1" max="10" shortname="Az_max_control" persistent="true"/>
        <dl_setting var="Az_min_control"  min="-10" step=".1" max="0" shortname="Az_max_control" persistent="true"/>
      

      </dl_settings>
    </dl_settings>
  </settings>

  <header>
    <file name="nav_approach_ship.h"/>
    <file name="core_nav_approach_ship.h"/>
  </header>

   <init fun="nav_approach_ship_init()"/>
   <periodic fun="nav_approach_ship_run()" autorun="TRUE" freq="PERIODIC_FREQUENCY_NAV_APPROACH_SHIP"/>

   <datalink message="SHIP_INFO_MSG" fun="nav_approach_ship_parse_SHIP_INFO_MSG(buf)"/>
   <datalink message="SHIP_PREDICTION_MSG" fun="nav_approach_ship_parse_SHIP_PREDICTION_MSG(buf)"/>

  <makefile>
    <file name="nav_approach_ship.c"/>
    <file name="core_nav_approach_ship.c"/>
  </makefile>
</module>
