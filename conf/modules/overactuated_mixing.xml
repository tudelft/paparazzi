<!DOCTYPE module SYSTEM "module.dtd">

<module name="overactuated_mixing" dir="overactuated_vehicle">
  <doc>
    <description>Overactuated Vehicle Mixing</description>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings NAME="overactuated vehicle nav settings">
        <dl_setting var="fpa_off_deg"  min="-10" step=".01" max="10" shortname="fpa_off_deg" />
        <dl_setting var="overestimation_coeff"  min="0" step=".01" max="2" shortname="overest_coeff" />
        <dl_setting var="K_beta"  min="-5" step=".01" max="5" shortname="K_beta" persistent="true"/>
        <dl_setting var="extra_lat_gain"  min="-2" step=".01" max="2" shortname="extra_lat_gain" />
      </dl_settings>
    </dl_settings>
  </settings>

  <settings>
    <dl_settings>
      <dl_settings NAME="overactuated vehicle gains">

        <!-- INDI cruise gains -->
        <dl_setting var="active_gains.p.phi" min="0" step=".001" max="50" shortname="INDI_ROLL_P_GAIN" persistent="true"/>
        <dl_setting var="active_gains.d.phi" min="0" step=".001" max="50" shortname="INDI_ROLL_D_GAIN" persistent="true"/>

        <dl_setting var="active_gains.p.theta" min="0" step=".001" max="50" shortname="INDI_PITCH_P_GAIN" persistent="true"/>
        <dl_setting var="active_gains.d.theta" min="0" step=".001" max="50" shortname="INDI_PITCH_D_GAIN" persistent="true"/>

        <dl_setting var="active_gains.p.psi" min="0" step=".001" max="50" shortname="INDI_YAW_P_GAIN" persistent="true"/>
        <dl_setting var="active_gains.d.psi" min="0" step=".001" max="50" shortname="INDI_YAW_D_GAIN" persistent="true"/>

        <dl_setting var="active_gains.p.x" min="0" step=".001" max="10" shortname="INDI_X_P_GAIN" persistent="true"/>
        <dl_setting var="active_gains.d.x" min="0" step=".001" max="10" shortname="INDI_X_D_GAIN" persistent="true"/>

        <dl_setting var="active_gains.p.y" min="0" step=".001" max="10" shortname="INDI_Y_P_GAIN" persistent="true"/>
        <dl_setting var="active_gains.d.y" min="0" step=".001" max="10" shortname="INDI_Y_D_GAIN" persistent="true"/>

        <dl_setting var="active_gains.p.z" min="0" step=".001" max="30" shortname="INDI_Z_P_GAIN" persistent="true"/>
        <dl_setting var="active_gains.d.z" min="0" step=".001" max="30" shortname="INDI_Z_D_GAIN" persistent="true"/>

        <!-- PID gains -->
        <dl_setting var="pid_gains_over.p.phi" min="0" step="1" max="1200" shortname="PID_kp_roll" persistent="true"/>
        <dl_setting var="pid_gains_over.i.phi" min="0" step=".1" max="5" shortname="PID_ki_roll" persistent="true"/>
        <dl_setting var="pid_gains_over.d.phi" min="0" step="1" max="300" shortname="PID_kd_roll" persistent="true"/>

        <dl_setting var="pid_gains_over.p.theta" min="0" step="1" max="1200"   shortname="PID_kp_pitch" persistent="true"/>
        <dl_setting var="pid_gains_over.i.theta" min="0" step=".1" max="50"  shortname="PID_ki_pitch" persistent="true"/>
        <dl_setting var="pid_gains_over.d.theta" min="0" step="1" max="300"  shortname="PID_kd_pitch" persistent="true"/>

        <dl_setting var="pid_gains_over.p.psi" min="0" step=".01" max="40" shortname="PID_kp_yaw" persistent="true"/>
        <dl_setting var="pid_gains_over.i.psi" min="0" step=".01" max="20" shortname="PID_ki_yaw" persistent="true"/>
        <dl_setting var="pid_gains_over.d.psi" min="0" step=".01" max="20" shortname="PID_kd_yaw" persistent="true"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <header>
    <file name="overactuated_mixing.h"/>
  </header>
   
   <init fun="overactuated_mixing_init()"/>
   <periodic fun="overactuated_mixing_run()" autorun="TRUE" freq="OVERACTUATED_MIXING_FREQUENCY"/>
   
   
  <makefile>
    <file name="overactuated_mixing.c"/>
  </makefile>
</module>
