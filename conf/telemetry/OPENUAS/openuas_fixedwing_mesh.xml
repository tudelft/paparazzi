<?xml version="1.0"?>
<!DOCTYPE telemetry SYSTEM "../telemetry.dtd">
<!--
  openuas_fixedwing_mesh.xml

  Phase values are generated and replay-verified with
  sw/tools/mesh/mesh_phase_optimizer.py. Re-solve and verify every affected
  mode after changing a message period or phase.

  Link      : EByte E52-400NW22S LoRa MESH, broadcast mode (AT+OPTION=3)
  Air rate  : 62500 bps  (SF5, BW 500 kHz, CR 4/5)
  UART      : 460800 baud 8N1
  Network   : mesh 13 peers; manifold 17 peers (16 aircraft + GCS), all routing
  Flood tax : one transmission per routing peer for each originated broadcast

  Budget
    mesh         : 57.8 % modeled channel utilisation at 13 peers
    manifold     : 59.4 % modeled channel utilisation at 17 peers
    steady state : 25 fair-share slots; 7 physical slots are churn headroom
    modem cache  : modeled peak 1; acceptance ceiling 3; hardware limit 5

  Automatic operating modes
      mesh_manifold : Conservative 13-16 aircraft profile.
            Entered at 12 observed aircraft peers and retained until the
            count falls below 10, providing hysteresis during churn.
      mesh          : Startup and normal 1-12 aircraft profile. It carries the same operational
            message set as mesh_manifold at approximately twice its rates.
    mesh_solo  : High-rate two-node profile for one aircraft plus the GCS. It
                 requires fresh GCS contact, no other live aircraft or peer
                 slot, and one quiet 16 s superframe before entry. Any peer
                 MESH_STATE exits solo immediately through mesh_manifold.

  Operator commands and their acknowledgements are asynchronous. Camera shots
  and TCAS advisories are event-driven, so none belongs in a periodic mode.

  Inter-node collision avoidance uses GNSS-time TDMA, bounded monotonic
  holdover, then randomized GPS-free access in
  sw/airborne/modules/multi/traffic_info.c :
    superframe 16.00 s / 32 slots of 500.0 ms
    slots are claimed at run time by listening, never derived
    from AC_ID, so any set of distinct IDs in 0..254 works
    traffic_info module defaults define the fleet-wide 16000/32/25/8 timing contract

  phase is a normalised fraction of the period, so this file stays valid
  for any TELEMETRY_FREQUENCY; it was solved and verified against
  TELEMETRY_FREQUENCY = 50 Hz.
-->
<telemetry>
  <process name="Ap">
    <mode name="mesh" key_press="h">
      <!-- Normal 1-12 aircraft operation: complete operational visibility at
           roughly twice the manifold update rate while retaining event reserve. -->
      <message name="MESH_STATE"        period="2.0"     phase="0.005000"/>
      <message name="MINIMAL_COM"       period="10.0"    phase="0.201000"/>
      <message name="PPRZ_MODE"         period="40.0"    phase="0.112750"/>
      <message name="ATTITUDE"          period="40.0"    phase="0.175250"/>
      <message name="ENERGY"            period="40.0"    phase="0.675250"/>
      <message name="NAVIGATION"        period="40.0"    phase="0.925250"/>
      <message name="AIRSPEED"          period="80.0"    phase="0.212625"/>
      <message name="ESTIMATOR"         period="80.0"    phase="0.181375"/>
      <message name="GPS_LLA"           period="80.0"    phase="0.243875"/>
      <message name="NAVIGATION_REF"    period="80.0"    phase="0.306375"/>
      <message name="RANGEFINDER"       period="80.0"    phase="0.368875"/>
      <message name="WP_MOVED"          period="80.0"    phase="0.431375"/>
      <!-- CIRCLE, SEGMENT and SURVEY are mutually exclusive navigation shapes. -->
      <message name="CIRCLE"            period="80.0"    phase="0.118875"/>
      <message name="SEGMENT"           period="80.0"    phase="0.118875"/>
      <message name="SURVEY"            period="80.0"    phase="0.118875"/>
      <message name="AIR_DATA"          period="160.0"   phase="0.246938"/>
      <message name="ALIVE"             period="160.0"   phase="0.309437"/>
      <message name="DATALINK_REPORT"   period="160.0"   phase="0.340687"/>
      <message name="DESIRED"           period="160.0"   phase="0.371937"/>
      <message name="GPS_SOL"           period="160.0"   phase="0.403187"/>
      <message name="STATE_FILTER_STATUS" period="160.0" phase="0.434437"/>
      <message name="CALIBRATION"       period="320.0"   phase="0.232844"/>
      <message name="DL_VALUE"          period="320.0"   phase="0.248469"/>
    </mode>
    <mode name="mesh_manifold">
      <!-- Conservative 13-16 aircraft operation: the complete
           operational set at lower rates to stay below 60% under flood load. -->
      <message name="MESH_STATE"        period="2.0"     phase="0.005000"/>
      <message name="MINIMAL_COM"       period="20.0"    phase="0.350500"/>
      <message name="PPRZ_MODE"         period="80.0"    phase="0.018875"/>
      <message name="ATTITUDE"          period="80.0"    phase="0.212625"/>
      <message name="ENERGY"            period="80.0"    phase="0.462625"/>
      <message name="NAVIGATION"        period="80.0"    phase="0.950000"/>
      <message name="AIRSPEED"          period="160.0"   phase="0.075063"/>
      <message name="ESTIMATOR"         period="160.0"   phase="0.200063"/>
      <message name="GPS_LLA"           period="160.0"   phase="0.262562"/>
      <message name="NAVIGATION_REF"    period="160.0"   phase="0.325062"/>
      <message name="RANGEFINDER"       period="160.0"   phase="0.387562"/>
      <message name="WP_MOVED"          period="160.0"   phase="0.575063"/>
      <!-- Only one navigation shape emits at a time, so these intentionally share a phase. -->
      <message name="CIRCLE"            period="160.0"   phase="0.137563"/>
      <message name="SEGMENT"           period="160.0"   phase="0.137563"/>
      <message name="SURVEY"            period="160.0"   phase="0.137563"/>
      <message name="AIR_DATA"          period="320.0"   phase="0.318781"/>
      <message name="ALIVE"             period="320.0"   phase="0.350031"/>
      <message name="DATALINK_REPORT"   period="320.0"   phase="0.381281"/>
      <message name="DESIRED"           period="320.0"   phase="0.412531"/>
      <message name="GPS_SOL"           period="320.0"   phase="0.443781"/>
      <message name="STATE_FILTER_STATUS" period="320.0" phase="0.818781"/>
      <message name="CALIBRATION"       period="640.0"   phase="0.425016"/>
      <message name="DL_VALUE"          period="640.0"   phase="0.440641"/>
    </mode>
    <mode name="mesh_solo">
      <!-- One aircraft plus GCS only: spend the released flood capacity on
           control-relevant freshness while preserving margin for events. -->
      <message name="MESH_STATE"        period="2.0"     phase="0.005000"/>  <!-- Safety/discovery canary; TDMA gates actual emission. -->
      <message name="MINIMAL_COM"       period="0.20"    phase="0.100000"/>  <!-- 5 Hz position, speed, mode, block, voltage and flight time. -->
      <message name="RANGEFINDER"       period="2.0"     phase="0.150000"/>
      <message name="ATTITUDE"          period="0.50"    phase="0.500000"/>  <!-- Proven 2 Hz profile, offset from MINIMAL_COM. -->
      <message name="AIRSPEED"          period="2.0"     phase="0.560000"/>
      <message name="ENERGY"            period="1.0"     phase="0.540000"/>
      <message name="NAVIGATION"        period="4.0"     phase="0.700000"/>
      <message name="DATALINK_REPORT"   period="2.0"     phase="0.900000"/>
      <message name="FBW_STATUS"        period="8.0"     phase="0.590000"/>
      <message name="PPRZ_MODE"         period="8.0"     phase="0.740000"/>
      <message name="DESIRED"           period="8.0"     phase="0.580000"/>
      <!-- Only one navigation shape emits at a time, so these intentionally share a phase. -->
      <message name="CIRCLE"            period="8.0"     phase="0.940000"/>
      <message name="SEGMENT"           period="8.0"     phase="0.940000"/>
      <message name="SURVEY"            period="8.0"     phase="0.940000"/>
      <message name="ALIVE"             period="5.0"     phase="0.136000"/>
      <message name="AIR_DATA"          period="20.0"    phase="0.908000"/>
      <message name="GPS_SOL"           period="20.0"    phase="0.866000"/>
      <message name="STATE_FILTER_STATUS" period="20.0"  phase="0.758000"/>
      <message name="WP_MOVED"          period="16.0"    phase="0.545000"/>
      <message name="NAVIGATION_REF"    period="32.0"    phase="0.523750"/>
      <message name="DL_VALUE"          period="60.0"    phase="0.836000"/>
      <message name="CALIBRATION"       period="60.0"    phase="0.702000"/>
    </mode>
  </process>
  <process name="Fbw">
    <mode name="default">
      <message name="FBW_STATUS"        period="80.0"    phase="0.712625"/>
    </mode>
  </process>
</telemetry>
