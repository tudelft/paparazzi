<?xml version="1.0"?>
<!DOCTYPE telemetry SYSTEM "../telemetry.dtd">
<telemetry>
  <process name="Ap">
    <mode name="default" key_press="d">
      <message name="ADC_GENERIC"         period="0.7"/>
      <message name="AIRSPEED"            period="0.2"/>
      <message name="AIRSPEED_RAW"        period="0.3"/>
      <message name="AMSL"                period="1.4"/>
      <message name="ALIVE"               period="5.1"/>
      <message name="GPS"                 period="0.5"/>
      <message name="NAVIGATION"          period="0.5"/>
      <message name="ATTITUDE"            period="0.2"/>
      <message name="ESTIMATOR"           period="0.6"/>
      <message name="ENERGY"              period="1.1"/>
      <message name="WP_MOVED"            period="0.25"/>
      <message name="CIRCLE"              period="1.05"/>
      <message name="DESIRED"             period="0.2"/>
      <message name="SEGMENT"             period="1.2"/>
      <message name="CALIBRATION"         period="2.1"/>
      <message name="NAVIGATION_REF"      period="4.0"/>
      <message name="PPRZ_MODE"           period="1.0"/>
      <message name="SETTINGS"            period="3.0"/>
      <message name="STATE_FILTER_STATUS" period="2.2"/>
      <message name="DATALINK_REPORT"     period="5.1"/>
      <message name="DL_VALUE"            period="1.5"/>
      <message name="SURVEY"              period="2.1"/>
      <message name="GPS_SOL"             period="2.0"/>
      <message name="IMU_ACCEL"           period=".9"/>
      <message name="IMU_GYRO"            period=".9"/>
      <message name="IMU_MAG"             period="0.9"/>
      <message name="CAM"                 period="0.5"/>
      <message name="CAM_POINT"           period="1.0"/>
      <message name="COMMANDS"            period="0.8"/>
      <message name="FBW_STATUS"          period="1.1"/>
      <message name="PAYLOAD"             period="0.5"/>
      <message name="AIR_DATA"            period="1.3"/>
      <message name="RANGEFINDER"         period="0.3"/>
      <message name="RLFILTER"            period="0.3"/>
    </mode>
    <mode name="mesh" key_press="h">
      <message name="MESH_STATE"        period="1.5"     phase="0.006667"/>  <!-- t0=   0.00 s, 30 B on the wire; hybrid MAC gates actual emission. -->
      <message name="GPS_LLA"           period="32.0"    phase="0.007812"/>  <!-- t0=   0.24 s, 38 B on the wire,  8.46 ms/hop. -->
      <message name="ESTIMATOR"         period="64.0"    phase="0.011719"/>  <!-- t0=   0.74 s, 16 B on the wire,  5.58 ms/hop. -->
      <message name="ATTITUDE"          period="128.0"   phase="0.009766"/>  <!-- t0=   1.24 s, 20 B on the wire,  6.22 ms/hop. -->
      <message name="ENERGY"            period="128.0"   phase="0.013672"/>  <!-- t0=   1.74 s, 33 B on the wire,  7.82 ms/hop. -->
      <message name="NAVIGATION"        period="128.0"   phase="0.017578"/>  <!-- t0=   2.24 s, 35 B on the wire,  8.14 ms/hop. -->
      <message name="PPRZ_MODE"         period="128.0"   phase="0.021484"/>  <!-- t0=   2.74 s, 14 B on the wire,  5.26 ms/hop. -->
      <message name="AIR_DATA"          period="256.0"   phase="0.012695"/>  <!-- t0=   3.24 s, 36 B on the wire,  8.14 ms/hop. -->
      <message name="ALIVE"             period="256.0"   phase="0.014648"/>  <!-- t0=   3.74 s, 17 B on the wire,  5.90 ms/hop. -->
      <message name="CIRCLE"            period="256.0"   phase="0.016602"/>  <!-- t0=   4.24 s, 20 B on the wire,  6.22 ms/hop. only one nav shape is live at a time -->
      <message name="DATALINK_REPORT"   period="256.0"   phase="0.018555"/>  <!-- t0=   4.74 s, 19 B on the wire,  5.90 ms/hop. -->
      <message name="DL_VALUE"          period="256.0"   phase="0.020508"/>  <!-- t0=   5.24 s, 13 B on the wire,  5.26 ms/hop. -->
      <message name="GPS_SOL"           period="256.0"   phase="0.024414"/>  <!-- t0=   6.24 s, 19 B on the wire,  5.90 ms/hop. -->
      <message name="NAVIGATION_REF"    period="256.0"   phase="0.026367"/>  <!-- t0=   6.74 s, 21 B on the wire,  6.22 ms/hop. -->
      <message name="SEGMENT"           period="256.0"   phase="0.028320"/>  <!-- t0=   7.24 s, 24 B on the wire,  6.54 ms/hop. only one nav shape is live at a time -->
      <message name="SURVEY"            period="256.0"   phase="0.030273"/>  <!-- t0=   7.74 s, 24 B on the wire,  6.54 ms/hop. only one nav shape is live at a time -->
      <message name="WP_MOVED"          period="256.0"   phase="0.032227"/>  <!-- t0=   8.24 s, 22 B on the wire,  6.54 ms/hop. -->
    </mode>
    <mode name="mesh_dense">
      <!-- Selected automatically for 13-16 aircraft. Operator commands and their immediate acknowledgements are not periodic. -->
      <message name="MESH_STATE"        period="1.5"     phase="0.006667"/>  <!-- t0=   0.00 s, primary traffic/TCAS state; TDMA gates actual emission. -->
      <message name="GPS_LLA"           period="128.0"   phase="0.001953"/>  <!-- t0=   0.24 s, authoritative GPS diagnostic; MESH_STATE carries fresh position. -->
      <message name="ALIVE"             period="256.0"   phase="0.002930"/>  <!-- t0=   0.74 s, configuration identity/discovery fallback. -->
      <message name="WP_MOVED"          period="512.0"   phase="0.002441"/>  <!-- t0=   1.24 s; MOVE_WP still triggers an immediate acknowledgement. -->
      <message name="ESTIMATOR"         period="384.0"   phase="0.005859"/>  <!-- t0=   2.24 s. -->
      <message name="ATTITUDE"          period="768.0"   phase="0.004883"/>  <!-- t0=   3.74 s. -->
      <message name="ENERGY"            period="768.0"   phase="0.006836"/>  <!-- t0=   5.24 s. -->
      <message name="NAVIGATION"        period="768.0"   phase="0.008789"/>  <!-- t0=   6.74 s; BLOCK still triggers an immediate acknowledgement. -->
      <message name="PPRZ_MODE"         period="768.0"   phase="0.010742"/> <!-- t0=   8.24 s. -->
      <message name="AIR_DATA"          period="1536.0"  phase="0.006348"/>  <!-- t0=   9.74 s. -->
      <message name="CIRCLE"            period="1536.0"  phase="0.007324"/>  <!-- t0=  11.24 s; only one nav shape is live at a time. -->
      <message name="DATALINK_REPORT"   period="1536.0"  phase="0.008301"/>  <!-- t0=  12.74 s. -->
      <message name="DL_VALUE"          period="1536.0"  phase="0.009277"/>  <!-- t0=  14.24 s; SETTING still triggers an immediate acknowledgement. -->
      <message name="GPS_SOL"           period="1536.0"  phase="0.011230"/>  <!-- t0=  17.24 s. -->
      <message name="NAVIGATION_REF"    period="1536.0"  phase="0.012207"/>  <!-- t0=  18.74 s. -->
      <message name="SEGMENT"           period="1536.0"  phase="0.013184"/>  <!-- t0=  20.24 s; only one nav shape is live at a time. -->
      <message name="SURVEY"            period="1536.0"  phase="0.014160"/>  <!-- t0=  21.74 s; only one nav shape is live at a time. -->
    </mode>
    <mode name="mesh_solo">
      <!-- Keep the peer canary and auxiliary diagnostics slow; spend the solo-link margin on state freshness. -->
      <message name="MESH_STATE"        period="1.5"     phase="0.006667"/>  <!-- Safety/discovery canary; TDMA gates actual emission. -->
      <message name="MINIMAL_COM"       period="0.20"    phase="0.000000"/>  <!-- 5 Hz position, speed, mode, block, voltage and flight time. -->
      <message name="ATTITUDE"          period="0.50"    phase="0.500000"/>  <!-- 2 Hz, offset from MINIMAL_COM. -->
      <message name="ENERGY"            period="1.0"     phase="0.750000"/>
      <message name="DATALINK_REPORT"   period="2.0"     phase="0.625000"/>
      <message name="ALIVE"             period="5.0"     phase="0.900000"/>
    </mode>
    <mode name="minimal" key_press="m">
      <message name="ALIVE"               period="4.6"/>
      <message name="ATTITUDE"            period="5.4"/>
      <message name="GPS"                 period="1.05"/>
      <message name="ESTIMATOR"           period="1.3"/>
      <message name="WP_MOVED"            period="1.4"/>
      <message name="CIRCLE"              period="3.05"/>
      <message name="DESIRED"             period="4.05"/>
      <message name="ENERGY"              period="1.1"/>
      <message name="SEGMENT"             period="3.2"/>
      <message name="CALIBRATION"         period="5.1"/>
      <message name="NAVIGATION_REF"      period="9.0"/>
      <message name="NAVIGATION"          period="3.0"/>
      <message name="PPRZ_MODE"           period="5.0"/>
      <message name="STATE_FILTER_STATUS" period="5.0"/>
      <message name="DATALINK_REPORT"     period="5.1"/>
      <message name="DL_VALUE"            period="1.5"/>
      <message name="SURVEY"              period="2.1"/>
      <message name="GPS_SOL"             period="5.0"/>
      <message name="PAYLOAD_FLOAT"         period="0.5"/>
    </mode>
    <mode name="extremal" key_press="e">
      <message name="ALIVE"               period="5.0"/>
      <message name="GPS"                 period="5.1"/>
      <message name="ESTIMATOR"           period="5.3"/>
      <message name="ENERGY"              period="10.1"/>
      <message name="DESIRED"             period="10.2"/>
      <message name="NAVIGATION"          period="5.4"/>
      <message name="PPRZ_MODE"           period="7.5"/>
      <message name="STATE_FILTER_STATUS" period="8."/>
      <message name="DATALINK_REPORT"     period="5.7"/>
    </mode>
    <mode name="raw_sensors" key_press="r">
      <message name="DL_VALUE"            period="0.5"/>
      <message name="ALIVE"               period="2.1"/>
      <message name="IMU_ACCEL_RAW"       period="0.05"/>
      <message name="IMU_GYRO_RAW"        period="0.05"/>
      <message name="IMU_MAG_RAW"         period="0.05"/>
      <message name="BARO_RAW"            period="0.25"/>
    </mode>
    <mode name="scaled_sensors" key_press="s">
      <message name="DL_VALUE"            period="0.5"/>
      <message name="ALIVE"               period="2.1"/>
      <message name="IMU_GYRO"            period="0.075"/>
      <message name="IMU_ACCEL"           period="0.075"/>
      <message name="IMU_MAG"             period="0.1"/>
    </mode>
    <mode name="debug_imu" key_press="i">
      <message name="ATTITUDE"            period="0.1"/>
      <message name="ALIVE"               period="5.0"/>
      <message name="GPS"                 period="5.1"/>
      <message name="ESTIMATOR"           period="5.3"/>
      <message name="ENERGY"              period="10.1"/>
      <message name="DESIRED"             period="10.2"/>
      <message name="NAVIGATION"          period="5.4"/>
      <message name="PPRZ_MODE"           period="5.5"/>
      <message name="STATE_FILTER_STATUS" period="5.0"/>
      <message name="DATALINK_REPORT"     period="5.7"/>
      <message name="IMU_ACCEL"           period="0.5"/>
      <message name="IMU_GYRO"            period="0.5"/>
      <message name="IMU_MAG"             period="0.5"/>
      <message name="IMU_ACCEL_RAW"       period="0.5"/>
      <message name="IMU_GYRO_RAW"        period="0.5"/>
      <message name="IMU_MAG_RAW"         period="0.5"/>
    </mode>
    <mode name="debug_rc" key_press="c">
      <message name="PPRZ_MODE"           period="1.0"/>
      <message name="PPM"                 period="0.25"/>
      <message name="RC"                  period="0.25"/>
      <message name="COMMANDS"            period="0.25"/>
      <message name="FBW_STATUS"          period="1.0"/>
      <message name="ACTUATORS_RAW"       period="0.5"/>
    </mode>
    <mode name="empty">
    </mode>      
  </process>
    
  <process name="Logger">
    <mode name="default">
      <message name="DL_VALUE"               period="0.5"/>
      <message name="ALIVE"                  period="2.1"/>
      <message name="IMU_GYRO_SCALED"        period="0.017"/>
      <message name="IMU_ACCEL_SCALED"       period="0.017"/>
      <message name="IMU_MAG_SCALED"         period="0.1"/>
    </mode>
  </process>  

  <process name="FlightRecorder">
    <mode name="default">
      <message name="FBW_STATUS"          period="1.2"/>
      <message name="DL_VALUE"            period="0.5"/>
      <message name="IMU_ACCEL"           period="0.05"/>
      <message name="IMU_GYRO"            period="0.05"/>
      <message name="IMU_MAG"             period="0.1"/>
      <message name="IMU_ACCEL_RAW"       period="0.002"/>
      <message name="IMU_GYRO_RAW"        period="0.002"/>
      <message name="IMU_MAG_RAW"         period="0.002"/>
      <message name="COMMANDS"            period=".002"/>
    </mode>
  </process>  
       
  <process name="Fbw">
    <mode name="default">
      <message name="COMMANDS"            period="5.0"/>
      <message name="FBW_STATUS"          period="2.0"/>
      <message name="ACTUATORS_RAW"       period="5.0"/> <!-- For trimming -->
    </mode>
    <mode name="debug">
      <message name="PPM"                 period="0.5"/>
      <message name="RC"                  period="0.5"/>
      <message name="COMMANDS"            period="0.5"/>
      <message name="FBW_STATUS"          period="1.0"/>
      <message name="ACTUATORS_RAW"       period="5.0"/>
    </mode>
  </process>
</telemetry>
