<?xml version="1.0"?>
<?xml-stylesheet href="http://jsbsim.sourceforge.net/JSBSim.xsl" type="text/xsl"?>
<fdm_config name="openuas_jsbsim_zohd_talon_250g" version="2.0" release="BETA"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

    <fileheader>
        <author> Paparazzi UAV / OpenUAS </author>
        <filecreationdate> 2026-07-08 </filecreationdate>
        <version> 2.0 </version>
        <description>
            ZOHD Talon 250G mini foam fixed-wing UAV (pusher, V-tail).
            Wingspan 0.62 m, total lift surface 6.6 dm2 (AR = 5.82),
            length 452 mm, all-up weight 250 g, no landing gear (hand launch
            with motor on, belly lander). Motor 1406-2600KV + 5x5 2-blade
            pusher prop at the tail, 30 A ESC, 2S Li-Ion (8.4 V max, 6.0 V
            min), 4x 4.3 g servos (2 ailerons + 2 ruddervators; modeled as
            equivalent elevator and rudder, V-tail mixing is done by the
            AP/aircraft, not here).
            Airspeed envelope: min 6 m/s (powered), max 16 m/s level.
        </description>
        <reference title="ZOHD Talon 250G specifications"/>
    </fileheader>

    <!-- **********************************************************************
        METRICS  (structural frame: origin at nose tip, x aft, z up)
        ********************************************************************** -->
    <metrics>
        <wingarea unit="FT2">  0.7104 </wingarea>   <!-- 6.6 dm2 = 0.066 m2 total lift surface -->
        <wingspan unit="FT">   2.0341 </wingspan>   <!-- 0.62 m -->
        <chord unit="FT">      0.3492 </chord>      <!-- S/b = 0.1065 m -->
        <htailarea unit="FT2"> 0.0861 </htailarea>  <!-- V-tail horiz. proj. ~0.008 m2 -->
        <htailarm unit="FT">   0.9186 </htailarm>   <!-- 0.28 m -->
        <vtailarea unit="FT2"> 0.0538 </vtailarea>  <!-- V-tail vert. proj. ~0.005 m2 -->
        <vtailarm unit="FT">   0.9186 </vtailarm>   <!-- 0.28 m -->
        <location name="AERORP" unit="IN">
            <x> 4.6 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </location>
        <location name="EYEPOINT" unit="IN">
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </location>
        <location name="VRP" unit="IN">
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </location>
    </metrics>

    <!-- **********************************************************************
        MASS BALANCE  (AUW 250 g = 0.5512 lbs)
        Inertias estimated for a 250 g / 0.62 m span foam pusher
        (battery near CG, motor+prop mass at the tail):
        Ixx = 0.0025, Iyy = 0.0035, Izz = 0.0058 kg*m2
        ********************************************************************** -->
    <mass_balance>
        <ixx unit="SLUG*FT2"> 0.00184 </ixx>
        <iyy unit="SLUG*FT2"> 0.00258 </iyy>
        <izz unit="SLUG*FT2"> 0.00428 </izz>
        <ixy unit="SLUG*FT2"> 0.0 </ixy>
        <ixz unit="SLUG*FT2"> 0.0 </ixz>
        <iyz unit="SLUG*FT2"> 0.0 </iyz>
        <emptywt unit="LBS"> 0.5512 </emptywt>
        <location name="CG" unit="IN">
            <x> 4.5 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </location>
    </mass_balance>

    <!-- **********************************************************************
        GROUND REACTIONS - no landing gear, belly lander:
        structural contact points only (nose, belly, tail, wingtips, fin)
        ********************************************************************** -->
    <ground_reactions>
        <contact type="STRUCTURE" name="NOSE">
            <location unit="IN">
                <x> 0.0 </x>
                <y> 0.0 </y>
                <z> -0.6 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 6 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.3 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="BELLY_FRONT">
            <!-- Estimated 30.5 mm belly footprint; four pads total 180 lb/ft, about 0.93 mm mean static compression. -->
            <location unit="IN">
                <x> 3.0 </x>
                <y> -0.6 </y>
                <z> -1.3 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 45 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.4 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="BELLY_REAR">
            <location unit="IN">
                <x> 9.0 </x>
                <y> -0.6 </y>
                <z> -1.1 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 45 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.4 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="TAIL_SKID">
            <!-- rear fuselage under the pusher prop disk (452 mm length) -->
            <location unit="IN">
                <x> 17.8 </x>
                <y> 0.0 </y>
                <z> -0.5 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 6 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.3 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="LEFT_WINGTIP">
            <location unit="IN">
                <x> 5.5 </x>
                <y> -12.2 </y>
                <z> -0.7 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 6 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.3 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="RIGHT_WINGTIP">
            <location unit="IN">
                <x> 5.5 </x>
                <y> 12.2 </y>
                <z> -0.7 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 6 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.3 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="FIN_TOP">
            <!-- V-tail tips -->
            <location unit="IN">
                <x> 17.0 </x>
                <y> 0.0 </y>
                <z> 1.8 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 6 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.3 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="BELLY_FRONT_RIGHT">
            <location unit="IN">
                <x> 3.0 </x>
                <y> 0.6 </y>
                <z> -1.3 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 45 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.4 </damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="BELLY_REAR_RIGHT">
            <location unit="IN">
                <x> 9.0 </x>
                <y> 0.6 </y>
                <z> -1.1 </z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 45 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 0.4 </damping_coeff>
        </contact>
    </ground_reactions>

    <!-- **********************************************************************
        PROPULSION - PUSHER: 1406-2600KV motor + 5x5 2-blade prop at the tail,
        30 A ESC, 2S Li-Ion (8.4 V max / 6.0 V min).
        The engine below is a zero-power dummy: it only exists so that
        Paparazzi NPS can drive fcs/throttle-cmd-norm (SetThrottleCmd needs
        at least one engine). Real thrust is applied via <external_reactions>
        (see below), because JSBSim's propeller reaction torque is singular
        (power/omega, omega clamped at 0.01) at throttle-up and instantly
        tumbles a 250 g airframe. We took the same approach as the Cyclone model.
        ********************************************************************** -->
    <propulsion>
        <engine file="motor_generic_bl_1406_2600kv.xml">
            <feed>0</feed>
            <thruster file="prop_generic_5x5.xml">
                <location unit="IN">
                    <x> 17.8 </x>
                    <y> 0.0 </y>
                    <z> 0.3 </z>
                </location>
                <orient unit="DEG">
                    <roll> 0.0 </roll>
                    <pitch> 0.0 </pitch>
                    <yaw> 0.0 </yaw>
                </orient>
                <sense> -1 </sense> <!-- pusher -->
                <p_factor>0.0</p_factor>
            </thruster>
        </engine>
        <!-- dummy tank: electric propulsion, avoids "no tank" warning -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 4.5 </x>
                <y> 0.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 0.0001 </capacity>
            <contents unit="LBS"> 0.0 </contents>
        </tank>
    </propulsion>

    <!-- **********************************************************************
        FLIGHT CONTROL SYSTEM
        ********************************************************************** -->
    <flight_control name="FCS: openuas_jsbsim_zohd_talon_250g">

        <channel name="Pitch">
            <summer name="Pitch Trim Sum">
                <input>fcs/elevator-cmd-norm</input>
                <input>fcs/pitch-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
            </summer>
            <aerosurface_scale name="Elevator Control">
                <input>fcs/pitch-trim-sum</input>
                <range>
                    <min>-0.35</min>
                    <max>0.35</max>
                </range>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="Elevator Normalized">
                <input>fcs/elevator-pos-rad</input>
                <domain>
                    <min>-0.35</min>
                    <max> 0.35</max>
                </domain>
                <range>
                    <min>-1</min>
                    <max> 1</max>
                </range>
                <output>fcs/elevator-pos-norm</output>
            </aerosurface_scale>
        </channel>

        <channel name="Roll">
            <summer name="Roll Trim Sum">
                <input>fcs/aileron-cmd-norm</input>
                <input>fcs/roll-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
            </summer>
            <aerosurface_scale name="Left Aileron Control">
                <input>fcs/roll-trim-sum</input>
                <range>
                    <min>-0.35</min>
                    <max>0.35</max>
                </range>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="Right Aileron Control">
                <input>-fcs/roll-trim-sum</input>
                <range>
                    <min>-0.35</min>
                    <max>0.35</max>
                </range>
                <output>fcs/right-aileron-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="Left Aileron Normalized">
                <input>fcs/left-aileron-pos-rad</input>
                <domain>
                    <min>-0.35</min>
                    <max> 0.35</max>
                </domain>
                <range>
                    <min>-1</min>
                    <max> 1</max>
                </range>
                <output>fcs/left-aileron-pos-norm</output>
            </aerosurface_scale>
            <aerosurface_scale name="Right Aileron Normalized">
                <input>fcs/right-aileron-pos-rad</input>
                <domain>
                    <min>-0.35</min>
                    <max> 0.35</max>
                </domain>
                <range>
                    <min>-1</min>
                    <max> 1</max>
                </range>
                <output>fcs/right-aileron-pos-norm</output>
            </aerosurface_scale>
        </channel>

        <!--
            Motor/ESC/prop response lag (~0.1 s time constant), then thrust
            is generated in external_reactions from fcs/throttle-lag.
        -->
        <channel name="Throttle">
            <summer name="Throttle Sum">
                <input>fcs/throttle-cmd-norm</input>
                <clipto>
                    <min>0</min>
                    <max>1</max>
                </clipto>
            </summer>
            <lag_filter name="Throttle Lag">
                <input>fcs/throttle-sum</input>
                <c1>10.0</c1>
                <output>fcs/throttle-lag</output>
            </lag_filter>
        </channel>

        <channel name="Yaw">
            <summer name="Rudder Command Sum">
                <input>fcs/rudder-cmd-norm</input>
                <input>fcs/yaw-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
            </summer>
            <aerosurface_scale name="Rudder Control">
                <input>fcs/rudder-command-sum</input>
                <range>
                    <min>-0.44</min>
                    <max>0.44</max>
                </range>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="Rudder Normalized">
                <input>fcs/rudder-pos-rad</input>
                <domain>
                    <min>-0.44</min>
                    <max> 0.44</max>
                </domain>
                <range>
                    <min>-1</min>
                    <max> 1</max>
                </range>
                <output>fcs/rudder-pos-norm</output>
            </aerosurface_scale>
        </channel>

        <channel name="Spoileron Brake">
            <summer name="Spoileron Brake Command">
                <input>-fcs/brake-cmd-norm</input>
                <clipto>
                    <min>0</min>
                    <max>1</max>
                </clipto>
                <output>fcs/speedbrake-pos-norm</output>
            </summer>
        </channel>

    </flight_control>

    <!-- **********************************************************************
        THRUST (external reaction, replaces the singular propeller model)
        Pusher: 1406-2600KV + 5x5 prop on 2S Li-Ion (7.2 V nominal under load,
        sag to 6.0 V). Static thrust 2.5 N (~255 gf, T/W = 1.0: brisk
        hand-toss launch with motor on). Thrust decays with airspeed and
        crosses airframe drag (0.40 N) at 16 m/s => level Vmax = 16 m/s,
        near zero at ~20 m/s effective pitch speed (Li-Ion sag included),
        mild windmill braking beyond.
        Applied at the tail (x = 17.8 in, z = 0.3 in): power-on gives the
        characteristic slight nose-down trim change of a high pusher.
        Expressed in LBS versus axial airspeed u (fps).
        ********************************************************************** -->
    <external_reactions>
        <property value="0">fcs/brake-cmd-norm</property>
        <property>fcs/throttle-lag</property>

        <force name="prop-thrust" frame="BODY" unit="LBS">
            <function>
                <product>
                    <property>fcs/throttle-lag</property>
                    <table>
                        <independentVar>velocities/u-aero-fps</independentVar>
                        <tableData>
                              0.0    0.5620
                             13.1    0.4830
                             26.2    0.3710
                             39.4    0.2360
                             45.9    0.1680
                             52.5    0.1050
                             69.0    0.0000
                             98.4   -0.0112
                        </tableData>
                    </table>
                </product>
            </function>
            <location unit="IN">
                <x> 17.8 </x>
                <y> 0.0 </y>
                <z> 0.3 </z>
            </location>
            <direction>
                <x> 1.0 </x>
                <y> 0.0 </y>
                <z> 0.0 </z>
            </direction>
        </force>
    </external_reactions>

    <!-- **********************************************************************
        AERODYNAMICS
        Sized from: m = 0.25 kg, S = 0.066 m2 (total lift surface),
        b = 0.62 m, AR = 5.82
        CLalpha = 2*pi/(1 + 2/AR) = 4.68 /rad
        CLmax = 1.50 at alpha = 16.5 deg -> 1-g stall 6.4 m/s, powered min
        speed ~6 m/s (prop thrust unloads the wing at high alpha)
        CD0 = 0.035, k = 1/(pi*AR*e), e = 0.80  ->  k = 0.0683
        Drag at 16 m/s = 0.40 N = full-throttle thrust  ->  Vmax = 16 m/s
        ********************************************************************** -->
    <aerodynamics>

        <axis name="DRAG">
            <function name="aero/coefficient/CD0">
                <description>Drag_at_zero_lift</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>aero/alpha-rad</independentVar>
                        <tableData>
                            -1.5700   1.3000
                            -0.3000   0.0650
                             0.0000   0.0350
                             0.3000   0.0650
                             1.5700   1.3000
                        </tableData>
                    </table>
                </product>
            </function>
            <!-- Provisional symmetric spoileron model. Replace these
                 coefficients with high-altitude brake-pulse measurements. -->
            <function name="aero/coefficient/CD_spoileron">
                <description>Drag due to symmetric upward ailerons</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>fcs/speedbrake-pos-norm</property>
                    <value>0.10</value>
                </product>
            </function>
            <function name="aero/coefficient/CDi">
                <description>Induced_drag</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/cl-squared</property>
                    <value>0.0683</value>
                </product>
            </function>
            <function name="aero/coefficient/CDbeta">
                <description>Drag_due_to_sideslip</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>aero/beta-rad</independentVar>
                        <tableData>
                            -1.5700   1.0000
                            -0.2600   0.0300
                             0.0000   0.0000
                             0.2600   0.0300
                             1.5700   1.0000
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/coefficient/CDde">
                <description>Drag_due_to_Elevator_Deflection</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <abs><property>fcs/elevator-pos-norm</property></abs>
                    <value>0.0200</value>
                </product>
            </function>
        </axis>

        <axis name="SIDE">
            <function name="aero/coefficient/CYb">
                <description>Side_force_due_to_beta</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/beta-rad</property>
                    <value>-0.3000</value>
                </product>
            </function>
        </axis>

        <axis name="LIFT">
            <function name="aero/coefficient/CLalpha">
                <description>Lift_due_to_alpha</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>aero/alpha-rad</independentVar>
                        <tableData>
                            -0.3000  -0.7000
                            -0.2000  -0.7850
                             0.0000   0.1500
                             0.2900   1.5000
                             0.3500   1.2600
                             0.5200   0.9500
                             0.9000   0.5500
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/coefficient/CL_spoileron">
                <description>Lift loss due to symmetric upward ailerons</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>fcs/speedbrake-pos-norm</property>
                    <value>-0.15</value>
                </product>
            </function>
            <function name="aero/coefficient/CLde">
                <description>Lift_due_to_Elevator_Deflection</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>fcs/elevator-pos-rad</property>
                    <value>0.3000</value>
                </product>
            </function>
        </axis>

        <axis name="ROLL">
            <function name="aero/coefficient/Clb">
                <description>Roll_moment_due_to_beta</description>
                <!-- polyhedral wing: solid dihedral effect -->
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/beta-rad</property>
                    <value>-0.0900</value>
                </product>
            </function>
            <function name="aero/coefficient/Clp">
                <description>Roll_moment_due_to_roll_rate</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/p-aero-rad_sec</property>
                    <value>-0.4500</value>
                </product>
            </function>
            <function name="aero/coefficient/Clr">
                <description>Roll_moment_due_to_yaw_rate</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/r-aero-rad_sec</property>
                    <value>0.1200</value>
                </product>
            </function>
            <function name="aero/coefficient/Clda">
                <description>Roll_moment_due_to_aileron</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/left-aileron-pos-rad</property>
                    <value>0.1300</value>
                </product>
            </function>
            <function name="aero/coefficient/Cldr">
                <description>Roll_moment_due_to_rudder</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/rudder-pos-rad</property>
                    <value>0.0100</value>
                </product>
            </function>
        </axis>

        <axis name="PITCH">
            <function name="aero/coefficient/Cm0">
                <description>Pitch_moment_at_zero_alpha</description>
                <!-- set so neutral-elevator trim is alpha ~6.5 deg = 9.5 m/s:
                     a hand-tossed launch (8 m/s, motor on) climbs away
                     hands-off, like the real airframe -->
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <value>0.0567</value>
                </product>
            </function>
            <function name="aero/coefficient/Cmalpha">
                <description>Pitch_moment_due_to_alpha</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>aero/alpha-rad</property>
                    <value>-0.5000</value>
                </product>
            </function>
