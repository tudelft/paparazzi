<?xml version="1.0"?>
<!--
    INERT placeholder propeller (5x5 2-blade pusher) for the
    openuas_jsbsim_zohd_talon_250g model.
    C_THRUST and C_POWER are zero on purpose: the real thrust (including
    windmill braking above effective pitch speed) is modeled as an external
    reaction in OPENUAS/openuas_jsbsim_zohd_talon_250g.xml. A live JSBSim
    propeller cannot be used on a 250 g airframe because the engine spin-up
    reaction torque (power/omega with omega clamped at 0.01 rad/s) instantly
    tumbles it.
-->
<propeller name="prop 5x5 inert">
  <ixx> 0.0001 </ixx>
  <diameter unit="IN"> 5.0 </diameter>
  <numblades> 2 </numblades>
  <minpitch> 23 </minpitch> <!-- 5 in pitch at 75% radius -->
  <maxpitch> 23 </maxpitch>
  <minrpm> 0 </minrpm>
  <maxrpm> 22000 </maxrpm> <!-- 2600KV * 8.4V no-load -->

  <table name="C_THRUST" type="internal">
    <tableData>
      0.0   0.0
      1.2   0.0
    </tableData>
  </table>

  <table name="C_POWER" type="internal">
    <tableData>
      0.0   0.0
      1.2   0.0
    </tableData>
  </table>

</propeller>
