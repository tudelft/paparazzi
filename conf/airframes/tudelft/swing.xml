<!DOCTYPE airframe SYSTEM "../airframe.dtd">

<airframe name="Swing">

    <firmware name="rotorcraft">
        
        <autopilot name="swing_autopilot"/>

        <define name="IMU_SWING_PERIODIC_FREQ" value="500"/>
        <configure name="PERIODIC_FREQUENCY"   value="500"/> <!-- use configure here, define produces mult redefinitions -->

        <configure name="PREFIX" value="/opt/arm-2012.03/bin/arm-none-linux-gnueabi-"/>
        <configure name="USE_BARO_BOARD" value="FALSE"/>

        <target name="ap" board="parrot_minidrone">
            <configure name="USE_MAGNETOMETER" value="FALSE"/>

            <!-- ins configured for optitrack -->
            <define name="INS_VFF_R_GPS" value="0.01"/>
            <define name="INS_USE_GPS_ALT" value="TRUE"/>
            <define name="USE_BARO_BOARD" value="FALSE"/>
        
            <!-- Use GPS heading instead of magneto-->
            <define name="AHRS_USE_GPS_HEADING" value="TRUE"/>
            <define name="AHRS_HEADING_UPDATE_GPS_MIN_SPEED" value="0"/>
            <define name="USE_BARO" value="FALSE"/>    

            <!-- In case of cyberzoo + NO optitrack for quick manual test flight -->
            <!-- <define name="AHRS_USE_GPS_HEADING" value="FALSE"/> -->
            <!-- <define name="AHRS_FLOATING_HEADING" value="TRUE"/> -->

            <module name="sys_mon"/>

            <module name="logger_file">
                <define name="LOGGER_FILE_PATH" value="/data/ftp/internal_000/log"/>
                <configure name="LOGGER_FILE_FREQUENCY" value="500"/>
            </module>
        </target>

        <target name="nps" board="pc">
            <module name="fdm" type="jsbsim"/>
            <module name="udp"/>
            <configure name="USE_MAGNETOMETER" value="TRUE"/>
            <define name="AHRS_USE_GPS_HEADING" value="FALSE"/>

            <module name="logger_file">
                <define name="LOGGER_FILE_PATH" value="/home/ntouev/LOGS/swing/nps/"/>
                <configure name="LOGGER_FILE_FREQUENCY" value="500"/>
            </module>

        </target>

        <!-- common modules -->
        <module name="ins" type="extended"/>
        <module name="telemetry" type="transparent_udp"/>
        <module name="radio_control" type="datalink"/>
        <module name="actuators" type="parrot_minidrone"/>
        <module name="imu" type="parrot_minidrone"/>
        <module name="gps" type="datalink"/>
        <module name="stabilization" type="indi"/>
        <module name="ahrs" type="int_cmpl_quat"/>
        <module name="air_data"/> <!-- needed? -->
        
        <module name="flatness_stabilization"/>
        <module name="flatness_guidance"/>

    </firmware>

    <commands>
        <axis name="TOP_LEFT"     group="REAL"    failsafe_value="0"/>
        <axis name="TOP_RIGHT"    group="REAL"    failsafe_value="0"/>
        <axis name="BOTTOM_RIGHT" group="REAL"    failsafe_value="0"/>
        <axis name="BOTTOM_LEFT"  group="REAL"    failsafe_value="0"/>
        <axis name="THRUST"       group ="OTHER"  failsafe_value="0"/> 
    </commands>

    <servos>
        <servo name="TOP_RIGHT"     no="0" min="0" neutral="15" max="511"/>
        <servo name="BOTTOM_RIGHT"  no="1" min="0" neutral="15" max="511"/>
        <servo name="TOP_LEFT"      no="2" min="0" neutral="15" max="511"/>
        <servo name="BOTTOM_LEFT"   no="3" min="0" neutral="15" max="511"/>
    </servos>

    <command_laws>
        <set servo="TOP_LEFT"     value="autopilot.motors_on ? actuators_pprz[COMMAND_TOP_LEFT]     : -MAX_PPRZ"/>
        <set servo="TOP_RIGHT"    value="autopilot.motors_on ? actuators_pprz[COMMAND_TOP_RIGHT]    : -MAX_PPRZ"/>
        <set servo="BOTTOM_RIGHT" value="autopilot.motors_on ? actuators_pprz[COMMAND_BOTTOM_RIGHT] : -MAX_PPRZ"/>
        <set servo="BOTTOM_LEFT"  value="autopilot.motors_on ? actuators_pprz[COMMAND_BOTTOM_LEFT]  : -MAX_PPRZ"/>
    </command_laws>

    <section name="IMU" prefix="IMU_">
        <!-- Accelero -->
        <!-- <define name="ACCEL_X_NEUTRAL" value="2048"/>
        <define name="ACCEL_Y_NEUTRAL" value="2048"/>
        <define name="ACCEL_Z_NEUTRAL" value="2048"/> -->
        <!-- Magneto calibration -->
        <define name="MAG_X_NEUTRAL" value="18"/>
        <define name="MAG_Y_NEUTRAL" value="157"/>
        <define name="MAG_Z_NEUTRAL" value="49"/>
        <define name="MAG_X_SENS" value="10.5007722373" integer="16"/>
        <define name="MAG_Y_SENS" value="11.1147400462" integer="16"/>
        <define name="MAG_Z_SENS" value="11.6479371722" integer="16"/>

        <!-- Magneto current calibration -->
        <define name="MAG_X_CURRENT_COEF" value="0.0"/>
        <define name="MAG_Y_CURRENT_COEF" value="0.0"/>
        <define name="MAG_Z_CURRENT_COEF" value="0.0"/>

        <define name="BODY_TO_IMU_PHI" value="0." unit="deg"/>
        <define name="BODY_TO_IMU_THETA" value="90." unit="deg"/>
        <define name="BODY_TO_IMU_PSI" value="0." unit="deg"/>
    </section>

    <!-- local magnetic field -->
    <section name="AHRS" prefix="AHRS_">
        <!-- Delft -->
        <define name="H_X" value="0.3892503"/>
        <define name="H_Y" value="0.0017972"/>
        <define name="H_Z" value="0.9211303"/>
    </section>

    <section name="RC_SETPOINT" prefix="STABILIZATION_ATTITUDE_">
        <define name="SP_MAX_PHI" value="45" unit="deg"/>
        <define name="SP_MAX_THETA" value="45" unit="deg"/>
        <define name="SP_MAX_R" value="400" unit="deg/s"/>
        <define name="DEADBAND_A" value="0"/>
        <define name="DEADBAND_E" value="0"/>
        <define name="DEADBAND_R" value="50"/>
    </section>

    <section name="STABILIZATION_ATTITUDE_INDI" prefix="STABILIZATION_INDI_">
        <define name="G1_ROLL" value="{30 , -30, -30 , 30 }"/>
        <define name="G1_PITCH" value="{30 , 30, -30 , -30 }"/>
        <define name="G1_YAW" value="{-1, 1, -1, 1}"/>
        <define name="G1_THRUST" value="{-.2, -.2, -.2, -.2}"/>
        <define name="G2" value="{0, 0, 0, 0}"/>

        <define name="ACT_FREQ" value="{53.9, 53.9, 53.9, 53.9}"/>

        <define name="REF_ERR_P" value="90.0"/>
        <define name="REF_ERR_Q" value="90.0"/>
        <define name="REF_ERR_R" value="50.0"/>
        <define name="REF_RATE_P" value="20.0"/>
        <define name="REF_RATE_Q" value="20.0"/>
        <define name="REF_RATE_R" value="20.0"/>

        <define name="ESTIMATION_FILT_CUTOFF" value="4.0"/>
        <define name="FILT_CUTOFF" value="5"/>

        <!-- Adaptive Learning Rate -->
        <define name="USE_ADAPTIVE" value="FALSE"/>
        <define name="ADAPTIVE_MU" value="0.0001"/>

        <!--Priority for each axis (roll, pitch, yaw and thrust)-->
        <define name="WLS_PRIORITIES" value="{1000, 1000, 1, 100}"/>
    </section>

    <section name="SIMULATOR" prefix="NPS_">
        <define name="ACTUATOR_NAMES" value="nw_motor, ne_motor, se_motor, sw_motor" type="string[]"/>
        <define name="COMMANDS_NB" value="4"/>
        <define name="JSBSIM_MODEL" value="bebop" type="string"/>
        <define name="NO_MOTOR_MIXING" value="TRUE"/>
    </section>

    <section name="BAT">
        <define name="CATASTROPHIC_BAT_LEVEL" value="3.1" unit="V"/>
        <define name="CRITIC_BAT_LEVEL" value="3.3" unit="V"/>
        <define name="LOW_BAT_LEVEL" value="3.5" unit="V"/>
        <define name="MAX_BAT_LEVEL" value="4.1" unit="V"/>
    </section>

</airframe>
