  <command_laws>
    <!-- Apply cubic polynomial scaling, better suited for manual RC control then real exponential, but most tend to call it "Expo", so we adhere :) -->
    <!-- Not realtime in flight ajustable(yet), could be mapped to RC input channel like a digital trim up/down -->
    <!-- e.g. 0.5 represents 50% adjustment -->
    <let var="expo_pct_roll" value="0.9f"/> 
    <let var="expo_pct_pitch" value="0.5f"/>
    <!-- Determine if "Exponential" scaling should be applied, e.g., only in Manual RC mode -->
    <!-- <let var="use_scaling" value="(1 > AP_MODE ? 1 : 0)"/> -->
    <let var="use_scaling" value="1"/><!--TEMP -->
    <!-- Normalize ROLL/PITCH values to a range of -1 to 1 -->
    <!-- 0.00010416666f is 1/9600, so 1/command range, only in case 9600 is the MAX PPRZ value default -->
    <let var="norm_roll"  value="@ROLL * 0.00010416666f"/>
    <let var="norm_pitch" value="@PITCH * 0.00010416666f"/>
    <let var="expo_roll"  value="$use_scaling = 1 ? ($norm_roll * (1 - abs($expo_pct_roll)) + powf($norm_roll, 3) * $expo_pct_roll) : @ROLL"/>
    <let var="expo_pitch" value="$use_scaling = 1 ? ($norm_pitch * (1 - abs($expo_pct_pitch)) + powf($norm_pitch, 3) * $expo_pct_pitch) : @PITCH"/> 

    <let var="aileron"    value="($expo_roll * ELEVON_ROLL_FACTOR)"/>
    <let var="elevator"   value="($expo_pitch * ELEVON_PITCH_FACTOR)"/>
    
    <let var="leftyaw" value="(@YAW >= 0 ? 0 : 1)"/>
    <let var="rightyaw" value="(1 - $leftyaw)"/>
    <!-- opposite of left -->
    <let var="rudderleft" value="-(@YAW * $leftyaw) * ELEVON_YAW_FACTOR"/>
    <let var="rudderright" value="(@YAW * $rightyaw) * ELEVON_YAW_FACTOR"/>
    <set servo="S_THROTTLE" value="@THROTTLE"/>
    <set servo="S_ELEVON_LEFT" value="$elevator - $aileron + $rudderleft"/>
    <set servo="S_ELEVON_RIGHT" value="$elevator + $aileron + $rudderright"/>
  </command_laws>
    
