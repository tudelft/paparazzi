    <define name="ASSIST_ROLL_WITH_RUDDER" value="0.0"/>
    <define name="AILERON_DIFF" value="0.3"/>
    <define name="BRAKEGAIN" value="0.0"/><!-- Optional gain for (spoileron) braking mix with elevator -->
  </section>

  <command_laws>
    <let var="rc_gain_gyro" value="1.0"/><!--(@GAIN1/PPRZ_MAX) Not used yet could be RC input gain slider -->
    <let var="k_rudder_gyro" value="8.0 * $rc_gain_gyro"/><!--gain from yaw rate to rudder-->
    <let var="gyro_active" value="(1 > AP_MODE ? 0 : 1)"/>
    <let var="gyro_yaw" value="$gyro_active * (stateGetBodyRates_i()->r)"/>
    <let var="yaw_ctrl_sgl" value="@YAW - ($k_rudder_gyro * ($gyro_yaw)) - @ROLL * ASSIST_ROLL_WITH_RUDDER"/>
    <set servo="S_THROTTLE" value="@THROTTLE"/>
    <set servo="S_AILERON_LEFT" value="@ROLL+(BRAKEGAIN*SPOILERON_BRAKE_FULL)"/>
    <set servo="S_AILERON_RIGHT" value="@ROLL+(BRAKEGAIN*SPOILERON_BRAKE_FULL)"/><!-- Same as left since with same PWM value already reverse direction-->
    <set servo="S_ELEVATOR" value="@PITCH+(-BRAKEGAIN*SPOILERON_BRAKE_FULL)"/><!--TODO add correct value spoileron braking mix-->
    <set servo="S_RUDDER" value="$yaw_ctrl_sgl"/>
    <set servo="S_LIGHT" value="((autopilot.mode == AP_MODE_AUTO2) ? MAX_PPRZ : @ACTIVELIGHTS)"/>
  </command_laws>

