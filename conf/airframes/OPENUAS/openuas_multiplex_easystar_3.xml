<!DOCTYPE airframe SYSTEM "../airframe.dtd">
<airframe name="Easystar3">
  <description>
    Basic fixedwing airframe equipped with flightcontroller hardware

    + MODEL:        Multiplex Easystar III Yellow edition
    + FC:           Lisa MX v2.1
    + ACTUATORS:    Default of set MS-12020-MG
    + GNSS          uBlox M10
    + IMU           Default Aspirin v2.1 
    + MAGNETOMETER: QMC5883L on GNSS module, optionally RM3100
    + ESC:          Default of set ROXXY BL-Control 720 S-BEC ESC
    + RCRX:         OpenRXSR Receiver
    + AIRSPEED:     Sensirion SDP33
    + BARO          Bosch BMP085
    + TELEMETRY:    eByte E52-400NW22S
    + CURRENT:      N/A
    + RANGEFINDER:  Surertech VB22A
    + MOTOR:        Default of set ROXXY BL Outrunner C28-30 1100kV
    + PROPPELLER:   Default Foldable 7" x 6" two bladed

    NOTES:
    + Servo pins point to aft(tail) of airframe
    + SBus output on receiver MUST modified to have un-inverted output, this F4 cannot do it in software
      This is done by soldering the RX SBus output wire on pad B of the OpenRXSR RC recever
    + Servos powered via BEC of ESC outputs 5.0V
    + Flightcontroller powered via servo rail
    + JP8 Closed and JP9 Opened so on UART1_VCC and UART5 is V_IN, thus 5V to RCRX and UWB module
    + Telemetry modem powered via V/GND pins of UART on FC is 3.3V
    + Uploading of the firmware via SWD (useing a BlackMagicProbe debug adapter)
    + A GNSS device with QMC5883L magnetometer on the same PCB
    + GNSS on UART3 set to ~17Hz update rate, 3 constelations, SBAS enabled
    + Advised battery for this airframe is a 2200mAh 3S LiPo min. 20C
    + If testing "Classic" (as in not ETECS..) make sure to disable the settings/estimation/ac_char
    + One could set the USE_AIRSPEED value to FALSE at first, for no airspeed tests
    + Make sure v7.0 or higher of PPRZ autopilot release is used
    + SBUS receiver output must be set to non-inverted, this is done by soldering the RX SBus output wire on pad B of the OpenRXSR RC recever
    + SBUS RC RX on UART1 
    + Telemetry on UART2 , use B9600 baudrate if using mesh network module else B57600
    + UWB serial data via UART5 RX and TX (PC12)
    + Additional RM3100 Magnetometer to compare with the QMC5883L
  </description>

  <firmware name="fixedwing">

    <configure name="PERIODIC_FREQUENCY" value="500"/>
    <configure name="AHRS_PROPAGATE_FREQUENCY" value="$(PERIODIC_FREQUENCY)"/>
    <configure name="AHRS_CORRECT_FREQUENCY" value="$(PERIODIC_FREQUENCY)"/>
    <configure name="NAVIGATION_FREQUENCY" value="20"/>
    <configure name="CONTROL_FREQUENCY" value="100"/>
    <configure name="TELEMETRY_FREQUENCY" value="50"/>
    <configure name="MODULES_FREQUENCY" value="$(PERIODIC_FREQUENCY)"/>
    <configure name="MAG_QMC5883L_PERIODIC_FREQUENCY" value="200"/>
    <!-- Keep AHRS mag timing sample-based so delayed or dropped samples use the correct dt. -->

    <target name="ap" board="lisa_mx_2.1_chibios">

      <!-- Enable those two lines below ONLY if flashing via JTAG cable -->
      <configure name="FLASH_MODE"   value="SWD"/>
      <!-- <configure name="BMP_PORT" value="/dev/ttyACM0"/> -->
      <configure name="NO_LUFTBOOT" value="1"/><!-- We do not have a bootloader on this FC -->
      <!--<define name="DEBUG" value="TRUE"/>--><!--Enable for debug output, e.g. ms5611-->
      <!--<define name="USE_PERIODIC_TELEMETRY_REPORT" value="TRUE"/> -->

      <!-- <define name="USE_PERSISTENT_SETTINGS" value="TRUE"/> --><!-- FIXME: Not working under Chibios -->

      <!-- <configure name="AHRS_MAG_CORRECT_FREQUENCY" value="200"/> --><!-- set to 200 if using QMC?-->
      <configure name="USE_MAGNETOMETER" value="FALSE"/><!-- If FALSE keep acquisition enabled, but use GNSS course for AHRS yaw initially -->

<!-- ***** First sensor modules... ***** -->
      
      <module name="imu" type="lisa_mx_v2.1">
        <define name="ASPIRIN_2_DISABLE_MAG" value="TRUE"/>
        <!-- <define name="LISA_M_OR_MX_21" value="TRUE"/> -->
        <define name="LISA_M_OR_MX21_ROTATED_180_DEG" value="TRUE"/>
      </module>

      <module name="baro_bmp">
         <!-- <configure name="BARO_PERIODIC_FREQUENCY" value="15"/> -->
         <configure name="BMP_I2C_DEV" value="i2c2"/>
         <configure name="USE_BARO_BOARD" value="TRUE"/>
         <!-- <configure name="INS_BARO_ID" value="BARO_BMP_SENDER_ID"/> -->
         <define name="USE_BARO_MEDIAN_FILTER" value="TRUE"/>
         <!-- <define name="SENSOR_SYNC_SEND" value="TRUE"/>  -->
      </module>

      <module name="airspeed" type="sdp3x">
        <configure name="SDP3X_I2C_DEV" value="i2c2"/>
        <!-- SDP33: signed output, 20 counts/Pa, +/-1500 Pa (about 49.5 m/s EAS at MSL). -->
        <define name="SDP3X_PRESSURE_SCALE" value="SDP3X_SCALE_PRESSURE_SDP33"/>
        
        <define name="SDP3X_VERIFY_PRESSURE_SCALE" value="TRUE"/><!-- Reject data if the sensor does not report the expected SDP33 scale. -->
        <!-- Installed pitot port order produces negative raw pressure for forward airflow. -->
        <define name="SDP3X_DYNAMIC_PRESSURE_SWAPPED" value="TRUE"/>
        <!-- <define name="USE_AIRSPEED_LOWPASS_FILTER" value="FALSE"/> --><!-- TRUE per default -->
        <!-- Filter pressure at about 1 Hz; the published airspeed remains in m/s. -->
        <define name="SDP3X_LOWPASS_TAU" value="0.13"/><!-- 0.15 is the default, but consider upto 0.10 if logs show noticeable airspeed-control lag-->
        <define name="USE_AIRSPEED_SDP3X" value="TRUE"/>
        <!-- <define name="USE_AIRSPEED" value="TRUE"/> --><!-- automaticaly set with one above -->
        <!-- <define name="SDP3X_SYNC_SEND" value="TRUE"/> --><!-- Disable after debugging; sends unfiltered samples at 100 Hz. -->
      </module>

      <!-- Magnetometer chip available on GNSS board --> 
      <module name="mag" type="qmc5883l">
        <configure name="MAG_QMC5883L_I2C_DEV" value="i2c2"/>
        <define name="QMC5883L_ADDR" value="0x1A"/>
        <define name="MODULE_QMC5883L_UPDATE_AHRS" value="TRUE"/>
        <define name="QMC5883L_CHAN_X" value="0"/><!--TODO: REvalidate -->
        <define name="QMC5883L_CHAN_Y" value="1"/><!--TODO: REvalidate -->
        <define name="QMC5883L_CHAN_Z" value="2"/>
        <define name="QMC5883L_CHAN_X_SIGN" value="+"/>
        <define name="QMC5883L_CHAN_Y_SIGN" value="-"/>
        <define name="QMC5883L_CHAN_Z_SIGN" value="-"/>
      </module>

      <!-- Build into the airframe is a rangfinder Surertech VB22A 0xA4 (0x52 7bit) -->
      <module name="rangefinder_i2c"> 
        <configure name="RANGEFINDER_I2C_PORT" value="i2c2"/>
        <configure name="RANGEFINDER_I2C_ADDR" value="0xA4"/> <!-- 0x52 in 7 bit -->
        <configure name="RANGEFINDER_I2C_USE_FOR_AGL" value="TRUE"/>
        <configure name="RANGEFINDER_I2C_COMPENSATE_ROTATION" value="TRUE"/>
        <configure name="RANGEFINDER_I2C_PERIODIC_FREQUENCY" value="100"/><!-- 200Hz possible according to datasheet -->
        <define name="RANGEFINDER_I2C_USE_FILTER" value="FALSE"/><!-- not always needed VB22A filters internally quite well -->
        <define name="RANGEFINDER_I2C_MEDIAN_SIZE" value="5"/>
        <define name="RANGEFINDER_I2C_MIN_RANGE" value="0.005" unit="m"/>
        <define name="RANGEFINDER_I2C_MAX_RANGE" value="8.0" unit="m"/><!-- For e.g. VB22A Theoretically 20m at 90% reflectivity in daylight real useful range ~ 8m upto 0m-->
        <define name="RANGEFINDER_I2C_OFFSET" value="0.0" unit="m"/>
        <define name="RANGEFINDER_I2C_SCALE" value="0.001"/><!-- Since VB22A sensor is set to emit in millimeters per default-->
        <define name="RANGEFINDER_I2C_READ_MODE_SINGLE" value="0x00"/><!-- Specifically to read for a VB22A sensor -->
        <!-- <define name="RANGEFINDER_I2C_SYNC_SEND" value="TRUE"/> --><!-- Only enable while debugging via fast connetion, NOT mesh -->
      </module>

      <module name="gps" type="ublox">
        <configure name="GPS_BAUD" value="B460800"/>
        <configure name="GPS_PORT" value="UART4"/><!-- Note that the GPS is on UART3 since UART4 is not re-mapped -->
      </module>

<!-- ***** ...then the rest ***** -->

      <module name="actuators" type="pwm">
        <define name="SERVO_HZ" value="40"/><!-- not higher than 40 else lightcontroller does not work -->
        <define name="USE_SERVOS_7AND8"/>
      </module>

      <module name="radio_control" type="sbus">
        <configure name="SBUS_PORT" value="UART1"/>
        <define name="RADIO_CONTROL_NB_CHANNEL" value="16"/>
      </module>

      <module name="telemetry" type="transparent">
        <!--<configure name="MODEM_PORT" value="usb_serial"/>--><!--USB Serial used for easier benchtest only -->
        <!-- EByte E52-400NW22S LoRa MESH. The modem UART must run far faster
             than the 62.5 kbps air rate so that a frame is inside the modem
             before its transmit slot opens: 460800 baud puts the largest
             38 byte frame on the wire in 0.82 ms. -->
        <!-- 
        <configure  name="MODEM_BAUD" value="B460800"/>
        <configure  name="MODEM_PORT" value="UART3"/>
         -->

