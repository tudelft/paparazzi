      <module name="mag" type="qmc5883l">
        <configure name="MAG_QMC5883L_I2C_DEV" value="i2c1"/>
        <define name="QMC5883L_ADDR" value="0x1A"/>
        <define name="MODULE_QMC5883L_UPDATE_AHRS" value="FALSE"/>
        <define name="QMC5883L_CHAN_X" value="0"/>
