      <module name="imu" type="icm42688">
        <configure name="IMU_SPI_DEV" value="spi1"/>
        <configure name="IMU_SPI_SLAVE_IDX" value="SPI_SLAVE0"/>
        <configure name="IMU_ODR" value="1KHZ"/>
        <configure name="GYRO_RANGE" value="2000DPS"/>
        <configure name="ACCEL_RANGE" value="16G"/>
        <!-- The 500Hz module service forwards the last of two 1kHz FIFO samples.
        Filter the 277-364Hz motor and 555-728Hz blade-pass bands before decimation. -->
        <configure name="GYRO_AAF" value="126"/>
        <configure name="ACCEL_AAF" value="84"/>
        <!-- Verified alignment after rotating the FC 90 degrees counterclockwise. -->
        <define name="IMU_ICM42688_CHAN_X" value="0"/>
        <define name="IMU_ICM42688_CHAN_Y" value="1"/>
        <define name="IMU_ICM42688_CHAN_Z" value="2"/>
        <define name="IMU_ICM42688_X_SIGN" value="-"/>
        <define name="IMU_ICM42688_Y_SIGN" value="-"/>
        <define name="IMU_ICM42688_Z_SIGN" value="+"/>
      </module>

      <module name="baro" type="dps310">
        <configure name="DPS310_I2C_PORT" value="i2c1"/>
        <define name="DPS310_SLAVE_ADDR" value="DPS310_I2C_ADDR_ALT"/>
