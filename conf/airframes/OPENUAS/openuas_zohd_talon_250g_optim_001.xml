      <module name="airspeed" type="sdp3x">
        <configure name="SDP3X_I2C_DEV" value="i2c1"/>
        <!-- SDP33: signed output, 20 counts/Pa, +/-1500 Pa (about 49.5 m/s EAS at MSL). -->
        <define name="SDP3X_PRESSURE_SCALE" value="SDP3X_SCALE_PRESSURE_SDP33"/>
        <define name="SDP3X_VERIFY_PRESSURE_SCALE" value="TRUE"/><!-- Reject data if the sensor does not report the expected SDP33 scale. -->
        <!-- Installed pitot port order produces negative raw pressure for forward airflow. -->
        <define name="SDP3X_DYNAMIC_PRESSURE_SWAPPED" value="TRUE"/>
        <!-- <define name="USE_AIRSPEED_LOWPASS_FILTER" value="FALSE"/> --><!-- TRUE per default -->
        <!-- Filter pressure at about 1 Hz; the published airspeed remains in m/s. -->
        <define name="SDP3X_LOWPASS_TAU" value="0.15"/><!-- 0.15 is the default, but consider upto 0.10 if logs show noticeable airspeed-control lag-->
        <define name="USE_AIRSPEED_SDP3X" value="TRUE"/>
        <!-- <define name="USE_AIRSPEED" value="TRUE"/> --><!-- automaticaly set with one above -->
        <!--<define name="SDP3X_SYNC_SEND" value="TRUE"/>--><!-- Disable after debugging; sends unfiltered samples at 100 Hz. -->
      </module>

      <!-- Build into the airframe is a rangfinder Surertech VB22A 0xA4 (0x52 7bit) -->
      <module name="rangefinder_i2c"> 
        <configure name="RANGEFINDER_I2C_PORT" value="i2c1"/>
        <configure name="RANGEFINDER_I2C_ADDR" value="0xA4"/> <!-- 0x52 in 7 bit -->
        <configure name="RANGEFINDER_I2C_USE_FOR_AGL" value="TRUE"/>
        <configure name="RANGEFINDER_I2C_COMPENSATE_ROTATION" value="TRUE"/>
        <configure name="RANGEFINDER_I2C_PERIODIC_FREQUENCY" value="100"/><!-- 200Hz possible according to datasheet -->
        <define name="RANGEFINDER_I2C_USE_FILTER" value="FALSE"/><!-- not always needed VB22A filters internally quite well -->
        <define name="RANGEFINDER_I2C_MEDIAN_SIZE" value="5"/>
        <define name="RANGEFINDER_I2C_MIN_RANGE" value="0.005" unit="m"/>
        <define name="RANGEFINDER_I2C_MAX_RANGE" value="8.0" unit="m"/><!-- For e.g. VB22A Theoretically 20m at 90% reflectivity in daylight real useful range ~ 8m upto 0m-->
        <define name="RANGEFINDER_I2C_OFFSET" value="0.0" unit="m"/>
        <define name="RANGEFINDER_I2C_SCALE" value="0.001"/><!-- Since VB22A sensor is set to emit in millimeters per default-->
        <define name="RANGEFINDER_I2C_READ_MODE_SINGLE" value="0x00"/><!-- Specifically to read for a VB22A sensor -->
        <!-- <define name="RANGEFINDER_I2C_SYNC_SEND" value="TRUE"/> --><!-- Only enable while debugging via fast connetion, NOT mesh -->
      </module>

