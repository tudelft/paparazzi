<!-- ****************************** V ****************************** -->
  <!-- Energy adaptive (ETECS) vertical control, tuned from the validated
       JSBSim model (OPENUAS/openuas_jsbsim_zohd_talon_250g):
       stall 6.7 m/s (1g) | hands-off trim 9.5 m/s | best L/D 9 @ 10 m/s
       cruise throttle: 10 m/s ~19% | 12 m/s ~28% | 14 m/s ~43% | 16 m/s 100%
       max climb 4.3 m/s (full throttle, 10 m/s) | sink at idle ~1.2 m/s -->
  <section name="VERTICAL CONTROL" prefix="V_CTL_">
    <!-- power: 2S Li-Ion, nominal under load -->
    <define name="POWER_CTL_BAT_NOMINAL" value="7.2" unit="volt"/>

    <!-- outer loop: with ACCEL_CAPTURE the sqrt law handles the approach
         to the setpoint at constant deceleration; PGAIN only rules the
         terminal linear region |err| <= CAPTURE/PGAIN^2 (= 2.2 m here)
         and the cruise/turn altitude hold. ETECS has no altitude
         integrator so standing sag in banked turns scales with 1/PGAIN:
         0.6 keeps turns tight AND gives a smooth 1.7 s terminal tau -->
    <define name="ALTITUDE_PGAIN" value="0.6"/> <!--unit="(m/s)/m"-->
    <!-- constant-deceleration altitude capture: hold MAX_CLIMB until
         ~3.3 m to go, then level off at a gentle 0.8 m/s2 (must stay
         below MAX_CLIMB_DOT). Kills the exponential level-off crawl of
         the pure P law without touching airspeed (level-off 4.6 s vs
         17.8 s with the pure P law, overshoot +0.04 m) -->
    <define name="ALTITUDE_ACCEL_CAPTURE" value="0.8" unit="m/s2"/>
    <!-- max climb: 4.3 m/s available at full throttle; 2.0 keeps climbs
         gentle and leaves the speed loop plenty of throttle authority -->
    <define name="ALTITUDE_MAX_CLIMB" value="2.0" unit="m/s"/>
    <!-- climb-setpoint acceleration limit (was hardcoded 2 m/s2 upstream):
         4 lets the altitude feedback catch the turn-entry dip and unwind
         before it balloons, without overshooting the correction -->
    <define name="ALTITUDE_MAX_CLIMB_DOT" value="4.0" unit="m/s2"/>
    <!-- max level acceleration: (T-D)/W ~ 0.44 g at 10 m/s; bound below it -->
    <define name="MAX_ACCELERATION" value="0.35" unit="G"/>
    <!-- measured best glide (used for pitch-down when throttle is killed) -->
    <define name="GLIDE_RATIO" value="9."/>

    <!-- ETECS operating point (adaptive: these are initial values)
         cruise 12 m/s: throttle 28 %, pitch ~ alpha = 3.5 deg = 0.06 rad -->
    <define name="AUTO_THROTTLE_NOMINAL_CRUISE_THROTTLE" value="0.28" unit="%"/>
    <define name="AUTO_THROTTLE_NOMINAL_CRUISE_PITCH" value="0.06" unit="rad"/>

    <!-- feedforwards, from the model:
         throttle per climb rate: (1.00-0.28)/4.3 m/s = 0.17 /(m/s)
         pitch per climb rate: gamma = Vz/V = 1/11.5 = 0.085 rad/(m/s) -->
    <define name="AUTO_THROTTLE_CLIMB_THROTTLE_INCREMENT" value="0.17" unit="%/(m/s)"/>
    <define name="AUTO_THROTTLE_PITCH_OF_VZ_PGAIN" value="0.085" unit="rad/(m/s)"/>

    <!-- speed error to desired acceleration: 0.2 -> 5 m/s error = 0.1 g -->
    <define name="AIRSPEED_PGAIN" value="0.20"/>

    <!-- throttle of airspeed: cruise throttle slope measured ~0.06 /(m/s) -->
    <define name="AUTO_THROTTLE_OF_AIRSPEED_PGAIN" value="0.06" unit="%/(m/s)"/>
    <define name="AUTO_THROTTLE_OF_AIRSPEED_IGAIN" value="0.01"/>
    <!-- pitch of airspeed: converts overspeed into climb (in turns the
         energy tends to sit in speed while altitude sags: 0.03 trades it
         back to height promptly) -->
    <define name="AUTO_PITCH_OF_AIRSPEED_PGAIN" value="0.03"/>
    <define name="AUTO_PITCH_OF_AIRSPEED_IGAIN" value="0.004"/>
    <define name="AUTO_PITCH_OF_AIRSPEED_DGAIN" value="0.03"/>

    <!-- total energy (throttle) / energy distribution (pitch) loops
         TOT_PGAIN 0.45: quick throttle response to turn drag increase
         DIFF_PGAIN 0.60: stronger pitch reallocation of energy from
         speed to altitude (kills the height sag in turns) -->
    <define name="ENERGY_TOT_PGAIN" value="0.45"/>
    <define name="ENERGY_TOT_IGAIN" value="0.20"/>
    <define name="ENERGY_DIFF_PGAIN" value="0.60"/>
    <define name="ENERGY_DIFF_IGAIN" value="0.10"/>

    <!-- bank-angle energy feedforward, lead/washout structure driven by
         the COMMANDED roll setpoint (see energy_ctrl.c):
         THROTTLE_GAIN 0.40 = measured steady turn cost in the oval
           (induced drag + prop droop under load);
         WASHOUT_GAIN 1.0 (tau 2 s) = transient punch during roll-in,
           decays before mid-turn and goes NEGATIVE on roll-out, which
           actively cancels exit ballooning;
         BANK_PITCH_GAIN 0.19 = leading pitch on the commanded bank
           (works with the reduced PITCH_OF_ROLL 0.04, which acts on the
           lagged measured bank - split verified in the oval).
         Oval acceptance: dip <= 0.24 m, balloon <= 0.19 m, mean -0.04. -->
