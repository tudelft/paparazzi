    <define name="PITCH_KFFA" value="20."/>
    <define name="PITCH_KFFD" value="0."/>

    <!-- bank compensation split: 0.04 here on the MEASURED bank
         (steady-state), plus V_CTL_ENERGY_BANK_PITCH_GAIN 0.15 on the
