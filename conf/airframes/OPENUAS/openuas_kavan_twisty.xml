  <command_laws>
    <!-- <let var="rc_gain_gyro" value="@GAIN1/PPRZ_MAX*.1"/> --><!-- RC TX digital slider input -->
    <let var="rc_gain_gyro" value="0.4"/><!-- Not yet inflight tunable -->
    <let var="k_rudder_gyro" value="8.0 * $rc_gain_gyro"/><!--gain from yaw rate to rudder-->
    <let var="gyro_active" value="(1 > AP_MODE ? 0 : 1)"/><!-- yes a bit puzzling is it ;)-->
    <let var="gyro_yaw" value="$gyro_active * (stateGetBodyRates_i()->r)"/>
    <let var="yaw_ctrl_sgl" value="@YAW - ($k_rudder_gyro * ($gyro_yaw)) - @ROLL * ASSIST_ROLL_WITH_RUDDER"/>
    <let var="aileron" value="@ROLL+(BRAKEGAIN*SPOILERON_BRAKE_FULL)"/>
    <set servo="S_THROTTLE" value="@THROTTLE"/>
    <set servo="S_AILERON_LEFT" value="$aileron"/>
    <set servo="S_AILERON_RIGHT" value="$aileron"/>
    <set servo="S_ELEVATOR" value="@PITCH+(-BRAKEGAIN*SPOILERON_BRAKE_FULL)"/>
    <set servo="S_RUDDER" value="$yaw_ctrl_sgl"/>
    <set servo="S_LIGHT" value="((autopilot.mode == AP_MODE_AUTO2) ? MAX_PPRZ : @ACTIVELIGHTS)"/>
